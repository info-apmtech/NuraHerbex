    <script>
        $(document).ready(function () {
            $('.selectpicker').selectpicker();
        });
    </script>
    <script>
        $(document).ready(function () {
            $('#nuradataTable').DataTable({
                pageLength: 10,
                lengthChange: true,
                searching: true,
                ordering: true,
                order: [[0, 'asc']],
                dom: 'Bfrtip', // B = Buttons
                buttons: [
                    { extend: 'copy', text: 'Copy' },
                    { extend: 'csv', text: 'CSV' },
                    { extend: 'excel', text: 'Excel' },
                    { extend: 'pdf', text: 'PDF' },
                    { extend: 'print', text: 'Print' }
                ]
            });
        });
