@using Domain.Models
@model List<PricingPlan>

@{
    bool isSinglePlan = Model.Count == 1;
    string gridClass = isSinglePlan ? "pricing-plans-grid single-plan-center" : "pricing-plans-grid";
}

<section class="pricing-plans-section">
    <div class="pricing-plans-container">
        <div class="@gridClass">

            @foreach (var plan in Model)
            {
                var featureList = (plan.PlanFeatures ?? "")
                .Split(',', StringSplitOptions.RemoveEmptyEntries);

                var featuredClass = plan.IsMostPopular
                ? "pricing-plan-card pricing-plan-featured"
                : "pricing-plan-card";

                <div class="@featuredClass">

                    @if (plan.IsMostPopular)
                    {
                        <span class="popular-badge">Most Popular</span>
                    }

                    <h3 class="plan-name">@plan.PlanName</h3>
                    <p class="plan-subtitle">@plan.PlanSubtitle</p>
                    <p class="plan-description">@plan.PlanDescription</p>

                    <div class="plan-price">
                        <span class="price-currency">₹</span>
                        <span class="price-amount">@plan.PriceAmount.ToString("N0")</span>
                        <span class="price-duration">/ @plan.Duration</span>
                    </div>

                    <ul class="plan-features">
                        @foreach (var feature in featureList)
                        {
                            <li>
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                <span>@feature.Trim()</span>
                            </li>
                        }
                    </ul>

                    
                    <form method="post" action="@Url.Action("PlanSubscribe", "Home")">
                        <input type="hidden" name="planId" value="@plan.Id" />
                        <button type="submit" class="plan-subscribe-btn">Subscribe Now</button>
                    </form>

                </div>
            }

        </div>
    </div>
</section>
<style>
    /* Default grid remains untouched */

    /* When only 1 plan, switch grid → flex to center it */
    .single-plan-center {
        display: flex !important;
        justify-content: center !important;
        align-items: flex-start !important;
    }

        /* Restrict width so it doesn’t stretch full-width */
        .single-plan-center .pricing-plan-card {
            margin: 0 auto !important;
            width: auto !important;
            max-width: 420px; /* adjust if needed */
        }

</style>