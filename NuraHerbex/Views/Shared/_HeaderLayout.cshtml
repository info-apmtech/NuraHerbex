        <!-- Logo on LEFT -->
        <div class="logo-wrapper" style="display: flex; align-items: center;" onclick="location.href='@Url.Action("Index", "Home")'">
            <img src="~/image/logo.png" alt="NURA HERBEX Logo" class="brand-logo" />
            <img src="~/image/logotext.png" alt="NURA HERBEX Text Logo" class="brand-text-logo" style="margin-left: 10px;" />
        </div>

        <!-- Desktop Navigation -->
        <nav class="main-nav" id="mainNav">
            <ul class="nav-links">
                <li>
                    <a asp-controller="Home" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">Home</a>
                </li>
                <li>
                    <a asp-controller="Home" asp-action="Shop" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Shop" && ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">Shop</a>
                </li>
                <li>
                    <a asp-controller="Home" asp-action="Ingredients" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Ingredients" && ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">Ingredients</a>
                </li>
                <li>
                    <a asp-controller="Home" asp-action="About" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "About" && ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">About</a>
                </li>
                <li>
                    <a asp-controller="Home" asp-action="Blog" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Blog" && ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">Blog</a>
                </li>
            </ul>


            <!-- Mobile Menu Buttons -->
            <div class="mobile-menu-actions">
                <button class="btn-primary btn-mobile">Subscription</button>
                <button class="btn-primary btn-mobile"
                        onclick="window.location.href='@Url.Action("signin", "authentication")'">
                    Login
                </button>
            </div>
        </nav>

        <!-- Desktop Action Buttons -->
        <div class="header-actions">
            <a asp-controller="Home" asp-action="Quiz" class="btn-secondary">Take Quiz</a>
            <button class="btn-secondary"onclick="window.location.href='@Url.Action("Consultation", "Home")'">Book Consultation</button>
            <button class="btn-primary"onclick="window.location.href='@Url.Action("Plan", "Home")'">Subscription</button>
           @*  <button class="btn-primary"
                    onclick="window.location.href='@Url.Action("signin", "authentication")'">
                Login
            </button> *@
            @if (User.Identity.IsAuthenticated)
            {
                <div class="user-profile dropdown">
                    <button class="user-profile-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <svg class="user-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>

                        <div class="user-text">
                            <span class="welcome-text">Welcome,</span>
                            <span class="user-name">@User.Identity.Name</span>
                        </div>

                        <svg class="dropdown-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">
                        @* Role-based home/dashboard link *@
                        @if (User.IsInRole("Admin"))
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="Admin" asp-action="UserCreation">
                                    Admin Panel
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("Customer"))
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="Home" asp-action="MyOrders">
                                    Customer Panel
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("Doctor"))
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="Admin" asp-action="DoctorConsultation">
                                    Doctor Panel
                                </a>
                            </li>
                        }

                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Authentication" asp-action="LogOut" method="post" style="margin: 0;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item">Logout</button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <button class="btn-login"
                        onclick="window.location.href='@Url.Action("SignIn", "Authentication")'">
                    Login
                </button>
            }
        </div>

        <!-- Mobile: User Profile + Hamburger on RIGHT -->
        <div class="header-right-group">
            <!-- User Profile Section (Visible on Mobile) -->
            <div class="user-profile">
                <div class="user-avatar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
                <div class="user-info">
                    <span class="user-welcome">
                        Welcome,
                        <svg class="dropdown-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </span>
                    <span class="user-name">@User.Identity.Name</span>
                </div>
            </div>

            <!-- Hamburger Menu Button -->
            <button class="mobile-toggle" id="mobileMenuToggle">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </div>
</header>
<script>
    // Mobile menu toggle
    document.getElementById('mobileMenuToggle').addEventListener('click', function() {
        const nav = document.getElementById('mainNav');
        nav.classList.toggle('active');
        this.classList.toggle('active');
        document.body.style.overflow = nav.classList.contains('active') ? 'hidden' : 'auto';
    });

    // Close menu when clicking on a nav link
    document.querySelectorAll('.nav-item').forEach(item => {
        item.addEventListener('click', function() {
            document.getElementById('mainNav').classList.remove('active');
            document.getElementById('mobileMenuToggle').classList.remove('active');
            document.body.style.overflow = 'auto';
        });
    });

    // Close menu when clicking mobile action buttons
    document.querySelectorAll('.btn-mobile').forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('mainNav').classList.remove('active');
            document.getElementById('mobileMenuToggle').classList.remove('active');
            document.body.style.overflow = 'auto';
        });
    });
</script>