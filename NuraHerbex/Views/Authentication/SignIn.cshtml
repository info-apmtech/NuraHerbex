@model Domain.ViewModel.RegisterUserViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Sign In-NuraHerbex </title>
    <link rel="icon" type="image/png" href="~/image/logo.png" />
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/loginstyle.css" asp-append-version="true" />
</head>
<body>
    <partial name="_HeaderLayout" />
    <div class="container-fluid main-container">
        <div class="row justify-content-center align-items-center g-5">
            <!-- Left Section - Hidden on mobile, visible on lg and up -->
            <div class="row justify-content-center d-lg-none">
                <div class="col-12 mobile-logo-container">
                    <img src="~/image/logo.png" alt="NuraHerbex Logo" class="mobile-logo">
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block left-section-desktop">
                <div class="left-section">
                    <!-- Logo -->
                    <div class="logo-container"></div>

                    <!-- Heading -->
                    <h1 class="main-heading">
                        Your Next Level <span class="highlight">Starts Here</span>
                    </h1>

                    <!-- Subheading -->
                    <p class="sub-heading">
                        Join thousands of men who've transformed their health and performance with STAMIX's premium wellness solutions.
                    </p>

                    <!-- Features -->
                    <div class="features">
                        <div class="feature-item">
                            <div class="d-flex align-items-center mb-2">
                                <img src="../image/signin/group.png" alt="Expert-Curated Products" class="feature-icon me-3">
                                <h3 class="feature-title mb-0">Expert-Curated Products</h3>
                            </div>
                            <p class="feature-description mb-0">Science-backed formulations for optimal results</p>
                        </div>

                        <div class="feature-item">
                            <div class="d-flex align-items-center mb-2">
                                <img src="../image/signin/vector.png" alt="Personalized Support" class="feature-icon me-3">
                                <h3 class="feature-title mb-0">Personalized Support</h3>
                            </div>
                            <p class="feature-description mb-0">Custom wellness plans and expert consultations</p>
                        </div>

                        <div class="feature-item">
                            <div class="d-flex align-items-center mb-2">
                                <img src="../image/signin/users-01 2 1.svg" alt="Community Access" class="feature-icon me-3">
                                <h3 class="feature-title mb-0">Community Access</h3>
                            </div>
                            <p class="feature-description mb-0">Connect with like-minded men on their wellness journey</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Section (Auth Card) - Always visible -->
            <div class="col-12 col-lg-6 d-flex justify-content-center">
                <div class="auth-card">
                    <!-- Your entire auth card content here -->
                    <h2 class="card-title">Welcome Back</h2>
                    <p class="card-description">Sign in to your STAMIX Account</p>

                    <!-- Tabs -->
                    <div class="tabs-container">
                        <button class="tab-button active" data-tab="signin" onclick="switchTab(this, 'signin')">Sign In</button>
                        <button class="tab-button" data-tab="signup" onclick="switchTab(this, 'signup')">Sign Up</button>
                    </div>

                    <!-- SIGN IN -->
                    <form id="signinForm" class="auth-form" autocomplete="on" asp-action="SignIn" asp-controller="Authentication" method="post">
                        @Html.AntiForgeryToken()
                        <!-- Email -->
                        <div class="input-wrapper">
                            <label class="form-label">Email Address</label>
                            <div class="position-relative">
                                <img src="../image/signin/material-symbols_mail-outline.png" alt="Email" class="input-icon">
                                <input type="text" class="form-input" placeholder="your.email@example.com" asp-for="Username" required>
                            </div>
                        </div>

                        <!-- Password -->
                        <div class="input-wrapper">
                            <label class="form-label">Password</label>
                            <div class="position-relative">
                                <img src="../image/signin/mdi_password-outline.png" alt="Password" class="input-icon">
                                <input type="password" id="passwordInput" class="form-input" placeholder="Enter Your Password" asp-for="Password" required>
                                <img src="../image/signin/iconoir_eye-solid.png" alt="Toggle Password" class="eye-icon" onclick="togglePassword('passwordInput')">
                            </div>
                        </div>

                        <div class="remember-forgot">
                            <label class="checkbox-label">
                                <input type="checkbox" class="custom-checkbox" asp-for="IsActive" checked>
                                <span>Remember me</span>
                            </label>
                            <a asp-action="ForgotPassword" asp-controller="Authentication" class="forgot-link">Forgot password?</a>
                        </div>

                        <button type="submit" class="signin-button">
                            <span>Sign In</span>
                            <img src="../image/signin/ic_baseline-arrow-back.png" alt="Arrow" class="arrow-icon" style="transform: rotate(360deg);">
                        </button>
                    </form>

                    <!-- SIGN UP -->
                    <form id="signupForm" class="auth-form d-none" autocomplete="on" asp-controller="Admin" asp-action="UserCreation" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="RegisteredUser.Role" value="Customer" />

                        @*  <div class="input-wrapper">
                            <label class="form-label">UserName</label>
                            <div class="position-relative">
                                <input type="text" class="form-input" placeholder="UserName" asp-for="RegisteredUser.UserName" required>
                            </div>
                        </div> *@
                        <input type="hidden" name="IsPhoneVerified" id="IsPhoneVerified" value="false" />
                        <input type="hidden" name="VerifiedPhone" id="VerifiedPhone" value="" />
                        <div class="input-wrapper">
                            <label class="form-label">Mobile Number</label>
                            <div class="position-relative">
                                <img src="../image/signin/phoneicon.svg" alt="Phone" class="input-icon">
                                <input type="tel" class="form-input" placeholder="+91 234567890" asp-for="RegisteredUser.PhoneNumber" required>
                                @* <button type="button" class="btn btn-sm btn-outline-warning position-absolute end-0 top-50 translate-middle-y me-2">Verify</button> *@
                                <button type="button"
                                        class="btn btn-sm btn-outline-warning position-absolute end-0 top-50 translate-middle-y me-2"
                                        id="openOtpBtn">
                                    Verify
                                </button>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="input-wrapper">
                                    <label class="form-label">First Name</label>
                                    <input type="text" class="form-input" placeholder="John" asp-for="RegisteredUser.FirstName" required>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="input-wrapper">
                                    <label class="form-label">Last Name</label>
                                    <input type="text" class="form-input" placeholder="Doe" asp-for="RegisteredUser.LastName" required>
                                </div>
                            </div>
                        </div>
                        <div class="input-wrapper">
                            <label class="form-label">Email Address</label>
                            <div class="position-relative">
                                <img src="../image/signin/material-symbols_mail-outline.png" alt="Email" class="input-icon">
                                <input type="email" class="form-input" placeholder="your.email@example.com" asp-for="RegisteredUser.Email" required>
                            </div>
                        </div>

                        <div class="input-wrapper">
                            <label class="form-label">Password</label>
                            <div class="position-relative">
                                <img src="../image/signin/mdi_password-outline.png" alt="Password" class="input-icon">
                                <input type="password" id="signupPassword" class="form-input" placeholder="Enter Your Password" asp-for="RegisteredUser.Password" required>
                                <img src="../image/signin/iconoir_eye-solid.png" alt="Toggle Password" class="eye-icon" onclick="togglePassword('signupPassword')">
                            </div>
                        </div>

                        <div class="input-wrapper">
                            <label class="form-label">Confirm Password</label>
                            <div class="position-relative">
                                <img src="../image/signin/mdi_password-outline.png" alt="Confirm" class="input-icon">
                                <input type="password" id="signupConfirm" class="form-input" placeholder="Enter Your Password" asp-for="RegisteredUser.NMConfirmPassword" required>
                                <img src="../image/signin/iconoir_eye-solid.png" alt="Toggle Password" class="eye-icon" onclick="togglePassword('signupConfirm')">
                            </div>
                        </div>

                        <label class="checkbox-label mb-3">
                            <input type="checkbox" class="custom-checkbox" asp-for="RegisteredUser.isActive" required checked>
                            <span>I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a></span>
                        </label>

                        <button type="submit" class="signin-button">
                            <span>Create Account</span>
                            <img src="../image/signin/ic_baseline-arrow-back.png" alt="Arrow" class="arrow-icon" style="transform: rotate(360deg);">
                        </button>
                    </form>

                    <!-- Divider -->
                    <div class="divider-container">
                        <div class="divider-line"></div>
                        <span class="divider-text">OR CONTINUE WITH</span>
                        <div class="divider-line"></div>
                    </div>

                    <!-- Social Buttons -->
                    <div class="social-buttons">
                        <button class="social-button" onclick="socialLogin('google')">
                            <img src="../image/signin/devicon_google.png" alt="Google" class="social-icon">
                            <span>Google</span>
                        </button>
                        <button class="social-button" onclick="socialLogin('facebook')">
                            <img src="../image/signin/logos_facebook.png" alt="Facebook" class="social-icon">
                            <span>FaceBook</span>
                        </button>
                    </div>
                    @* <a asp-action="index" asp-controller="Home" style="float:right!important; color:white;">Back</a> *@
                </div>
            </div>
        </div>
    </div>
    @*  <partial name="_VerifyOTPPhone" /> *@
    <style>
        .locked {
            pointer-events: none;
            opacity: .6;
        }
    </style>

    <!-- OTP Modal -->
    <div class="otp-modal" id="otpModal" style="display:none;">
        <div class="otp-modal-content">
            <!-- Close button to close the modal -->
            <button class="close-btn" id="closeModalBtn" aria-label="Close">&times;</button>

            <h2>Verify Your Phone No</h2>
            <p>We’ve sent a 6-digit code to your Phone.</p>

            @* <form id="verifyOtpForm" asp-action="SendSignupOtp" asp-controller="Authentication" method="post" novalidate> *@
            <form id="verifyOtpForm" method="post" novalidate>
                @Html.AntiForgeryToken()
                <!-- Use explicit name/id to avoid duplicate id="Email" -->
                <input type="hidden" name="phone" id="ModalPhoneHidden" />
                <input type="hidden" name="Otp" id="ModalOtpHidden" />

                <div class="otp-inputs" aria-label="Enter 6 digit code">
                    <input type="text" class="otp-input" inputmode="numeric" pattern="[0-9]*" maxlength="1">
                    <input type="text" class="otp-input" inputmode="numeric" pattern="[0-9]*" maxlength="1">
                    <input type="text" class="otp-input" inputmode="numeric" pattern="[0-9]*" maxlength="1">
                    <input type="text" class="otp-input" inputmode="numeric" pattern="[0-9]*" maxlength="1">
                    <input type="text" class="otp-input" inputmode="numeric" pattern="[0-9]*" maxlength="1">
                    <input type="text" class="otp-input" inputmode="numeric" pattern="[0-9]*" maxlength="1">
                </div>

                <p class="mt-2">
                    Didn't receive code?
                    <a href="#" id="resendOtpBtn" style="color:#f44900;">Resend OTP</a>
                </p>

                <button type="submit" class="verify-btn">Verify & Continue</button>
            </form>
            <p id="resendMessage" class="text-success mt-3"></p>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Bootstrap JS Bundle -->
    @* <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script> *@

    <script>
        function switchTab(button, tab) {
            document.querySelectorAll('.tab-button').forEach(b => b.classList.remove('active'));
            button.classList.add('active');

            const signIn = document.getElementById('signinForm');
            const signUp = document.getElementById('signupForm');

            if (tab === 'signup') {
                signIn.classList.add('d-none');
                signUp.classList.remove('d-none');
                setHeader('Welcome', 'Sign up to your STAMIX Account');
            } else {
                signUp.classList.add('d-none');
                signIn.classList.remove('d-none');
                setHeader('Welcome Back', 'Sign in to your STAMIX Account');
            }
        }

        function togglePassword(inputId) {
            const el = document.getElementById(inputId);
            el.type = el.type === 'password' ? 'text' : 'password';
        }

        function setHeader(title, subtitle) {
            const h2 = document.querySelector('.auth-card .card-title');
            const p = document.querySelector('.auth-card .card-description');
            if (h2) h2.textContent = title;
            if (p) p.textContent = subtitle;
        }

        // Form submit handlers
        // document.getElementById('signinForm').addEventListener('submit', function (e) {
        //     e.preventDefault();
        //     const email = this.querySelector('input[type="email"]').value;
        //     const password = this.querySelector('input[type="password"]').value;
        //     console.log('Sign In:', { email, password });
        //     alert('Sign in functionality would be implemented here');
        // });

        // document.getElementById('signupForm').addEventListener('submit', function (e) {
        //     e.preventDefault();
        //     const payload = {
        //         firstName: this.querySelector('input[placeholder="John"]').value,
        //         lastName: this.querySelector('input[placeholder="Doe"]').value,
        //         phone: this.querySelector('input[type="tel"]').value,
        //         email: this.querySelector('input[type="email"]').value,
        //         password: this.querySelector('#signupPassword').value,
        //         confirm: this.querySelector('#signupConfirm').value
        //     };
        //     console.log('Sign Up:', payload);
        //     alert('Sign up functionality would be implemented here');
        // });
                // Show left panel only on large screens
        function checkScreenSize() {
            const leftPanel = document.querySelector('.left-section-desktop');
            if (window.innerWidth >= 992) {
                leftPanel.style.display = 'block';
            } else {
                leftPanel.style.display = 'none';
            }
        }

        // Check on load and resize
        window.addEventListener('load', checkScreenSize);
        window.addEventListener('resize', checkScreenSize);
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
          const signupForm = document.getElementById('signupForm');
          const sendBtn    = document.getElementById('openOtpBtn');
          const otpModal   = document.getElementById('otpModal');
          const closeModal = document.getElementById('closeModalBtn');
          const verifyForm = document.getElementById('verifyOtpForm');

          const SEND_OTP_URL   = '@Url.Action("SendSignupOtp", "Authentication")';
          const VERIFY_OTP_URL = '@Url.Action("VerifyPhoneOtp", "Authentication")';

          const hfVerified   = document.getElementById('IsPhoneVerified');
          const hfPhone      = document.getElementById('VerifiedPhone');

          const getAntiForgeryToken = () =>
            document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

          const getPhoneEl = () =>
            document.querySelector('#RegisteredUser_PhoneNumber, [name="RegisteredUser.PhoneNumber"]');

          const getPhoneValue = () => (getPhoneEl()?.value || '').trim();

          // ---- Lock/unlock helpers ------------------------------------------------
          const nonPhoneControls = () => {
            const phone = getPhoneEl();
            return Array.from(signupForm.querySelectorAll('input, select, textarea, button'))
              .filter(el =>
                el !== phone &&
                el.id !== 'openOtpBtn' &&
                el.type !== 'hidden'
              );
          };

          function lockForm() {
            nonPhoneControls().forEach(el => {
              if (el.tagName === 'INPUT' && ['text','email','password','tel','number','search','url'].includes(el.type)) {
                el.readOnly = true;
              } else {
                el.disabled = true;
              }
            });
          }

          function unlockForm() {
            nonPhoneControls().forEach(el => {
              if (el.tagName === 'INPUT' && ['text','email','password','tel','number','search','url'].includes(el.type)) {
                el.readOnly = false;
              } else {
                el.disabled = false;
              }
            });
          }

          // Start locked (only phone + Verify button usable)
          lockForm();

          // ---- Send OTP -----------------------------------------------------------
        sendBtn?.addEventListener('click', async (e) => {
          e.preventDefault();

          const phone = getPhoneValue();
          if (!phone) { alert('Please enter your Phone number.'); return; }

          const token = getAntiForgeryToken();
          const body  = new URLSearchParams({ phone, '__RequestVerificationToken': token });

          const res = await fetch(SEND_OTP_URL, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
              'RequestVerificationToken': token
            },
            body
          }).catch(() => null);

          if (!res || !res.ok) { alert('Failed to send OTP.'); return; }

          const data = await res.json().catch(() => ({}));
          if (data?.success === false) { alert(data.message || 'Failed to send OTP.'); return; }

          //  INSERTED DEV-ONLY SNIPPET (safe to remove in production)
          if (data.debugOtp) {
            console.info('DEV OTP:', data.debugOtp);
            // Optional: surface it in the modal helper text
            const devMsg = document.getElementById('resendMessage');
            if (devMsg) devMsg.textContent = `DEV OTP: ${data.debugOtp}`;
          }
          //  END DEV-ONLY

          // proceed to open modal
          document.getElementById('ModalPhoneHidden').value = phone;
          otpModal.style.display = 'flex';
          otpModal.querySelector('.otp-input')?.focus();
        });


          // ---- Verify OTP -> unlock form -----------------------------------------
          verifyForm?.addEventListener('submit', async (e) => {
            e.preventDefault();

            const phone  = document.getElementById('ModalPhoneHidden').value;
            const token  = getAntiForgeryToken();
            const digits = Array.from(otpModal.querySelectorAll('.otp-input'))
              .map(i => (i.value || '').trim())
              .join('');

            if (digits.length !== 6) { alert('Please enter the 6-digit code.'); return; }

            const body = new URLSearchParams({ phone, otp: digits, '__RequestVerificationToken': token });

            const res = await fetch(VERIFY_OTP_URL, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'RequestVerificationToken': token
              },
              body
            }).catch(() => null);

            const data = await res?.json().catch(() => ({}));
            if (!res || !res.ok || data?.success === false) {
              alert(data?.message || 'Invalid or expired OTP.');
              return;
            }

            // Success: lock phone, unlock rest, set flags
            otpModal.style.display = 'none';
            otpModal.querySelectorAll('.otp-input').forEach(i => i.value = '');
            const phoneEl = getPhoneEl();
            if (phoneEl) phoneEl.readOnly = true;
            sendBtn.disabled = true;
            sendBtn.textContent = 'Verified ✓';

            hfVerified.value = 'true';
            hfPhone.value    = phone;

            unlockForm();
          });

          // ---- Block submit unless verified and phone matches ---------------------
          signupForm?.addEventListener('submit', (e) => {
            const verified = hfVerified.value === 'true';
            const phone    = getPhoneValue();
            if (!verified) {
              e.preventDefault();
              alert('Please verify your phone number to continue.');
              return;
            }
            if (hfPhone.value !== phone) {
              e.preventDefault();
              alert('Phone number changed. Please verify again.');
              // re-lock everything except phone + verify
              lockForm();
              const phoneEl = getPhoneEl(); if (phoneEl) phoneEl.readOnly = false;
              sendBtn.disabled = false; sendBtn.textContent = 'Verify';
              hfVerified.value = 'false'; hfPhone.value = '';
            }
          });

          // ---- OTP input UX (same as you had) ------------------------------------
          otpModal.querySelectorAll('.otp-input').forEach((el, idx, arr) => {
            el.addEventListener('input', () => {
              el.value = el.value.replace(/\D/g, '').slice(0, 1);
              if (el.value && idx < arr.length - 1) arr[idx + 1].focus();
            });
            el.addEventListener('keydown', (e) => {
              if ((e.key === 'Backspace' || e.key === 'Delete') && !el.value && idx > 0) {
                e.preventDefault(); arr[idx - 1].focus();
              }
            });
            el.addEventListener('paste', (e) => {
              const t = (e.clipboardData || window.clipboardData).getData('text') || '';
              if (!t) return;
              e.preventDefault();
              const digits = t.replace(/\D/g, '').slice(0, arr.length).split('');
              arr.forEach((inp, i) => inp.value = digits[i] ?? '');
              arr[Math.min(digits.length, arr.length - 1)].focus();
            });
          });

          // Close modal
          closeModal?.addEventListener('click', () => {
            otpModal.style.display = 'none';
            otpModal.querySelectorAll('.otp-input').forEach(i => i.value = '');
          });

          // Optional: resend with small cooldown
          const resendBtn = document.getElementById('resendOtpBtn');
          const resendMsg = document.getElementById('resendMessage');
          let until = 0;
          function tick() {
            const now = Date.now();
            if (now < until) {
              const s = Math.ceil((until - now) / 1000);
              resendBtn.style.pointerEvents = 'none'; resendBtn.style.opacity = .6;
              resendMsg.textContent = `You can resend in ${s}s`;
              requestAnimationFrame(tick);
            } else {
              resendBtn.style.pointerEvents = ''; resendBtn.style.opacity = '';
              resendMsg.textContent = '';
            }
          }
          resendBtn?.addEventListener('click', async (e) => {
            e.preventDefault();
            if (Date.now() < until) return;
            sendBtn.click(); // reuse send logic
            until = Date.now() + 30_000; tick();
          });
        });
    </script>
</body>
</html>