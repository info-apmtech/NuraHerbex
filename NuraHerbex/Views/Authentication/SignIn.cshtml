@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Sign In-NuraHerbex </title>
    <link rel="icon" type="image/png" href="~/image/logo.png" />
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/loginstyle.css" asp-append-version="true" />
</head>
<body>
    <partial name="_HeaderLayout" />
    <div class="container-fluid main-container">
        <div class="row justify-content-center align-items-center g-5">
            <!-- Left Section - Hidden on mobile, visible on lg and up -->
            <div class="row justify-content-center d-lg-none">
                <div class="col-12 mobile-logo-container">
                    <img src="~/image/logo.png" alt="NuraHerbex Logo" class="mobile-logo">
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block left-section-desktop">
                <div class="left-section">
                    <!-- Logo -->
                    <div class="logo-container"></div>

                    <!-- Heading -->
                    <h1 class="main-heading">
                        Your Next Level <span class="highlight">Starts Here</span>
                    </h1>

                    <!-- Subheading -->
                    <p class="sub-heading">
                        Join thousands of men who've transformed their health and performance with STAMIX's premium wellness solutions.
                    </p>

                    <!-- Features -->
                    <div class="features">
                        <div class="feature-item">
                            <div class="d-flex align-items-center mb-2">
                                <img src="../image/signin/group.png" alt="Expert-Curated Products" class="feature-icon me-3">
                                <h3 class="feature-title mb-0">Expert-Curated Products</h3>
                            </div>
                            <p class="feature-description mb-0">Science-backed formulations for optimal results</p>
                        </div>

                        <div class="feature-item">
                            <div class="d-flex align-items-center mb-2">
                                <img src="../image/signin/vector.png" alt="Personalized Support" class="feature-icon me-3">
                                <h3 class="feature-title mb-0">Personalized Support</h3>
                            </div>
                            <p class="feature-description mb-0">Custom wellness plans and expert consultations</p>
                        </div>

                        <div class="feature-item">
                            <div class="d-flex align-items-center mb-2">
                                <img src="../image/signin/users-01 2 1.svg" alt="Community Access" class="feature-icon me-3">
                                <h3 class="feature-title mb-0">Community Access</h3>
                            </div>
                            <p class="feature-description mb-0">Connect with like-minded men on their wellness journey</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Section (Auth Card) - Always visible -->
            <div class="col-12 col-lg-6 d-flex justify-content-center">
                <div class="auth-card">
                    <!-- Your entire auth card content here -->
                    <h2 class="card-title">Welcome Back</h2>
                    <p class="card-description">Sign in to your STAMIX Account</p>

                    <!-- Tabs -->
                    <div class="tabs-container">
                        <button class="tab-button active" data-tab="signin" onclick="switchTab(this, 'signin')">Sign In</button>
                        <button class="tab-button" data-tab="signup" onclick="switchTab(this, 'signup')">Sign Up</button>
                    </div>

                    <!-- SIGN IN -->
                    <form id="signinForm" class="auth-form" autocomplete="on">
                        <!-- Email -->
                        <div class="input-wrapper">
                            <label class="form-label">Email Address</label>
                            <div class="position-relative">
                                <img src="../image/signin/material-symbols_mail-outline.png" alt="Email" class="input-icon">
                                <input type="email" class="form-input" placeholder="your.email@example.com" required>
                            </div>
                        </div>

                        <!-- Password -->
                        <div class="input-wrapper">
                            <label class="form-label">Password</label>
                            <div class="position-relative">
                                <img src="../image/signin/mdi_password-outline.png" alt="Password" class="input-icon">
                                <input type="password" id="passwordInput" class="form-input" placeholder="Enter Your Password" required>
                                <img src="../image/signin/iconoir_eye-solid.png" alt="Toggle Password" class="eye-icon" onclick="togglePassword('passwordInput')">
                            </div>
                        </div>

                        <div class="remember-forgot">
                            <label class="checkbox-label">
                                <input type="checkbox" class="custom-checkbox"checked>
                                <span>Remember me</span>
                            </label>
                            <a asp-action="forgetpassword" asp-controller="Authentication" class="forgot-link">Forgot password?</a>
                        </div>

                        <button type="submit" class="signin-button">
                            <span>Sign In</span>
                            <img src="../image/signin/ic_baseline-arrow-back.png" alt="Arrow" class="arrow-icon" style="transform: rotate(360deg);">
                        </button>
                    </form>

                    <!-- SIGN UP -->
                    <form id="signupForm" class="auth-form d-none" autocomplete="on">
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="input-wrapper">
                                    <label class="form-label">First Name</label>
                                    <input type="text" class="form-input" placeholder="John" required>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="input-wrapper">
                                    <label class="form-label">Last Name</label>
                                    <input type="text" class="form-input" placeholder="Doe" required>
                                </div>
                            </div>
                        </div>

                        <div class="input-wrapper">
                            <label class="form-label">Mobile Number</label>
                            <div class="position-relative">
                                <img src="../image/signin/phoneicon.svg" alt="Phone" class="input-icon">
                                <input type="tel" class="form-input" placeholder="+91 234567890" required>
                                <button type="button" class="btn btn-sm btn-outline-warning position-absolute end-0 top-50 translate-middle-y me-2">Verify</button>
                            </div>
                        </div>

                        <div class="input-wrapper">
                            <label class="form-label">Email Address</label>
                            <div class="position-relative">
                                <img src="../image/signin/material-symbols_mail-outline.png" alt="Email" class="input-icon">
                                <input type="email" class="form-input" placeholder="your.email@example.com" required>
                            </div>
                        </div>

                        <div class="input-wrapper">
                            <label class="form-label">Password</label>
                            <div class="position-relative">
                                <img src="../image/signin/mdi_password-outline.png" alt="Password" class="input-icon">
                                <input type="password" id="signupPassword" class="form-input" placeholder="Enter Your Password" required>
                                <img src="../image/signin/iconoir_eye-solid.png" alt="Toggle Password" class="eye-icon" onclick="togglePassword('signupPassword')">
                            </div>
                        </div>

                        <div class="input-wrapper">
                            <label class="form-label">Confirm Password</label>
                            <div class="position-relative">
                                <img src="../image/signin/mdi_password-outline.png" alt="Confirm" class="input-icon">
                                <input type="password" id="signupConfirm" class="form-input" placeholder="Enter Your Password" required>
                                <img src="../image/signin/iconoir_eye-solid.png" alt="Toggle Password" class="eye-icon" onclick="togglePassword('signupConfirm')">
                            </div>
                        </div>

                        <label class="checkbox-label mb-3">
                            <input type="checkbox" class="custom-checkbox" required checked>
                            <span>I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a></span>
                        </label>

                        <button type="submit" class="signin-button">
                            <span>Create Account</span>
                            <img src="../image/signin/ic_baseline-arrow-back.png" alt="Arrow" class="arrow-icon" style="transform: rotate(360deg);">
                        </button>
                    </form>

                    <!-- Divider -->
                    <div class="divider-container">
                        <div class="divider-line"></div>
                        <span class="divider-text">OR CONTINUE WITH</span>
                        <div class="divider-line"></div>
                    </div>

                    <!-- Social Buttons -->
                    <div class="social-buttons">
                        <button class="social-button" onclick="socialLogin('google')">
                            <img src="../image/signin/devicon_google.png" alt="Google" class="social-icon">
                            <span>Google</span>
                        </button>
                        <button class="social-button" onclick="socialLogin('facebook')">
                            <img src="../image/signin/logos_facebook.png" alt="Facebook" class="social-icon">
                            <span>FaceBook</span>
                        </button>
                    </div>
                    @* <a asp-action="index" asp-controller="Home" style="float:right!important; color:white;">Back</a> *@
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function switchTab(button, tab) {
            document.querySelectorAll('.tab-button').forEach(b => b.classList.remove('active'));
            button.classList.add('active');

            const signIn = document.getElementById('signinForm');
            const signUp = document.getElementById('signupForm');

            if (tab === 'signup') {
                signIn.classList.add('d-none');
                signUp.classList.remove('d-none');
                setHeader('Welcome', 'Sign up to your STAMIX Account');
            } else {
                signUp.classList.add('d-none');
                signIn.classList.remove('d-none');
                setHeader('Welcome Back', 'Sign in to your STAMIX Account');
            }
        }

        function togglePassword(inputId) {
            const el = document.getElementById(inputId);
            el.type = el.type === 'password' ? 'text' : 'password';
        }

        function setHeader(title, subtitle) {
            const h2 = document.querySelector('.auth-card .card-title');
            const p = document.querySelector('.auth-card .card-description');
            if (h2) h2.textContent = title;
            if (p) p.textContent = subtitle;
        }

        // Form submit handlers
        document.getElementById('signinForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const email = this.querySelector('input[type="email"]').value;
            const password = this.querySelector('input[type="password"]').value;
            console.log('Sign In:', { email, password });
            alert('Sign in functionality would be implemented here');
        });

        document.getElementById('signupForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const payload = {
                firstName: this.querySelector('input[placeholder="John"]').value,
                lastName: this.querySelector('input[placeholder="Doe"]').value,
                phone: this.querySelector('input[type="tel"]').value,
                email: this.querySelector('input[type="email"]').value,
                password: this.querySelector('#signupPassword').value,
                confirm: this.querySelector('#signupConfirm').value
            };
            console.log('Sign Up:', payload);
            alert('Sign up functionality would be implemented here');
        });
                // Show left panel only on large screens
        function checkScreenSize() {
            const leftPanel = document.querySelector('.left-section-desktop');
            if (window.innerWidth >= 992) {
                leftPanel.style.display = 'block';
            } else {
                leftPanel.style.display = 'none';
            }
        }

        // Check on load and resize
        window.addEventListener('load', checkScreenSize);
        window.addEventListener('resize', checkScreenSize);
    </script>
</body>
</html>