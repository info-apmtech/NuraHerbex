@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NuraHerbex - Forget PassWord</title>
    <link rel="icon" type="image/png" href="~/image/logo.png" />
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/loginstyle.css" asp-append-version="true" />
</head>
<body>
    <div class="container-fluid main-container">
        <!-- Mobile Logo - Above everything, outside the row -->
        <div class="row justify-content-center d-lg-none">
            <div class="col-12 mobile-logo-container">
                <img src="~/image/logo.png" alt="NuraHerbex Logo" class="mobile-logo">
            </div>
        </div>

        <div class="row justify-content-center align-items-center g-5">
            <!-- Left Section -->
            <div class="col-lg-6 d-none d-lg-block left-section-desktop">
                <div class="left-section">
                    <!-- Logo -->
                    <div class="logo-container"></div>

                    <!-- Heading -->
                    <h1 class="main-heading">
                        Your Next Level <span class="highlight">Starts Here</span>
                    </h1>

                    <!-- Subheading -->
                    <p class="sub-heading">
                        Join thousands of men who've transformed their health and performance with STAMIX's premium wellness solutions.
                    </p>

                    <!-- Features -->
                    <div class="features">
                        <div class="feature-item">
                            <div class="d-flex align-items-center mb-2">
                                <img src="~/image/signin/group.png" alt="Expert-Curated Products" class="feature-icon me-3">
                                <h3 class="feature-title mb-0">Expert-Curated Products</h3>
                            </div>
                            <p class="feature-description mb-0">Science-backed formulations for optimal results</p>
                        </div>

                        <div class="feature-item">
                            <div class="d-flex align-items-center mb-2">
                                <img src="~/image/signin/vector.png" alt="Personalized Support" class="feature-icon me-3">
                                <h3 class="feature-title mb-0">Personalized Support</h3>
                            </div>
                            <p class="feature-description mb-0">Custom wellness plans and expert consultations</p>
                        </div>

                        <div class="feature-item">
                            <div class="d-flex align-items-center mb-2">
                                <img src="~/image/signin/users-01 2 1.svg" alt="Community Access" class="feature-icon me-3">
                                <h3 class="feature-title mb-0">Community Access</h3>
                            </div>
                            <p class="feature-description mb-0">Connect with like-minded men on their wellness journey</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Section (Auth Card) -->
            <div class="col-12 col-lg-6 d-flex justify-content-center">
                <div class="auth-card w-100" style="max-width: 824px;">
                    <!-- Header -->
                    <h2 class="card-title">Create a new Password</h2>
                    <p class="card-description" style="font-size:20px!important;margin-bottom: 47px!important;">Your new password must be different from previously used ones.</p>

                    <!-- SIGN IN -->
                    <form id="signinForm" class="auth-form" autocomplete="on">
                        <!-- Password -->
                        <div class="input-wrapper">
                            <label class="form-label">Enter new Password</label>
                            <div class="position-relative">
                                <img src="../image/signin/mdi_password-outline.png" alt="Password" class="input-icon">
                                <input type="password" id="signupPassword" class="form-input" placeholder="Enter Your Password" required>
                                <img src="../image/signin/iconoir_eye-solid.png" alt="Toggle Password" class="eye-icon" onclick="togglePassword('signupPassword')">
                            </div>
                        </div>

                        <div class="input-wrapper">
                            <label class="form-label">Confirm Password</label>
                            <div class="position-relative">
                                <img src="../image/signin/mdi_password-outline.png" alt="Confirm" class="input-icon">
                                <input type="password" id="signupConfirm" class="form-input" placeholder="Enter Your Password" required>
                                <img src="../image/signin/iconoir_eye-solid.png" alt="Toggle Password" class="eye-icon" onclick="togglePassword('signupConfirm')">
                            </div>
                        </div>
                        <button type="submit" class="signin-button">
                            <span>Update password</span>
                            <img src="~/image/signin/ic_baseline-arrow-back.png" alt="Arrow" class="arrow-icon" style="transform: rotate(360deg);">
                        </button>
                    </form>
                    <a asp-action="index" asp-controller="Home" style="float:right!important; color:white;">Back</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePassword(inputId) {
            const el = document.getElementById(inputId);
            el.type = el.type === 'password' ? 'text' : 'password';
        }

        function checkScreenSize() {
            const leftPanel = document.querySelector('.left-section-desktop');
            if (window.innerWidth >= 992) {
                leftPanel.style.display = 'block';
            } else {
                leftPanel.style.display = 'none';
            }
        }

        // Check on load and resize
        window.addEventListener('load', checkScreenSize);
        window.addEventListener('resize', checkScreenSize);

        // Form submission handler
        document.getElementById('signinForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const newPassword = document.getElementById('signupPassword').value;
            const confirmPassword = document.getElementById('signupConfirm').value;

            if (newPassword !== confirmPassword) {
                alert('Passwords do not match!');
                return;
            }

            if (newPassword.length < 6) {
                alert('Password must be at least 6 characters long!');
                return;
            }

            console.log('Password update:', { newPassword });
            alert('Password updated successfully!');
        });
    </script>
</body>
</html>