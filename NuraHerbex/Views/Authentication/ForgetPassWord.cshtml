@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NuraHerbex - Forget PassWord</title>
    <link rel="icon" type="image/png" href="~/image/logo.png" />
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/loginstyle.css" asp-append-version="true" />

</head>
<body>
    <div class="container-fluid main-container">
        <div class="row justify-content-center align-items-center g-5">
            <!-- Left Section -->
            <div class="col-12 col-lg-6">
                <div class="left-section">
                    <!-- Logo -->
                    <div class="logo-container"></div>

                    <!-- Heading -->
                    <h1 class="main-heading">
                        Your Next Level <span class="highlight">Starts Here</span>
                    </h1>

                    <!-- Subheading -->
                    <p class="sub-heading">
                        Join thousands of men who've transformed their health and performance with STAMIX's premium wellness solutions.
                    </p>

                    <!-- Features -->
                    <div class="features">
                        <div class="feature-item">
                            <div class="d-flex align-items-center mb-2">
                                <img src="../image/group.png" alt="Expert-Curated Products" class="feature-icon me-3">
                                <h3 class="feature-title mb-0">Expert-Curated Products</h3>
                            </div>
                            <p class="feature-description mb-0">Science-backed formulations for optimal results</p>
                        </div>

                        <div class="feature-item">
                            <div class="d-flex align-items-center mb-2">
                                <img src="../image/vector.png" alt="Personalized Support" class="feature-icon me-3">
                                <h3 class="feature-title mb-0">Personalized Support</h3>
                            </div>
                            <p class="feature-description mb-0">Custom wellness plans and expert consultations</p>
                        </div>

                        <div class="feature-item">
                            <div class="d-flex align-items-center mb-2">
                                <img src="../image/users-01 2 1.svg" alt="Community Access" class="feature-icon me-3">
                                <h3 class="feature-title mb-0">Community Access</h3>
                            </div>
                            <p class="feature-description mb-0">Connect with like-minded men on their wellness journey</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Section (Auth Card) -->
            <div class="col-12 col-lg-6 d-flex justify-content-center">
                <div class="auth-card">
                    <!-- Header -->
                    <h2 class="card-title">Forget  Your PassWord?</h2>
                    <p class="card-description">Dont't worry -it happens! Enter your registered email or mobile<br /> number to reset your password</p>

                   
                    <!-- SIGN IN -->
                    <form id="signinForm" class="auth-form" autocomplete="on">
                        <!-- Email -->
                        <div class="input-wrapper">
                            <label class="form-label">Email Address</label>
                            <div class="position-relative">
                                <img src="../image/material-symbols_mail-outline.png" alt="Email" class="input-icon">
                                <input type="email" class="form-input" placeholder="your.email@example.com" required>
                            </div>
                        </div>

                        <div class="remember-forgot">
                            <label class="checkbox-label">
                                <input type="checkbox" class="custom-checkbox">
                                <span>Remember me</span>
                            </label>
                            <a href="#" class="forgot-link">Forgot password?</a>
                        </div>

                        <button type="submit" class="signin-button">
                            <span>Sign In</span>
                            <img src="../image/ic_baseline-arrow-back.png" alt="Arrow" class="arrow-icon" style="transform: rotate(360deg);">
                        </button>
                    </form>

                 
                    <!-- Divider -->
                    <div class="divider-container">
                        <div class="divider-line"></div>
                        <span class="divider-text">OR CONTINUE WITH</span>
                        <div class="divider-line"></div>
                    </div>

                    <!-- Social Buttons -->
                    <div class="social-buttons">
                        <button class="social-button" onclick="socialLogin('google')">
                            <img src="../image/logos_facebook.png" alt="Google" class="social-icon">
                            <span>Google</span>
                        </button>
                        <button class="social-button" onclick="socialLogin('facebook')">
                            <img src="../image/devicon_google.png" alt="Facebook" class="social-icon">
                            <span>FaceBook</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  
</body>
</html>
