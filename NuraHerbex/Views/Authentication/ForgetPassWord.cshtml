
@{

    Layout = null;
}
    <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NuraHerbex - Forget PassWord</title>
    <link rel="icon" type="image/png" href="~/image/logo.png" />
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/loginstyle.css" asp-append-version="true" />
    <style>
        .otp-modal {
            display: none; /* Hidden by default */
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6); /* Semi-transparent background */
            justify-content: center;
            align-items: center;
            z-index: 1050; /* Ensure it appears on top of other elements */
        }

        .otp-modal-content {
            background: #18212d;
            padding: 30px;
            border-radius: 8px;
            text-align: center;
            width: 468px;
            color: white;
            position: relative;
        }

            .otp-modal-content h2 {
                font-size: 24px;
                margin-bottom: 10px;
            }

        .otp-inputs {
            display: flex;
            justify-content: space-between;
            margin: 20px 0;
        }

        .otp-input {
            width: 50px;
            height: 50px;
            font-size: 1.5em;
            text-align: center;
            border-radius: 8px;
            border: 1px solid #ccc;
            background-color: #34495e;
            color: #fff;
        }

        .verify-btn {
            background-color: #f44900;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
        }

            .verify-btn:hover {
                background-color: #f44900;
            }

        /* Close button styling */
        .close-btn {
            position: absolute;
            top: 10px;
            right: 10px;
            background-color: transparent;
            color: white;
            border: none;
            font-size: 20px;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="container-fluid main-container">
        <div class="row justify-content-center align-items-center g-5">
            <!-- Left Section -->
            <div class="col-12 col-lg-6">
                <div class="left-section">
                    <!-- Logo -->
                    <div class="logo-container"></div>

                    <!-- Heading -->
                    <h1 class="main-heading">
                        Your Next Level <span class="highlight">Starts Here</span>
                    </h1>

                    <!-- Subheading -->
                    <p class="sub-heading">
                        Join thousands of men who've transformed their health and performance with STAMIX's premium wellness solutions.
                    </p>

                    <!-- Features -->
                    <div class="features">
                        <div class="feature-item">
                            <div class="d-flex align-items-center mb-2">
                                <img src="~/image/signin/group.png" alt="Expert-Curated Products" class="feature-icon me-3">
                                <h3 class="feature-title mb-0">Expert-Curated Products</h3>
                            </div>
                            <p class="feature-description mb-0">Science-backed formulations for optimal results</p>
                        </div>

                        <div class="feature-item">
                            <div class="d-flex align-items-center mb-2">
                                <img src="~/image/signin/vector.png" alt="Personalized Support" class="feature-icon me-3">
                                <h3 class="feature-title mb-0">Personalized Support</h3>
                            </div>
                            <p class="feature-description mb-0">Custom wellness plans and expert consultations</p>
                        </div>

                        <div class="feature-item">
                            <div class="d-flex align-items-center mb-2">
                                <img src="~/image/signin/users-01 2 1.svg" alt="Community Access" class="feature-icon me-3">
                                <h3 class="feature-title mb-0">Community Access</h3>
                            </div>
                            <p class="feature-description mb-0">Connect with like-minded men on their wellness journey</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Section (Auth Card) -->
            <div class="col-12 col-lg-6 d-flex justify-content-center">
                <div class="auth-card w-100" style="max-width: 824px;">
                    <!-- Header -->
                    <h2 class="card-title">Forget  Your Password?</h2>
                    <p class="card-description">Don’t worry - it happens! Enter your registered email or mobile number to reset your password</p>

                    <!-- SIGN IN -->
                    <form id="signinForm" class="auth-form" autocomplete="on">
                        <!-- Email -->
                        <div class="input-wrapper">
                            <label class="form-label">Enter Email Address</label>
                            <div class="position-relative">
                                <img src="~/image/signin/material-symbols_mail-outline.png" alt="Email" class="input-icon">
                                <input type="email" class="form-input" placeholder="your.email@example.com" required>
                            </div>
                        </div>

                        <div class="remember-forgot" style="float:right!important;">
                            Back to<a href="#" class="forgot-link"> Login</a>
                        </div>

                        <!-- Add the id here -->
                        <button type="submit" class="signin-button" id="sendOtpBtn">
                            <span>Send OTP</span>
                            <img src="~/image/signin/ic_baseline-arrow-back.png" alt="Arrow" class="arrow-icon" style="transform: rotate(360deg);">
                        </button>
                    </form>
                    <a asp-action="index" asp-controller="Home" style="float:right!important; color:white;">Back</a>
                </div>
            </div>
        </div>
    </div>

    <!-- OTP Modal -->
    <div class="otp-modal" id="otpModal">
        <div class="otp-modal-content">
            <!-- Close button to close the modal -->
            <button class="close-btn" id="closeModalBtn">&times;</button>

            <h2>Verify Your Account</h2>
            <p>We’ve sent a 6-digit code to your email.</p>

            <!-- OTP Input Fields -->
            <div class="otp-inputs">
                <input type="text" class="otp-input" maxlength="1">
                <input type="text" class="otp-input" maxlength="1">
                <input type="text" class="otp-input" maxlength="1">
                <input type="text" class="otp-input" maxlength="1">
                <input type="text" class="otp-input" maxlength="1">
                <input type="text" class="otp-input" maxlength="1">
            </div>

            <p class="mt-2">Didn't receive code? <a href="#" style="color:#f44900;">Resend OTP</a></p>

            <!-- Verify & Continue Button -->
            <button class="verify-btn">Verify & Continue</button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Ensure this script runs after the DOM is loaded
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('sendOtpBtn').addEventListener('click', function(e) {
                e.preventDefault(); // Prevent the form submission
                document.getElementById('otpModal').style.display = 'flex'; // Show the OTP Modal
            });

            // Close modal on clicking the 'Verify & Continue' button
            document.querySelector('.verify-btn').addEventListener('click', function() {
                alert('OTP Verified!');
                document.getElementById('otpModal').style.display = 'none'; // Close the OTP Modal
            });

            // Close the modal when the close button is clicked
            document.getElementById('closeModalBtn').addEventListener('click', function() {
                document.getElementById('otpModal').style.display = 'none'; // Close the OTP Modal
            });
        });
    </script>
</body>
</html>
