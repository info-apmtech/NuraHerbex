@model Domain.ViewModel.ForgotPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NuraHerbex - Forgot PassWord</title>
    <link rel="icon" type="image/png" href="~/image/logo.png" />
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/loginstyle.css" asp-append-version="true" />
</head>
<body>
    <partial name="_HeaderLayout" />

    <div class="container-fluid main-container">
        <div class="row justify-content-center d-lg-none">
            <div class="col-12 mobile-logo-container">
                <img src="~/image/logo.png" alt="NuraHerbex Logo" class="mobile-logo">
            </div>
        </div>

        <div class="row justify-content-center align-items-center g-5">
            <!-- Left Section -->
            <div class="col-lg-6 d-none d-lg-block left-section-desktop">
                <div class="left-section">
                    <div class="logo-container"></div>

                    <h1 class="main-heading">
                        Your Next Level <span class="highlight">Starts Here</span>
                    </h1>

                    <p class="sub-heading">
                        Join thousands of men who've transformed their health and performance with STAMIX's premium wellness solutions.
                    </p>

                    <div class="features">
                        <div class="feature-item">
                            <div class="d-flex align-items-center mb-2">
                                <img src="~/image/signin/group.png" alt="Expert-Curated Products" class="feature-icon me-3">
                                <h3 class="feature-title mb-0">Expert-Curated Products</h3>
                            </div>
                            <p class="feature-description mb-0">Science-backed formulations for optimal results</p>
                        </div>

                        <div class="feature-item">
                            <div class="d-flex align-items-center mb-2">
                                <img src="~/image/signin/vector.png" alt="Personalized Support" class="feature-icon me-3">
                                <h3 class="feature-title mb-0">Personalized Support</h3>
                            </div>
                            <p class="feature-description mb-0">Custom wellness plans and expert consultations</p>
                        </div>

                        <div class="feature-item">
                            <div class="d-flex align-items-center mb-2">
                                <img src="~/image/signin/users-01 2 1.svg" alt="Community Access" class="feature-icon me-3">
                                <h3 class="feature-title mb-0">Community Access</h3>
                            </div>
                            <p class="feature-description mb-0">Connect with like-minded men on their wellness journey</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Section (Auth Card) -->
            <div class="col-12 col-lg-6 d-flex justify-content-center">
                <div class="auth-card w-100" style="max-width: 824px;">
                    <!-- Header -->
                    <h2 class="card-title">Forget Your Password?</h2>
                    <p class="card-description">Don’t worry - it happens! Enter your registered email or mobile number to reset your password</p>

                    <!-- Send OTP -->
                    <form id="signinForm" class="auth-form" autocomplete="on" asp-action="ForgotPassword" asp-controller="Authentication" method="post">
                        @Html.AntiForgeryToken() <!-- IMPORTANT -->
                        <div class="input-wrapper">
                            <label class="form-label">Enter Email Address</label>
                            <div class="position-relative">
                                <img src="~/image/signin/material-symbols_mail-outline.png" alt="Email" class="input-icon">
                                <input type="text" class="form-input" placeholder="your.email@example.com" asp-for="Email" required>
                            </div>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="remember-forgot" style="float:right!important;">
                            <a asp-action="SignIn" asp-controller="Authentication" class="forgot-link">Back to Login</a>
                        </div>

                        <button type="submit" class="signin-button" id="sendOtpBtn">
                            <span>Send OTP</span>
                            <img src="~/image/signin/ic_baseline-arrow-back.png" alt="Arrow" class="arrow-icon" style="transform: rotate(360deg);">
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- OTP Modal -->
    <div class="otp-modal" id="otpModal" style="display:none;">
        <div class="otp-modal-content">
            <!-- Close button to close the modal -->
            <button class="close-btn" id="closeModalBtn" aria-label="Close">&times;</button>

            <h2>Verify Your Account</h2>
            <p>We’ve sent a 6-digit code to your email.</p>

            <form method="post" asp-action="VerifyOtp" asp-controller="Authentication" id="verifyOtpForm" novalidate>
                @Html.AntiForgeryToken()

                <!-- Use explicit name/id to avoid duplicate id="Email" -->
                <input type="hidden" name="Email" id="ModalEmailHidden" />
                <input type="hidden" name="Otp" id="ModalOtpHidden" />

                <div class="otp-inputs" aria-label="Enter 6 digit code">
                    <input type="text" class="otp-input" inputmode="numeric" pattern="[0-9]*" maxlength="1">
                    <input type="text" class="otp-input" inputmode="numeric" pattern="[0-9]*" maxlength="1">
                    <input type="text" class="otp-input" inputmode="numeric" pattern="[0-9]*" maxlength="1">
                    <input type="text" class="otp-input" inputmode="numeric" pattern="[0-9]*" maxlength="1">
                    <input type="text" class="otp-input" inputmode="numeric" pattern="[0-9]*" maxlength="1">
                    <input type="text" class="otp-input" inputmode="numeric" pattern="[0-9]*" maxlength="1">
                </div>

                <p class="mt-2">
                    Didn't receive code?
                    <a href="#" id="resendOtpBtn" style="color:#f44900;">Resend OTP</a>
                </p>

                <button type="submit" class="verify-btn">Verify & Continue</button>
            </form>


            <p id="resendMessage" class="text-success mt-3"></p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
          const signinForm   = document.getElementById('signinForm');
          const sendBtn      = document.getElementById('sendOtpBtn');
          const otpModal     = document.getElementById('otpModal');
          const closeModal   = document.getElementById('closeModalBtn');
          const verifyForm   = document.getElementById('verifyOtpForm');

          // Send OTP then open modal
          sendBtn.addEventListener('click', async function (e) {
            e.preventDefault();
            const formData = new FormData(signinForm);
            const email = (formData.get('Email') || '').trim();
            if (!email) { alert('Please enter your email address.'); return; }

            const resp = await fetch('/Authentication/ForgotPassword', { method:'POST', body: formData });
            if (!resp.ok) { alert('Error sending OTP.'); return; }

            // show modal
            otpModal.style.display = 'flex';

            // put the email into the modal hidden input (ID is unique)
            document.getElementById('ModalEmailHidden').value = email;

            // focus first OTP box
            otpModal.querySelector('.otp-input')?.focus();
          });

          // Concat 6 digits into hidden field before POSTing
          verifyForm.addEventListener('submit', function () {
            const digits = Array.from(otpModal.querySelectorAll('.otp-input')).map(i => (i.value || '').trim()).join('');
            document.getElementById('ModalOtpHidden').value = digits;
            // no preventDefault here → let the form submit
          });

          // Little UX helpers
          otpModal.querySelectorAll('.otp-input').forEach((el, idx, arr) => {
            el.addEventListener('input', () => {
              el.value = el.value.replace(/\D/g, '').slice(0,1);
              if (el.value && idx < arr.length - 1) arr[idx+1].focus();
            });
            el.addEventListener('keydown', (e) => {
              if (e.key === 'Backspace' && !el.value && idx > 0) arr[idx-1].focus();
            });
          });

          closeModal.addEventListener('click', () => otpModal.style.display = 'none');
        });
    </script>

</body>
</html>
