@model Domain.ViewModel.BlogViewModel

@{
    var isEdit = Model.NewBlog.Id > 0;
    ViewData["Title"] = "Blog Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">

        <div class="row heading-bg mb-3">
            <div class="col-12">
                <h4>Blog Management</h4>
            </div>
        </div>

        <!-- Tabs -->
        <ul class="nav nav-tabs mb-3" id="blogTab" role="tablist">
            <li class="nav-item">
                <a class="nav-link text-uppercase @(isEdit ? "" : "active")"
                   id="blog-list-tab"
                   data-toggle="tab"
                   href="#blog-list"
                   role="tab"
                   aria-controls="blog-list"
                   aria-selected="@(isEdit ? "false" : "true")">
                    List
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-uppercase @(isEdit ? "active" : "")"
                   id="add-blog-tab"
                   data-toggle="tab"
                   href="#add-blog"
                   role="tab"
                   aria-controls="add-blog"
                   aria-selected="@(isEdit ? "true" : "false")">
                    @(!isEdit ? "Add Blog" : "Edit Blog")
                </a>
            </li>
        </ul>

        <div class="tab-content" id="blogTabContent">

            <!-- ===========================
                 BLOG LIST
            ============================ -->
            <div class="tab-pane fade @(isEdit ? "" : "show active")"
                 id="blog-list"
                 role="tabpanel"
                 aria-labelledby="blog-list-tab">

                <div class="card shadow-sm">
                    <div class="card-header bg-white border-bottom-0">
                        <h5 class="mb-0">Blog List</h5>
                    </div>

                    <div class="card-body p-3">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped mb-0 w-100">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Title</th>
                                        <th>Categories</th>
                                        <th>Written By</th>
                                        <th>Read Time</th>
                                        <th>Created At</th>
                                        <th style="min-width:160px;">Actions</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (Model.BlogList.Any())
                                    {
                                        foreach (var blog in Model.BlogList)
                                        {
                                            <tr>
                                                <td>@blog.Title</td>

                                                <td>
                                                    @{
                                                        var catNames = Model.Categories
                                                        .Where(c => blog.BlogCategoryIds?
                                                        .Split(',')
                                                        .Contains(c.Id.ToString()) == true)
                                                        .Select(c => c.Name);
                                                    }
                                                    @string.Join(", ", catNames)
                                                </td>

                                                <td>@blog.WrittenBy</td>
                                                <td>@blog.ReadTime</td>
                                                <td>@blog.CreatedAt.ToString("dd MMM yyyy")</td>

                                                <td>
                                                    <form method="get"
                                                          asp-action="AdminBlog"
                                                          asp-route-id="@blog.Id"
                                                          style="display:inline;">
                                                        <button class="btn btn-sm btn-warning">Edit</button>
                                                    </form>

                                                    <form method="post"
                                                          asp-action="DeleteBlog"
                                                          asp-route-id="@blog.Id"
                                                          onsubmit="return confirm('Are you sure you want to delete this blog?');"
                                                          style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <button class="btn btn-sm btn-danger">Delete</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center">No blogs found.</td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ===========================
                 ADD / EDIT BLOG
            ============================ -->
            <div class="tab-pane fade @(isEdit ? "show active" : "")"
                 id="add-blog"
                 role="tabpanel"
                 aria-labelledby="add-blog-tab">

                <div class="card shadow-sm">
                    <div class="card-header bg-white border-bottom-0">
                        <h5 class="mb-0">@(!isEdit ? "Add New Blog" : "Edit Blog")</h5>
                    </div>

                    <div class="card-body">
                        <form asp-action="AdminBlog"
                              asp-controller="Admin"
                              method="post"
                              enctype="multipart/form-data">

                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="NewBlog.Id" />

                            <div class="row">

                                <div class="col-md-6 mb-3">
                                    <label asp-for="NewBlog.Title" class="form-label"></label>
                                    <input asp-for="NewBlog.Title" class="form-control" required />
                                    <span asp-validation-for="NewBlog.Title" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="NewBlog.WrittenBy" class="form-label"></label>
                                    <input asp-for="NewBlog.WrittenBy" class="form-control" required />
                                    <span asp-validation-for="NewBlog.WrittenBy" class="text-danger"></span>
                                </div>

                                <div class="col-12 mb-3">
                                    <label asp-for="NewBlog.Description" class="form-label"></label>
                                    <textarea asp-for="NewBlog.Description"
                                              rows="6"
                                              class="form-control"
                                              required></textarea>
                                    <span asp-validation-for="NewBlog.Description" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="NewBlog.ReadTime" class="form-label"></label>
                                    <input asp-for="NewBlog.ReadTime" class="form-control" placeholder="e.g. 5 min read" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Categories</label>
                                    <select asp-for="SelectedCategoryIds"
                                            asp-items="@(new MultiSelectList(Model.Categories, "Id", "Name", Model.SelectedCategoryIds))"
                                            class="form-control selectpicker"
                                            multiple
                                            data-live-search="true">
                                    </select>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label>Main Image</label>
                                    <input asp-for="ImageFile" type="file" class="form-control" />
                                    <input type="hidden" asp-for="NewBlog.ImagePath" />

                                    @if (!string.IsNullOrEmpty(Model.NewBlog.ImagePath))
                                    {
                                        <img src="@Model.NewBlog.ImagePath"
                                             class="img-fluid mt-2"
                                             style="max-height:150px;" />
                                    }
                                </div>

                                <div class="col-md-6 mb-3 form-check">
                                    <input asp-for="NewBlog.IsFeatured"
                                           class="form-check-input"
                                           type="checkbox"
                                           id="featuredCheck" />
                                    <label asp-for="NewBlog.IsFeatured"
                                           class="form-check-label"
                                           for="featuredCheck">
                                        Featured
                                    </label>
                                </div>

                            </div>

                            <button type="submit" class="btn btn-primary">
                                @(!isEdit ? "Create Blog" : "Update Blog")
                            </button>

                            <a asp-action="AdminBlog"
                               asp-route-id="0"
                               class="btn btn-secondary ms-2">
                                Clear
                            </a>

                        </form>
                    </div>
                </div>

            </div>

        </div>

    </div>
</div>
