@{
    ViewData["Title"] = "Blog Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">
        <div class="d-flex flex-column align-items-center" style="min-height: 90vh;">
            <div class="w-100" style="max-width: 1100px;">
                <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
                    <h4 class="mb-0">Blog Management</h4>
                </div>

                <ul class="nav nav-tabs mb-3" id="blogTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active text-uppercase" id="list-tab" data-toggle="tab" href="#list" role="tab" aria-controls="list" aria-selected="true">List</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase" id="newblog-tab" data-toggle="tab" href="#newblog" role="tab" aria-controls="newblog" aria-selected="false">New Blog</a>
                    </li>
                </ul>

                <div class="tab-content" id="blogTabContent">
                    <div class="tab-pane fade show active" id="list" role="tabpanel" aria-labelledby="list-tab">
                        <div class="card shadow-sm">
                            <div class="card-header bg-white border-bottom-0">
                                <h5 class="mb-0">Blog List</h5>
                            </div>
                            <div class="card-body p-3">
                                <div class="table-responsive">
                                    <table id="blogTable" class="table table-striped table-bordered mb-0 w-100">
                                        <thead>
                                            <tr>
                                                <th>Title</th>
                                                <th>Categories</th>
                                                <th>Written By</th>
                                                <th>Read Time</th>
                                                <th>Created At</th>
                                                <th style="min-width:120px;">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- Sample data; replace with your dynamic rows -->
                                            <tr>
                                                <td>The Science Behind Peak Male Performance</td>
                                                <td>Performance, Wellness</td>
                                                <td>Dr. Marcus Chen</td>
                                                <td>8 min Read</td>
                                                <td>12 Mar 2025</td>
                                                <td>
                                                    <button class="btn btn-sm btn-warning">Edit</button>
                                                    <button class="btn btn-sm btn-danger">Delete</button>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>5 Morning Habits That Boost Energy</td>
                                                <td>Lifestyle</td>
                                                <td>Dr. Marcus Chen</td>
                                                <td>5 min Read</td>
                                                <td>15 Dec 2024</td>
                                                <td>
                                                    <button class="btn btn-sm btn-warning">Edit</button>
                                                    <button class="btn btn-sm btn-danger">Delete</button>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="newblog" role="tabpanel" aria-labelledby="newblog-tab">
                        <div class="card shadow-sm">
                            <div class="card-header bg-white border-bottom-0">
                                <h5 class="mb-0">Create Blog</h5>
                            </div>
                            <div class="card-body">
                                <form method="post" action="/Admin/CreateBlog" enctype="multipart/form-data">
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label for="Title">Title</label>
                                            <input type="text" id="Title" name="Title" class="form-control" required />
                                        </div>
                                        <div class="col-md-6">
                                            <label for="WrittenBy">Written By</label>
                                            <input type="text" id="WrittenBy" name="WrittenBy" class="form-control" required />
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="Description">Description</label>
                                        <textarea id="Description" name="Description" class="form-control" rows="6"></textarea>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label for="ReadTime">Read Time</label>
                                            <input type="text" id="ReadTime" name="ReadTime" class="form-control" placeholder="e.g., 5 min read" />
                                        </div>
                                        <div class="col-md-6">
                                            <label for="BlogCategoryIds">Categories</label>
                                            <select id="BlogCategoryIds" name="BlogCategoryIds" class="form-control"required>
                                                <option value="">Select Category</option>
                                                <option value="1">Performance</option>
                                                <option value="2">Wellness</option>
                                                <option value="3">Lifestyle</option>
                                                <option value="4">Nutrition</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label for="Image1Path">Main Image</label>
                                            <input type="file" id="Image1Path" name="Image1Path" class="form-control" />
                                        </div>
                                    </div>

                                    <button type="submit" class="btn btn-primary">Save</button>
                                </form>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>
