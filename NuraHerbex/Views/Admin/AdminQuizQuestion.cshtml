@using Domain.ViewModel
@model QuizQuestionViewModel

@{
    var isEdit = Model.NewQuestion.Id > 0;
    ViewData["Title"] = "Quiz Question Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">

        <h4 class="mb-3">Quiz Questions</h4>

        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <a class="nav-link @(isEdit ? "" : "active")" data-toggle="tab" href="#list">List</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(isEdit ? "active" : "")" data-toggle="tab" href="#add">
                    @(isEdit ? "Edit Question" : "Add Question")
                </a>
            </li>
        </ul>

        <div class="tab-content">

            <!-- QUESTION LIST -->
            <div class="tab-pane fade @(isEdit ? "" : "show active")" id="list">
                <div class="card shadow-sm">
                    <div class="card-header bg-white"><h5>Question List</h5></div>
                    <div class="card-body p-3">
                        <table class="table table-bordered table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>#</th>
                                    <th>Category</th>
                                    <th>Question</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.QuestionList.Any())
                                {
                                    int i = 1;
                                    foreach (var q in Model.QuestionList)
                                    {
                                        var cat = Model.Categories.FirstOrDefault(c => c.Id == q.CategoryId);

                                        <tr>
                                            <td>@i</td>
                                            <td>@cat?.Name</td>
                                            <td>@q.QuestionText</td>
                                            <td>
                                                <span class="badge @(q.IsActive ? "bg-success" : "bg-secondary")">
                                                    @(q.IsActive ? "Active" : "Inactive")
                                                </span>
                                            </td>
                                            <td>
                                                <form method="get" asp-action="AdminQuizQuestion" asp-route-id="@q.Id" style="display:inline;">
                                                    <button class="btn btn-sm btn-warning">Edit</button>
                                                </form>

                                                <form method="post" asp-action="DeleteQuizQuestion" asp-route-id="@q.Id"
                                                      onsubmit="return confirm('Delete this question?');" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <button class="btn btn-sm btn-danger">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                        i++;
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="5" class="text-center">No questions found</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ADD/EDIT FORM -->
            <div class="tab-pane fade @(isEdit ? "show active" : "")" id="add">
                <div class="card">
                    <div class="card-header bg-white"><h5>Add / Edit Question</h5></div>
                    <div class="card-body">

                        <form asp-action="AdminQuizQuestion" method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="NewQuestion.Id" />

                            <div class="mb-3">
                                <label>Category</label>
                                <select asp-for="NewQuestion.CategoryId" class="form-control" required>
                                    <option value="">-- Select Category --</option>
                                    @foreach (var c in Model.Categories)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label>Question Text</label>
                                <textarea asp-for="NewQuestion.QuestionText" class="form-control" rows="3" required></textarea>
                            </div>

                            <div class="form-check mb-2">
                                <input asp-for="NewQuestion.IsActive" class="form-check-input" />
                                <label class="form-check-label">Is Active</label>
                            </div>

                            <button class="btn btn-primary">
                                @(isEdit ? "Update Question" : "Add Question")
                            </button>

                            <a asp-action="AdminQuizQuestion" class="btn btn-secondary">Clear</a>
                        </form>

                    </div>
                </div>
            </div>

        </div>

    </div>
</div>
