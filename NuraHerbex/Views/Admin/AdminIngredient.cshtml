@model Domain.ViewModel.IngredientViewModel

@{
    var isEdit = Model.NewIngredient.Id > 0;
    var activeTab = TempData["ActiveTab"]?.ToString() ?? (isEdit ? "newingredient" : "list");
    ViewData["Title"] = "Ingredient Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">
        <div class="d-flex flex-column align-items-center" style="min-height: 90vh;">
            <div class="w-100" style="max-width: 1100px;">
                <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
                    <h4 class="mb-0">Ingredient Management</h4>
                </div>

                <!-- Tabs -->
                <ul class="nav nav-tabs mb-3" id="ingredientTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link text-uppercase @(activeTab == "list" ? "active" : "")"
                           id="list-tab" data-toggle="tab" href="#list" role="tab"
                           aria-controls="list" aria-selected="@(activeTab == "list" ? "true" : "false")">
                            List
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase @(activeTab == "newingredient" ? "active" : "")"
                           id="newingredient-tab" data-toggle="tab" href="#newingredient" role="tab"
                           aria-controls="newingredient" aria-selected="@(activeTab == "newingredient" ? "true" : "false")">
                            @(!isEdit ? "New Ingredient" : "Edit Ingredient")
                        </a>
                    </li>
                </ul>

                <div class="tab-content" id="ingredientTabContent">
                    <!-- Ingredient List -->
                    <div class="tab-pane fade @(activeTab == "list" ? "show active" : "")" id="list" role="tabpanel" aria-labelledby="list-tab">
                        <div class="card shadow-sm">
                            <div class="card-header bg-white border-bottom-0">
                                <h5 class="mb-0">Ingredient List</h5>
                            </div>
                            <div class="card-body p-3">
                                <div class="table-responsive">
                                    <table id="ingredientTable" class="table table-striped table-bordered mb-0 w-100">
                                        <thead>
                                            <tr>
                                                <th>Image</th>
                                                <th>Name</th>
                                                <th>Scientific Name</th>
                                                <th>Category</th>
                                                <th>Created At</th>
                                                <th style="min-width:120px;">Active</th>
                                                <th style="min-width:120px;">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.IngredientList.Any())
                                            {
                                                foreach (var ingredient in Model.IngredientList)
                                                {
                                                    <tr>
                                                        <td><img src="@ingredient.ImagePath" alt="Image" style="width:40px;height:40px;border-radius:6px;" /></td>
                                                        <td>@ingredient.IngredientName</td>
                                                        <td>@ingredient.ScientificName</td>
                                                        <td>
                                                            @Model.IngredientCategories.FirstOrDefault(c => c.Id == ingredient.IngredientCategoryId)?.Name
                                                        </td>
                                                        <td>@ingredient.CreatedAt.ToString("dd MMM yyyy")</td>
                                                        <td>
                                                            @if (ingredient.IsActive)
                                                            {
                                                                <span class="badge badge-success">Active</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge badge-secondary">Inactive</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            <form method="get" asp-action="AdminIngredient" asp-route-id="@ingredient.Id" style="display:inline;">
                                                                <button type="submit" class="btn btn-sm btn-warning">Edit</button>
                                                            </form>

                                                            <form method="post" asp-action="DeleteIngredient" asp-route-id="@ingredient.Id" onsubmit="return confirm('Are you sure you want to delete this ingredient?');" style="display:inline;">
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="8" class="text-center">No ingredients found.</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Add/Edit Ingredient Form -->
                    <div class="tab-pane fade @(activeTab == "newingredient" ? "show active" : "")" id="newingredient" role="tabpanel" aria-labelledby="newingredient-tab">
                        <div class="card shadow-sm">
                            <div class="card-header bg-white border-bottom-0">
                                <h5 class="mb-0">@(!isEdit ? "Create Ingredient" : "Edit Ingredient")</h5>
                            </div>
                            <div class="card-body">
                                <form asp-action="AdminIngredient" asp-controller="Admin" method="post" enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" asp-for="NewIngredient.Id" />

                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label asp-for="NewIngredient.IngredientName"></label>
                                            <input asp-for="NewIngredient.IngredientName" class="form-control" required />
                                            <span asp-validation-for="NewIngredient.IngredientName" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="NewIngredient.IngredientCategoryId">Category</label>
                                            <select asp-for="NewIngredient.IngredientCategoryId" class="form-control"
                                                    asp-items="@(new SelectList(Model.IngredientCategories, "Id", "Name", Model.NewIngredient.IngredientCategoryId))">
                                                <option value="">Select category</option>
                                            </select>
                                            <span asp-validation-for="NewIngredient.IngredientCategoryId" class="text-danger"></span>
                                        </div>
                                        <br />
                                        <div class="col-md-6">
                                            <label asp-for="NewIngredient.ScientificName"></label>
                                            <input asp-for="NewIngredient.ScientificName" class="form-control" />
                                            <span asp-validation-for="NewIngredient.ScientificName" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label>Main Image</label>
                                            <input asp-for="ImageFile" type="file" class="form-control" />
                                            <input type="hidden" asp-for="NewIngredient.ImagePath" />

                                            @if (!string.IsNullOrEmpty(Model.NewIngredient.ImagePath))
                                            {
                                                <img src="@Model.NewIngredient.ImagePath" alt="Ingredient Image" class="img-fluid mt-2" style="max-height: 150px;" />
                                            }

                                            <span asp-validation-for="NewIngredient.ImagePath" class="text-danger"></span>
                                        </div>

                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="NewIngredient.Benefits"></label>
                                        <input asp-for="NewIngredient.Benefits" class="form-control" />
                                        <span asp-validation-for="NewIngredient.Benefits" class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="NewIngredient.Evidence"></label>
                                        <input asp-for="NewIngredient.Evidence" class="form-control" />
                                        <span asp-validation-for="NewIngredient.Evidence" class="text-danger"></span>
                                    </div>
                                    <div class="form-check mb-3">
                                        <input asp-for="NewIngredient.ShowHome" class="form-check-input" type="checkbox" id="showHomeCheckbox" />
                                        <label asp-for="NewIngredient.ShowHome" class="form-check-label" for="showHomeCheckbox">
                                            Show on Home Page
                                        </label>
                                    </div>
                                    <div class="form-check mb-3">
                                        <input asp-for="NewIngredient.IsActive" class="form-check-input" type="checkbox" id="isActiveCheckbox" />
                                        <label asp-for="NewIngredient.IsActive" class="form-check-label" for="isActiveCheckbox">
                                            Active
                                        </label>
                                    </div>

                                    <button type="submit" class="btn btn-primary">@(!isEdit ? "Create" : "Update")</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div> <!-- tab-content -->
            </div>
        </div>
    </div>
</div>
