@model Domain.ViewModel.IngredientViewModel

@{
    var isEdit = Model.NewIngredient.Id > 0;
    ViewData["Title"] = "Ingredient Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">

        <div class="row heading-bg mb-3">
            <div class="col-12">
                <h4>Ingredients</h4>
            </div>
        </div>

        <!-- Tabs -->
        <ul class="nav nav-tabs mb-3" id="ingredientTab" role="tablist">
            <li class="nav-item">
                <a class="nav-link text-uppercase @(isEdit ? "" : "active")"
                   id="ingredient-list-tab"
                   data-toggle="tab"
                   href="#ingredient-list"
                   role="tab"
                   aria-controls="ingredient-list"
                   aria-selected="@(isEdit ? "false" : "true")">
                    List
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-uppercase @(isEdit ? "active" : "")"
                   id="add-ingredient-tab"
                   data-toggle="tab"
                   href="#add-ingredient"
                   role="tab"
                   aria-controls="add-ingredient"
                   aria-selected="@(isEdit ? "true" : "false")">
                    @(!isEdit ? "Add Ingredient" : "Edit Ingredient")
                </a>
            </li>
        </ul>

        <div class="tab-content" id="ingredientTabContent">

            <!-- ===========================
                 INGREDIENT LIST
            ============================ -->
            <div class="tab-pane fade @(isEdit ? "" : "show active")"
                 id="ingredient-list"
                 role="tabpanel"
                 aria-labelledby="ingredient-list-tab">

                <div class="card shadow-sm">
                    <div class="card-header bg-white border-bottom-0">
                        <h5 class="mb-0">Ingredient List</h5>
                    </div>

                    <div class="card-body p-3">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped mb-0 w-100">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Image</th>
                                        <th>Name</th>
                                        <th>Scientific Name</th>
                                        <th>Category</th>
                                        <th>Created At</th>
                                        <th>Status</th>
                                        <th style="min-width:160px;">Actions</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (Model.IngredientList.Any())
                                    {
                                        foreach (var item in Model.IngredientList)
                                        {
                                            <tr>
                                                <td>
                                                    <img src="@item.ImagePath"
                                                         style="width:40px;height:40px;border-radius:6px;">
                                                </td>

                                                <td>@item.IngredientName</td>
                                                <td>@item.ScientificName</td>

                                                <td>
                                                    @Model.IngredientCategories
                                                    .FirstOrDefault(c => c.Id == item.IngredientCategoryId)?.Name
                                                </td>

                                                <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>

                                                <td>
                                                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                                        @(item.IsActive ? "Active" : "Inactive")
                                                    </span>
                                                </td>

                                                <td>
                                                    <form method="get"
                                                          asp-action="AdminIngredient"
                                                          asp-route-id="@item.Id"
                                                          style="display:inline;">
                                                        <button type="submit"
                                                                class="btn btn-sm btn-warning">
                                                            Edit
                                                        </button>
                                                    </form>

                                                    <form method="post"
                                                          asp-action="DeleteIngredient"
                                                          asp-route-id="@item.Id"
                                                          onsubmit="return confirm('Are you sure you want to delete this ingredient?');"
                                                          style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center">No ingredients found</td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>

                    </div>
                </div>

            </div>

            <!-- ===========================
                 ADD / EDIT INGREDIENT
            ============================ -->
            <div class="tab-pane fade @(isEdit ? "show active" : "")"
                 id="add-ingredient"
                 role="tabpanel"
                 aria-labelledby="add-ingredient-tab">

                <div class="card shadow-sm">
                    <div class="card-header bg-white border-bottom-0">
                        <h5 class="mb-0">@(!isEdit ? "Add New Ingredient" : "Edit Ingredient")</h5>
                    </div>

                    <div class="card-body">
                        <form asp-action="AdminIngredient"
                              asp-controller="Admin"
                              method="post"
                              enctype="multipart/form-data">

                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="NewIngredient.Id" />

                            <div class="row">

                                <div class="col-md-6 mb-3">
                                    <label asp-for="NewIngredient.IngredientName" class="form-label"></label>
                                    <input asp-for="NewIngredient.IngredientName" class="form-control" required />
                                    <span asp-validation-for="NewIngredient.IngredientName" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="NewIngredient.IngredientCategoryId" class="form-label">Category</label>
                                    <select asp-for="NewIngredient.IngredientCategoryId"
                                            asp-items="@(new SelectList(Model.IngredientCategories, "Id", "Name", Model.NewIngredient.IngredientCategoryId))"
                                            class="form-control">
                                        <option value="">Select category</option>
                                    </select>
                                    <span asp-validation-for="NewIngredient.IngredientCategoryId" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="NewIngredient.ScientificName" class="form-label"></label>
                                    <input asp-for="NewIngredient.ScientificName" class="form-control" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label>Main Image</label>
                                    <input asp-for="ImageFile" type="file" class="form-control" />
                                    <input type="hidden" asp-for="NewIngredient.ImagePath" />

                                    @if (!string.IsNullOrEmpty(Model.NewIngredient.ImagePath))
                                    {
                                        <img src="@Model.NewIngredient.ImagePath"
                                             class="img-fluid mt-2"
                                             style="max-height:150px;" />
                                    }
                                </div>

                                <div class="col-12 mb-3">
                                    <label asp-for="NewIngredient.Benefits" class="form-label"></label>
                                    <input asp-for="NewIngredient.Benefits" class="form-control" />
                                </div>

                                <div class="col-12 mb-3">
                                    <label asp-for="NewIngredient.Evidence" class="form-label"></label>
                                    <input asp-for="NewIngredient.Evidence" class="form-control" />
                                </div>

                                <div class="col-12 mb-3">
                                    <label asp-for="NewIngredient.KnownFor" class="form-label"></label>
                                    <input asp-for="NewIngredient.KnownFor" class="form-control" />
                                </div>

                                <div class="col-12 mb-2 form-check">
                                    <input asp-for="NewIngredient.ShowHome" class="form-check-input" />
                                    <label asp-for="NewIngredient.ShowHome" class="form-check-label"></label>
                                </div>

                                <div class="col-12 mb-3 form-check">
                                    <input asp-for="NewIngredient.IsActive" class="form-check-input" />
                                    <label asp-for="NewIngredient.IsActive" class="form-check-label"></label>
                                </div>

                            </div>

                            <button type="submit" class="btn btn-primary">
                                @(!isEdit ? "Add Ingredient" : "Update Ingredient")
                            </button>

                            <a asp-action="AdminIngredient"
                               asp-route-id="0"
                               class="btn btn-secondary ms-2">
                                Clear
                            </a>

                        </form>
                    </div>

                </div>

            </div>

        </div> <!-- tab-content -->

    </div>
</div>
