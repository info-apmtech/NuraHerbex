@using Domain.Models
@using Domain.ViewModel
@model ConsultationListViewModel

@{
    ViewData["Title"] = "Doctor Consultation";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">

        <div class="row heading-bg mb-3">
            <div class="col-12">
                <h4>Consultation Bookings</h4>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white border-bottom-0">
                <h5 class="mb-0">Consultations List</h5>
            </div>

            <div class="card-body p-3">
                <div class="table-responsive">

                    <table class="table table-striped table-bordered w-100">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Patient Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Type</th>
                                <th>Preferred Doctor</th>
                                <th>Preferred Time</th>
                                <th>Submitted At</th>
                                <th>Preferred Date</th>
                                @if (Model.UserRole == "Doctor" || Model.UserRole == "Admin")
                                {
                                    <th>Actions</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.Consultations.Any())
                            {
                                int count = 1;
                                foreach (var c in Model.Consultations)
                                {
                                    <tr>
                                        <td>@count</td>
                                        <td>@c.Consultation.FirstName</td>
                                        <td>@c.Consultation.Email</td>
                                        <td>@c.Consultation.Phone</td>
                                        <td>@c.Consultation.ConsultationType</td>
                                        <td>@(c.Doctor?.FullName ?? "Unknown")</td>
                                        <td>@c.Consultation.PreferredTimeSlot</td>
                                        <td>@c.Consultation.SubmittedAt.ToString("dd MMM yyyy HH:mm")</td>
                                        <td>@c.Consultation.PreferredDate.ToString("dd MMM yyyy")</td>

                                        @if (Model.UserRole == "Doctor" || Model.UserRole == "Admin")
                                        {
                                            <td>
                                                @if (c.Consultation.Status == ConsultationStatus.Pending)
                                                {
                                                    <form asp-action="AcceptConsultation" method="post" class="d-flex mb-1">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="consultationId" value="@c.Consultation.Id" />
                                                        <input type="url" name="meetingLink" class="form-control form-control-sm me-2" required placeholder="Meeting link" />
                                                        <button type="submit" class="btn btn-success btn-sm">Accept</button>
                                                    </form>

                                                    <form asp-action="RejectConsultation" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="consultationId" value="@c.Consultation.Id" />
                                                        <button type="submit" class="btn btn-danger btn-sm w-100">Reject</button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info text-dark">@c.Consultation.Status</span>
                                                }
                                            </td>
                                        }

                                    </tr>
                                    count++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@(Model.UserRole == "Doctor" || Model.UserRole == "Admin" ? 10 : 9)"
                                        class="text-center">
                                        No consultations found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>

    </div>
</div>

