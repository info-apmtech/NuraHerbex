@{
    ViewData["Title"] = "Consultation List";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">
        <div class="d-flex flex-column align-items-center" style="min-height: 90vh;">
            <div class="w-100" style="max-width: 1100px;">
                <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
                    <h4 class="mb-0">Consultation Bookings</h4>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header bg-white border-bottom-0">
                        <h5 class="mb-0">Consultations List</h5>
                    </div>
                    <div class="card-body p-3">
                        <div class="table-responsive">
                            <table id="consultationTable" class="table table-striped table-bordered mb-0 w-100">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Patient Name</th>
                                        <th>Email</th>
                                        <th>Phone</th>
                                        <th>Consultation Type</th>
                                        <th>Preferred Doctor</th>
                                        <th>Preferred Time</th>
                                        <th>Submitted At</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @* Replace static example with dynamic data from Model *@
                                    <tr>
                                        <td>1</td>
                                        <td>John Doe</td>
                                        <td>john@example.com</td>
                                        <td>+91 1234567890</td>
                                        <td>Video Call</td>
                                        <td>Dr. Marcus Chen</td>
                                        <td>Morning (8:00 - 12:00)</td>
                                        <td>2025-10-30 10:15</td>
                                        <td>
                                            <button class="btn btn-sm btn-info" data-toggle="tooltip" title="View Details">View</button>
                                            <button class="btn btn-sm btn-danger" data-toggle="tooltip" title="Delete">Delete</button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>2</td>
                                        <td>Jane Smith</td>
                                        <td>jane@example.com</td>
                                        <td>+91 9876543210</td>
                                        <td>In Person</td>
                                        <td>Dr. Marcus Chen</td>
                                        <td>Afternoon (12:00 - 17:00)</td>
                                        <td>2025-10-29 14:42</td>
                                        <td>
                                            <button class="btn btn-sm btn-info" data-toggle="tooltip" title="View Details">View</button>
                                            <button class="btn btn-sm btn-danger" data-toggle="tooltip" title="Delete">Delete</button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

