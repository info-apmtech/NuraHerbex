@model Domain.ViewModel.PricingPlanViewModel
@{
    var isEdit = Model.NewPlan.Id > 0;
    ViewData["Title"] = "Pricing Plan Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">

        <!-- Page Header -->
        <div class="row heading-bg mb-3">
            <div class="col-12">
                <h4>Pricing Plans</h4>
            </div>
        </div>

        <!-- Tabs: List and Add/Edit -->
        <ul class="nav nav-tabs mb-3" id="planTab" role="tablist">
            <li class="nav-item">
                <a class="nav-link text-uppercase @(isEdit ? "" : "active")" id="plan-list-tab" data-toggle="tab" href="#plan-list" role="tab" aria-controls="plan-list" aria-selected="@(isEdit ? "false" : "true")">List</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-uppercase @(isEdit ? "active" : "")" id="add-plan-tab" data-toggle="tab" href="#add-plan" role="tab" aria-controls="add-plan" aria-selected="@(isEdit ? "true" : "false")">
                    @(!isEdit ? "Add Plan" : "Edit Plan")
                </a>
            </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content" id="planTabContent">

            <!-- List of Plans -->
            <div class="tab-pane fade @(isEdit ? "" : "show active")" id="plan-list" role="tabpanel" aria-labelledby="plan-list-tab">
                <div class="card shadow-sm">
                    <div class="card-header bg-white border-bottom-0">
                        <h5 class="mb-0">Pricing Plan List</h5>
                    </div>
                    <div class="card-body p-3">
                        <table class="table table-bordered table-striped mb-0 w-100">
                            <thead class="table-dark">
                                <tr>
                                    <th>#</th>
                                    <th>Plan Name</th>
                                    <th>Price</th>
                                    <th>Duration</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.PlanList.Any())
                                {
                                    int sno = 1;
                                    foreach (var plan in Model.PlanList)
                                    {
                                                <tr>
                                                    <td>@sno</td>
                                                    <td>@plan.PlanName</td>
                                                    <td>@plan.PriceAmount.ToString("C")</td>
                                                    <td>@plan.Duration</td>                                                    
                                                    <td>
                                                        <form method="get" asp-action="AdminPricingPlan" asp-route-id="@plan.Id" style="display:inline;">
                                                            <button type="submit" class="btn btn-sm btn-warning">Edit</button>
                                                        </form>
                                                        <form method="post" asp-action="DeletePricingPlan" asp-route-id="@plan.Id" style="display:inline;" onsubmit="return confirm('Are you sure?');">
                                                    @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                        </form>
                                                    </td>
                                                </tr>
                                        sno++;
                                    }
                                }
                                else
                                {
                                        <tr>
                                            <td colspan="10" class="text-center">No plans found</td>
                                        </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Add/Edit Plan Form -->
            <div class="tab-pane fade @(isEdit ? "show active" : "")" id="add-plan" role="tabpanel" aria-labelledby="add-plan-tab">
                <div class="card shadow-sm">
                    <div class="card-header bg-white border-bottom-0">
                        <h5 class="mb-0">@(!isEdit ? "Add New Plan" : "Edit Plan")</h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="AdminPricingPlan" asp-controller="Admin" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="NewPlan.Id" />

                            <!-- Basic Plan Info -->
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="NewPlan.PlanName" class="form-label"></label>
                                    <input asp-for="NewPlan.PlanName" class="form-control" required />
                                    <span asp-validation-for="NewPlan.PlanName" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="NewPlan.PlanSubtitle" class="form-label"></label>
                                    <input asp-for="NewPlan.PlanSubtitle" class="form-control" />
                                    <span asp-validation-for="NewPlan.PlanSubtitle" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Price and Duration -->
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="NewPlan.PriceAmount" class="form-label"></label>
                                    <input asp-for="NewPlan.PriceAmount" type="number" step="0.01" min="0" class="form-control" required />
                                    <span asp-validation-for="NewPlan.PriceAmount" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="NewPlan.Duration" class="form-label"></label>
                                    <input asp-for="NewPlan.Duration" class="form-control" required />
                                    <span asp-validation-for="NewPlan.Duration" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Description -->
                            <div class="row mb-3">
                                <div class="col-12">
                                    <label asp-for="NewPlan.PlanDescription" class="form-label"></label>
                                    <textarea asp-for="NewPlan.PlanDescription" class="form-control"></textarea>
                                </div>
                            </div>

                            <!-- Features -->
                            <div class="row mb-3">
                                <div class="col-12">
                                    <label asp-for="NewPlan.PlanFeatures" class="form-label"></label>
                                    <textarea asp-for="NewPlan.PlanFeatures" class="form-control"></textarea>
                                </div>
                            </div>

                            <!-- Most Popular -->
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input asp-for="NewPlan.IsMostPopular" class="form-check-input" type="checkbox" />
                                        <label class="form-check-label" asp-for="NewPlan.IsMostPopular"></label>
                                    </div>
                                </div>
                            </div>

                            <!-- Buttons -->
                            <button type="submit" class="btn btn-primary">@(!isEdit ? "Add Plan" : "Update Plan")</button>
                            <a asp-action="AdminPricingPlans" asp-route-id="0" class="btn btn-secondary ms-2">Clear</a>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
