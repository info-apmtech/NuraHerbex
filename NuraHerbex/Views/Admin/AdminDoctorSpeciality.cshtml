@model Domain.ViewModel.DoctorSpecialityViewModel

@{
    var isEdit = Model.NewSpeciality.Id > 0;
    ViewData["Title"] = "Doctor Speciality Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">

        <div class="row heading-bg mb-3">
            <div class="col-12">
                <h4>Doctor Specialities</h4>
            </div>
        </div>

        <ul class="nav nav-tabs mb-3" id="specialityTab" role="tablist">
            <li class="nav-item">
                <a class="nav-link text-uppercase @(isEdit ? "" : "active")" id="speciality-list-tab" data-toggle="tab" href="#speciality-list" role="tab">List</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-uppercase @(isEdit ? "active" : "")" id="add-speciality-tab" data-toggle="tab" href="#add-speciality" role="tab">
                    @(!isEdit ? "Add Speciality" : "Edit Speciality")
                </a>
            </li>
        </ul>

        <div class="tab-content" id="specialityTabContent">

            <!-- List -->
            <div class="tab-pane fade @(isEdit ? "" : "show active")" id="speciality-list" role="tabpanel">
                <div class="card shadow-sm">
                    <div class="card-header bg-white border-bottom-0">
                        <h5 class="mb-0">Speciality List</h5>
                    </div>
                    <div class="card-body p-3">
                        <table class="table table-bordered table-striped mb-0 w-100">
                            <thead class="table-dark">
                                <tr>
                                    <th>#</th>
                                    <th>Name</th>
                                    <th>Status</th>
                                    <th>Created At</th>
                                    <th style="min-width: 160px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.SpecialityList.Any())
                                {
                                    int sno = 1;
                                    foreach (var item in Model.SpecialityList)
                                    {
                                        <tr>
                                            <td>@sno</td>
                                            <td>@item.Name</td>
                                            <td>
                                                <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                                    @(item.IsActive ? "Active" : "Inactive")
                                                </span>
                                            </td>
                                            <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>
                                            <td>
                                                <form method="get" asp-action="AdminDoctorSpeciality" asp-route-id="@item.Id" style="display:inline;">
                                                    <button type="submit" class="btn btn-sm btn-warning">Edit</button>
                                                </form>

                                                <form method="post" asp-action="DeleteDoctorSpeciality" asp-route-id="@item.Id" style="display:inline" onsubmit="return confirm('Are you sure you want to delete this speciality?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                        sno++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center">No specialities found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Add / Edit Form -->
            <div class="tab-pane fade @(isEdit ? "show active" : "")" id="add-speciality" role="tabpanel">
                <div class="card shadow-sm">
                    <div class="card-header bg-white border-bottom-0">
                        <h5 class="mb-0">@(!isEdit ? "Add New Speciality" : "Edit Speciality")</h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="AdminDoctorSpeciality" asp-controller="Admin" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="NewSpeciality.Id" />

                            <div class="mb-3">
                                <label asp-for="NewSpeciality.Name" class="form-label"></label>
                                <input asp-for="NewSpeciality.Name" class="form-control" required />
                                <span asp-validation-for="NewSpeciality.Name" class="text-danger"></span>
                            </div>

                            <div class="mb-3 form-check">
                                <input asp-for="NewSpeciality.IsActive" class="form-check-input" />
                                <label asp-for="NewSpeciality.IsActive" class="form-check-label"></label>
                            </div>

                            <button type="submit" class="btn btn-primary">@(!isEdit ? "Add Speciality" : "Update Speciality")</button>
                            <a asp-action="AdminDoctorSpeciality" asp-route-id="0" class="btn btn-secondary ms-2">Clear</a>
                        </form>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>
