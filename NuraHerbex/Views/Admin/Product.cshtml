@using Domain.Models
@model Domain.ViewModel.ProductViewModel

@{
    var isEdit = Model.NewProduct.Id > 0;
    var activeTab = TempData["ActiveTab"]?.ToString() ?? (isEdit ? "newproduct" : "list");
    ViewData["Title"] = "Product Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">

        <!-- Page Heading -->
        <div class="row heading-bg mb-3">
            <div class="col-12">
                <h4>Product Management</h4>
            </div>
        </div>

        <!-- Tabs -->
        <ul class="nav nav-tabs mb-3" id="productTab" role="tablist">
            <li class="nav-item">
                <a class="nav-link text-uppercase @(activeTab == "list" ? "active" : "")"
                   id="list-tab" data-toggle="tab" href="#list" role="tab"
                   aria-controls="list" aria-selected="@(activeTab == "list")">
                    List
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-uppercase @(activeTab == "newproduct" ? "active" : "")"
                   id="newproduct-tab" data-toggle="tab" href="#newproduct" role="tab"
                   aria-controls="newproduct" aria-selected="@(activeTab == "newproduct")">
                    @(!isEdit ? "New Product" : "Edit Product")
                </a>
            </li>
        </ul>

        <div class="tab-content" id="productTabContent">

            <!-- Product List -->
            <div class="tab-pane fade @(activeTab == "list" ? "show active" : "")" id="list" role="tabpanel">

                <div class="card shadow-sm">
                    <div class="card-header bg-white border-bottom-0">
                        <h5 class="mb-0">Product List</h5>
                    </div>

                    <div class="card-body p-3">
                        <div class="table-responsive">

                            @* <table id="productTable" class="table table-bordered table-striped w-100"> *@
                            <table id="productTable" class="table table-bordered table-striped w-100">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Image</th>
                                        <th>Product Name</th>
                                        <th>Sub Title</th>
                                        <th>Description</th>
                                        <th>Amount</th>
                                        <th>GST</th>
                                        <th>Key Benefits</th>
                                        <th>For What</th>
                                        <th>Created At</th>
                                        <th>Discount %</th>
                                        <th style="min-width: 130px;">Actions</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (Model.ProductList.Any())
                                    {
                                        foreach (var p in Model.ProductList)
                                        {
                                            <tr>
                                                <td>
                                                    <img src="@p.ProductImages"
                                                         style="width:45px;height:45px;border-radius:6px;object-fit:cover;" />
                                                </td>
                                                <td>@p.ProductName</td>
                                                <td>@p.SubTitle</td>
                                                <td>@p.Description</td>
                                                <td>@p.Amount</td>
                                                <td>@Model.GSTDetails.FirstOrDefault(x => x.Id == p.GSTId)?.TaxName</td>
                                                <td>@p.KeyBenefits1, @p.KeyBenefits2, @p.KeyBenefits3, @p.KeyBenefits4</td>
                                                <td>@p.ForThis1, @p.ForThis2, @p.ForThis3, @p.ForThis4</td>
                                                <td>@p.CreatedAt?.ToString("dd MMM yyyy")</td>
                                                <td>@p.DiscountPercentage</td>

                                                <td>
                                                    <form method="get" asp-action="Product" asp-route-id="@p.Id" class="d-inline">
                                                        <button type="submit" class="btn btn-warning btn-sm">Edit</button>
                                                    </form>

                                                    <form method="post" asp-action="DeleteProduct" asp-route-id="@p.Id"
                                                          onsubmit="return confirm('Are you sure you want to delete this product?');"
                                                          class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="11" class="text-center">No products found.</td>
                                        </tr>
                                    }
                                </tbody>

                            </table>

                        </div>
                    </div>
                </div>
            </div>

            <!-- Add / Edit Product -->
            <div class="tab-pane fade @(activeTab == "newproduct" ? "show active" : "")" id="newproduct" role="tabpanel">

                <div class="card shadow-sm">
                    <div class="card-header bg-white border-bottom-0">
                        <h5 class="mb-0">@(!isEdit ? "Create Product" : "Edit Product")</h5>
                    </div>

                    <div class="card-body">
                        <form asp-action="Product" asp-controller="Admin" method="post" enctype="multipart/form-data">

                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="NewProduct.Id" />
                            <input type="hidden" asp-for="NewProduct.CreatedBy" />
                            <input type="hidden" asp-for="NewProduct.UpdatedBy" />

                            <!-- Basic Details -->
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label asp-for="NewProduct.ProductName"></label>
                                    <input asp-for="NewProduct.ProductName" class="form-control" required />
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="NewProduct.SubTitle"></label>
                                    <input asp-for="NewProduct.SubTitle" class="form-control" required />
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="NewProduct.Amount"></label>
                                    <input asp-for="NewProduct.Amount" type="number" step="0.01" class="form-control" required />
                                </div>
                            </div>

                            <!-- Description + GST -->
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label asp-for="NewProduct.Description"></label>
                                    <input asp-for="NewProduct.Description" class="form-control" required />
                                </div>

                                <div class="col-md-4">
                                    <label>GST</label>
                                    <select asp-for="NewProduct.GSTId" class="form-control"
                                            asp-items="@(new SelectList(Model.GSTDetails ?? new List<GST>(), "Id", "TaxName", Model.NewProduct.GSTId))">
                                        <option value="">Select GST</option>
                                    </select>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="NewProduct.DiscountPercentage">Discount %</label>
                                    <input asp-for="NewProduct.DiscountPercentage" class="form-control" step="0.01" />
                                </div>
                            </div>

                            <!-- Images + Display Order -->
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label>Product Images</label>
                                    <input asp-for="ProductFiles" type="file" class="form-control" multiple />

                                    @if (!string.IsNullOrEmpty(Model.NewProduct.ProductImages))
                                    {
                                        <img src="@Model.NewProduct.ProductImages"
                                             class="img-fluid mt-2"
                                             style="max-height: 150px; border-radius:6px;" />
                                    }
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="NewProduct.DisplayOrder">Display Order</label>
                                    <input asp-for="NewProduct.DisplayOrder" class="form-control" />
                                </div>
                            </div>

                            <!-- Key Benefits -->
                            <h5 class="mt-4"><i class="feather icon-align-justify"></i> Key Benefits</h5>
                            <hr />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label>Benefit 1</label>
                                    <input asp-for="NewProduct.KeyBenefits1" class="form-control" required />
                                </div>

                                <div class="col-md-6">
                                    <label>Benefit 2</label>
                                    <input asp-for="NewProduct.KeyBenefits2" class="form-control" />
                                </div>

                                <div class="col-md-6">
                                    <label>Benefit 3</label>
                                    <input asp-for="NewProduct.KeyBenefits3" class="form-control" />
                                </div>

                                <div class="col-md-6">
                                    <label>Benefit 4</label>
                                    <input asp-for="NewProduct.KeyBenefits4" class="form-control" />
                                </div>
                            </div>

                            <!-- Who Is This For -->
                            <h5 class="mt-4"><i class="feather icon-file-text"></i> Who is this for?</h5>
                            <hr />

                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label>For This 1</label>
                                    <input asp-for="NewProduct.ForThis1" class="form-control" required />
                                </div>

                                <div class="col-md-6">
                                    <label>For This 2</label>
                                    <input asp-for="NewProduct.ForThis2" class="form-control" />
                                </div>

                                <div class="col-md-6">
                                    <label>For This 3</label>
                                    <input asp-for="NewProduct.ForThis3" class="form-control" />
                                </div>

                                <div class="col-md-6">
                                    <label>For This 4</label>
                                    <input asp-for="NewProduct.ForThis4" class="form-control" />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                @(!isEdit ? "Create" : "Update")
                            </button>

                        </form>
                    </div>
                </div>

            </div>

        </div> <!-- tab-content -->

    </div>
</div>
