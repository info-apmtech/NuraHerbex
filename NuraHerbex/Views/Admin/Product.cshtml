@using Domain.Models
@model Domain.ViewModel.ProductViewModel
@{
    var isEdit = Model.NewProduct.Id > 0;
    var activeTab = TempData["ActiveTab"]?.ToString() ?? (isEdit ? "newproduct" : "list");
    ViewData["Title"] = "Product Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">
        <div class="d-flex flex-column align-items-center" style="min-height: 90vh;">
            <div class="w-100">
                <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
                    <h4 class="mb-0">Product Management</h4>
                </div>

                <ul class="nav nav-tabs mb-3" id="productTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link text-uppercase @(activeTab == "list" ? "active" : "")"
                           id="list-tab"
                           data-toggle="tab"
                           href="#list"
                           role="tab"
                           aria-controls="list"
                           aria-selected="@(activeTab == "list" ? "true" : "false")">
                            List
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase @(activeTab == "newproduct" ? "active" : "")"
                           id="newproduct-tab"
                           data-toggle="tab"
                           href="#newproduct"
                           role="tab"
                           aria-controls="newproduct"
                           aria-selected="@(activeTab == "newproduct" ? "true" : "false")">
                            @(!isEdit ? "New Product" : "Edit Product")
                        </a>
                    </li>
                </ul>

                <div class="tab-content" id="productTabContent">

                    <!-- Product List Tab -->
                    <div class="tab-pane fade @(activeTab == "list" ? "show active" : "")"
                         id="list"
                         role="tabpanel"
                         aria-labelledby="list-tab">
                        <div class="card shadow-sm">
                            <div class="card-header bg-white border-bottom-0">
                                <h5 class="mb-0">Product List</h5>
                            </div>
                            <div class="card-body p-3">
                                <div class="table-responsive">
                                    <table id="productTable" class="table table-striped table-bordered mb-0 w-100">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>Product Name</th>
                                                <th>Sub Title</th>
                                                <th>Description</th>
                                                <th>Amount</th>
                                                <th>GST</th>
                                                <th>Key Benfit</th>
                                                <th>For What</th>
                                                <th>Created At</th>
                                                <th>Discount %</th>
                                                <th style="min-width:120px;">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.ProductList.Any())
                                            {
                                                foreach (var Product in Model.ProductList)
                                                {
                                                    <tr>
                                                        <td>
                                                            <img src="@Product.ProductImages" alt="Image" style="width:40px;height:40px;border-radius:6px;" />
                                                        </td>
                                                        <td>@Product.ProductName</td>
                                                        <td>@Product.SubTitle</td>
                                                        <td>@Product.Description</td>
                                                        <td>@Product.Amount</td>
                                                        <td>
                                                            @Model.GSTDetails.FirstOrDefault(c => c.Id == Product.GSTId)?.TaxName
                                                        </td>
                                                        <td>@Product.KeyBenefits1,@Product.KeyBenefits2,@Product.KeyBenefits3,@Product.KeyBenefits4</td>
                                                        <td>@Product.ForThis1,@Product.ForThis2,@Product.ForThis3,@Product.ForThis4</td>
                                                       
                                                        <td>@Product.CreatedAt?.ToString("dd MMM yyyy")</td>
                                                        <td>@Product.DiscountPercentage</td>
                                                        <td>
                                                            <form method="get" asp-action="Product" asp-route-id="@Product.Id" style="display:inline;">
                                                                <button type="submit" class="btn btn-sm btn-warning">Edit</button>
                                                            </form>

                                                            <form method="post" asp-action="DeleteProduct" asp-route-id="@Product.Id"
                                                                  onsubmit="return confirm('Are you sure you want to delete this product?');"
                                                                  style="display:inline;">
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="9" class="text-center">No products found.</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- New / Edit Product Tab -->
                    <div class="tab-pane fade @(activeTab == "newproduct" ? "show active" : "")"
                         id="newproduct"
                         role="tabpanel"
                         aria-labelledby="newproduct-tab">
                        <div class="card shadow-sm">
                            <div class="card-header bg-white border-bottom-0">
                                <h5 class="mb-0">@(!isEdit ? "Create Product" : "Edit Product")</h5>
                            </div>
                            <div class="card-body">
                                <form asp-action="Product" asp-controller="Admin" method="post" enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" asp-for="NewProduct.Id" />
                                    <input type="hidden" asp-for="NewProduct.CreatedBy" />
                                    <input type="hidden" asp-for="NewProduct.UpdatedBy" />

                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <label asp-for="NewProduct.ProductName"></label>
                                            <input type="text" asp-for="NewProduct.ProductName" class="form-control" required />
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="NewProduct.SubTitle"></label>
                                            <input type="text" asp-for="NewProduct.SubTitle" class="form-control" required />
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="NewProduct.Amount"></label>
                                            <input type="number" asp-for="NewProduct.Amount" class="form-control" step="0.01" required />
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <label asp-for="NewProduct.Description"></label>
                                            <input type="text" asp-for="NewProduct.Description" class="form-control" required />
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="NewProduct.GSTId">GST</label>
                                            <select asp-for="NewProduct.GSTId" class="form-control"
                                                    asp-items="@(Model.GSTDetails != null && Model.GSTDetails.Any() ? new SelectList(Model.GSTDetails, "Id", "TaxName", Model.NewProduct.GSTId) : new SelectList(Enumerable.Empty<GST>()))">
                                                <option value="">Select Gst</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="NewProduct.DiscountPercentage">Discount Percentage</label>
                                            <input type="number" asp-for="NewProduct.DiscountPercentage" class="form-control" step="0.01" />
                                        </div>
                                        
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <label>Product Images</label>
                                            <input asp-for="ProductFiles" type="file" class="form-control" multiple />
                                            <span asp-validation-for="ProductFiles" class="text-danger"></span>

                                            @if (!string.IsNullOrEmpty(Model.NewProduct.ProductImages))
                                            {
                                                <img src="@Model.NewProduct.ProductImages" alt="Product Image" class="img-fluid mt-2" style="max-height: 150px;" />
                                            }

                                            <span asp-validation-for="NewProduct.ProductImages" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="NewProduct.DisplayOrder"> Display Order</label>
                                            <input type="text" asp-for="NewProduct.DisplayOrder" class="form-control" step="0.01" />
                                        </div>
                                    </div>
                                    <h5 class="mt-5"><i class="feather icon-align-justify"></i>&nbsp;&nbsp; Key Benefits</h5>
                                    <hr>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="NewProduct.KeyBenefits1" class="form-label">Benefit 1</label>
                                            <input asp-for="NewProduct.KeyBenefits1" class="form-control" required />
                                            <span class="form-text">Format: Heading | Description</span>
                                            <span asp-validation-for="NewProduct.KeyBenefits1" class="text-danger"></span>
                                        </div>

                                        <!-- copy for 2..4 as needed -->
                                        <div class="col-md-6">
                                            <label asp-for="NewProduct.KeyBenefits2" class="form-label">Benefit 2</label>
                                            <input asp-for="NewProduct.KeyBenefits2" class="form-control"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="NewProduct.KeyBenefits3" class="form-label">Benefit 3</label>
                                            <input asp-for="NewProduct.KeyBenefits3" class="form-control"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="NewProduct.KeyBenefits4" class="form-label">Benefit 4</label>
                                            <input asp-for="NewProduct.KeyBenefits4" class="form-control" />
                                        </div>
                                    </div>
                                    <h5 class="mt-5"><i class="feather icon-file-text"></i> &nbsp;&nbsp;Who is this For </h5>
                                    <hr>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="NewProduct.ForThis1" class="form-label"></label>
                                            <input asp-for="NewProduct.ForThis1" class="form-control" required />
                                            <span class="form-text">Format: Heading | Description</span>
                                            <span asp-validation-for="NewProduct.ForThis1" class="text-danger"></span>
                                        </div>

                                        <!-- copy for 2..4 as needed -->
                                        <div class="col-md-6">
                                            <label asp-for="NewProduct.ForThis2" class="form-label"></label>
                                            <input asp-for="NewProduct.ForThis2" class="form-control" />
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="NewProduct.ForThis3" class="form-label"></label>
                                            <input asp-for="NewProduct.ForThis3" class="form-control" />
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="NewProduct.ForThis4" class="form-label"></label>
                                            <input asp-for="NewProduct.ForThis4" class="form-control"/>
                                        </div>
                                    </div>

                                    <button type="submit" class="btn btn-primary">
                                        @(!isEdit ? "Create" : "Update")
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                </div> <!-- End tab-content -->
            </div>
        </div>
    </div>
</div>
