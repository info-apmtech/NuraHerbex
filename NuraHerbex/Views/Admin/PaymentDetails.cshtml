@model Domain.ViewModel.PaymentGatewayViewModel

@{
    ViewData["Title"] = "Payment Gateway";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">

        <!-- Page Header -->
        <div class="row heading-bg mb-3">
            <div class="col-12">
                <h4>Payment Gateway</h4>
            </div>
        </div>

        <!-- Payment Gateway List -->
        <div class="card shadow-sm">
            <div class="card-header bg-white border-bottom-0">
                <h5 class="mb-0">Payment Gateway List</h5>
            </div>

            <div class="card-body p-3">
                <div class="table-responsive">

                    <table class="table table-bordered table-striped w-100">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Payment ID</th>
                                <th>Bank RRN</th>
                                <th>Order ID</th>
                                <th>Payment Method</th>
                                <th>Payment Details</th>
                                <th>Total Amount</th>
                                <th>Contact No</th>
                                <th>Email Address</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.PaymentGatewayList.Any())
                            {
                                var sn = 1;
                                foreach (var pay in Model.PaymentGatewayList)
                                {
                                    <tr>
                                        <td>@sn</td>
                                        <td>@pay.PaymentId</td>
                                        <td>@pay.BankRRn</td>
                                        <td>@pay.OrderId</td>
                                        <td>@pay.PaymentMethod</td>
                                        <td>@pay.PaymentDetails</td>
                                        <td>@pay.TotalAmount</td>
                                        <td>@pay.ContactNo</td>
                                        <td>@pay.EmailAddress</td>
                                    </tr>

                                    sn++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center">No payment records found.</td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        </div>

    </div>
</div>
