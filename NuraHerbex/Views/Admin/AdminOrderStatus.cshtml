@model Domain.ViewModel.OrderListViewModel
@using Domain.Models

@{
    ViewData["Title"] = "Order Status Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">
        <div class="row heading-bg mb-3">
            <div class="col-12">
                <h4>Update Order Status</h4>
            </div>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="card shadow-sm">
            <div class="card-header bg-white border-bottom-0">
                <h5 class="mb-0">Orders Status List</h5>
            </div>
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table id="nuradataTable" class="table table-bordered table-striped w-100 align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Order ID</th>
                                <th>User Name</th>
                                <th>Order Date</th>
                                <th>Status</th>
                                <th style="min-width: 220px;">Change Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Orders.Any())
                            {
                                int index = 1;
                                foreach (var order in Model.Orders)
                                {
                                    <tr>
                                        <td>@index</td>
                                        <td>
                                            <a href="@Url.Action("AdminOrderDetails", "Admin", new { orderId = order.Id })" class="text-decoration-none">
                                                @order.Id
                                            </a>
                                        </td>
                                        <td>@order.UserId</td>
                                        <td>@order.OrderDate.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")</td>
                                        <td>@order.Status</td>
                                        <td>
                                            <form asp-action="UpdateOrderStatus" method="post" class="d-flex align-items-center">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="orderId" value="@order.Id" />
                                                <select name="status" class="form-control form-control-sm me-2">
                                                    @foreach (OrderStatus s in Enum.GetValues(typeof(OrderStatus)))
                                                    {
                                                        if (s != OrderStatus.Cancelled)
                                                        {
                                                            <option value="@s" selected="@(order.Status == s ? "selected" : null)">@s</option>
                                                        }
                                                    }
                                                </select>
                                                <button type="submit" class="btn btn-primary btn-sm">Update</button>
                                            </form>
                                        </td>
                                    </tr>
                                    index++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center">No orders found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
