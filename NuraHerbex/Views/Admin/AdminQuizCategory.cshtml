@model Domain.ViewModel.QuizCategoryViewModel

@{
    var isEdit = Model.NewCategory.Id > 0;
    ViewData["Title"] = "Quiz Category Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">

        <div class="row heading-bg mb-3">
            <div class="col-12">
                <h4>Quiz Categories</h4>
            </div>
        </div>

        <ul class="nav nav-tabs mb-3" id="quizTab" role="tablist">
            <li class="nav-item">
                <a class="nav-link text-uppercase @(isEdit ? "" : "active")"
                   data-toggle="tab" href="#list">List</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-uppercase @(isEdit ? "active" : "")"
                   data-toggle="tab" href="#add">@(!isEdit ? "Add Category" : "Edit Category")</a>
            </li>
        </ul>

        <div class="tab-content">

            <!-- List -->
            <div class="tab-pane fade @(isEdit ? "" : "show active")" id="list">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Category List</h5>
                    </div>
                    <div class="card-body p-3">
                        <table class="table table-bordered table-striped w-100">
                            <thead class="table-dark">
                                <tr>
                                    <th>#</th>
                                    <th>Name</th>
                                    <th>Status</th>
                                    <th>Created At</th>
                                    <th style="min-width:160px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.CategoryList != null && Model.CategoryList.Any())
                                {
                                    int i = 1;
                                    foreach (var item in Model.CategoryList)
                                    {
                                        <tr>
                                            <td>@i</td>
                                            <td>@item.Name</td>
                                            <td>
                                                <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                                    @(item.IsActive ? "Active" : "Inactive")
                                                </span>
                                            </td>
                                            <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>
                                            <td>
                                                <form method="get" asp-action="AdminQuizCategory" asp-route-id="@item.Id" style="display:inline;">
                                                    <button class="btn btn-sm btn-warning">Edit</button>
                                                </form>

                                                <form method="post" asp-action="DeleteQuizCategory" asp-route-id="@item.Id"
                                                      onsubmit="return confirm('Delete this category?');" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <button class="btn btn-sm btn-danger">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                        i++;
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="5" class="text-center">No categories found</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Add/Edit Form -->
            <div class="tab-pane fade @(isEdit ? "show active" : "")" id="add">
                <div class="card">
                    <div class="card-header bg-white">
                        <h5>@(!isEdit ? "Add New Category" : "Edit Category")</h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="AdminQuizCategory" method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="NewCategory.Id" />

                            <div class="mb-3">
                                <label asp-for="NewCategory.Name"></label>
                                <input asp-for="NewCategory.Name" class="form-control" required />
                            </div>

                            <div class="mb-3 form-check">
                                <input asp-for="NewCategory.IsActive" class="form-check-input" />
                                <label asp-for="NewCategory.IsActive" class="form-check-label"></label>
                            </div>

                            <button class="btn btn-primary">@(!isEdit ? "Add Category" : "Update Category")</button>
                            <a asp-action="AdminQuizCategory" class="btn btn-secondary ms-2">Clear</a>
                        </form>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>
