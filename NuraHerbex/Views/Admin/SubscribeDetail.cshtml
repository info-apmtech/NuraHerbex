@model Domain.ViewModel.SubscriptionViewModel

@{
    ViewData["Title"] = "Subscription";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">

        <!-- Page Header -->
        <div class="row heading-bg mb-3">
            <div class="col-12">
                <h4>Subscription</h4>
            </div>
        </div>

        <!-- Subscription List Card -->
        <div class="card shadow-sm">
            <div class="card-header bg-white border-bottom-0">
                <h5 class="mb-0">Subscription List</h5>
            </div>

            <div class="card-body p-3">
                <div class="table-responsive">

                    <table id="nuradataTable" class="table table-bordered table-striped w-100">
                        <thead class="table-dark">
                            <tr>
                                <th style="width:70px;">#</th>
                                <th>Email</th>
                                <th>Subscribed At</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.SubscriptionList.Any())
                            {
                                var sn = 1;
                                foreach (var sub in Model.SubscriptionList)
                                {
                                    <tr>
                                        <td>@sn</td>
                                        <td>@sub.Email</td>
                                        <td>@sub.SubscribedAt.ToString("dd MMM yyyy")</td>
                                    </tr>

                                    sn++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center">No subscriptions found.</td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        </div>

    </div>
</div>
