@model Domain.ViewModel.SubscriptionViewModel

@{
    ViewData["Title"] = "Subscription";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="pcoded-main-container">
    <div class="pcoded-content">
        <div class="d-flex flex-column align-items-center" style="min-height: 90vh;">
            <div class="w-100">
                <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
                    <h4 class="mb-0">Subscription</h4>
                </div>
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <h5>Subscription List</h5>
                            @* <span class="d-block m-t-5">use class <code>table-hover</code> inside table element</span> *@
                        </div>
                        <div class="card-body table-border-style">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Email Id</th>
                                            <th> SubscribedAt</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.SubscriptionList.Any())
                                        {
                                            int sno = 1;
                                            foreach (var Product in Model.SubscriptionList)
                                            {
                                                <tr>
                                                    <td>@sno</td>
                                                    @{
                                                        sno += 1;
                                                    }
                                                    <td>@Product.Email</td>
                                                    <td>@Product.SubscribedAt.ToString("dd-MM-yyyy")</td>

                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="9" class="text-center">No products found.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div> <!-- End tab-content -->
        </div>
    </div>
</div>

