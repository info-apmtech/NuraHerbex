@model Domain.ViewModel.TrackOrderViewModel

@{
    ViewData["Title"] = "Order Details - Admin";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">

        <div class="row heading-bg mb-3">
            <div class="col-12">
                <h4>
                    Order Details - @Model.Order.Id
                </h4>
            </div>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }
        else if (Model.Order != null)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <p><strong>User:</strong> @Model.Order.UserId</p>
                    <p><strong>Order Date:</strong> @Model.Order.OrderDate.ToLocalTime().ToString("dd MMM, yyyy - hh:mm tt")</p>
                    <p><strong>Status:</strong> @Model.Order.Status.ToString()</p>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-white border-bottom-0">
                    <h5 class="mb-0">Order Items</h5>
                </div>
                <div class="card-body p-3">
                    @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                    {
                        <table class="table table-bordered table-striped w-100">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Quantity</th>
                                    <th>Unit Price</th>
                                    <th>Total Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detail in Model.OrderDetails)
                                {
                                    <tr>
                                        <td>@(detail.productName ?? "N/A")</td>
                                        <td>@detail.Quantity</td>
                                        <td>@detail.UnitPrice.ToString("C", new System.Globalization.CultureInfo("hi-IN"))</td>
                                        <td>@((detail.Quantity * detail.UnitPrice).ToString("C", new System.Globalization.CultureInfo("hi-IN")))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No products found for this order.</p>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5>Summary</h5>
                    <p><strong>Subtotal:</strong> @Model.Order.Subtotal.ToString("C", new System.Globalization.CultureInfo("hi-IN"))</p>
                    <p><strong>Shipping:</strong> @Model.Order.Shipping.ToString("C", new System.Globalization.CultureInfo("hi-IN"))</p>
                    <p><strong>Total Discount:</strong> @Model.Order.TotalDiscount.ToString("C", new System.Globalization.CultureInfo("hi-IN"))</p>
                    <p><strong>Total:</strong> @Model.Order.Total.ToString("C", new System.Globalization.CultureInfo("hi-IN"))</p>

                    <a href="@Url.Action("AdminOrderStatus", "Admin")" class="btn btn-secondary mt-3">Back to Orders</a>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">Order details not available.</div>
        }
    </div>
</div>
