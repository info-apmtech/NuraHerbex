@using Domain.Models
@model Domain.ViewModel.RegisterUserViewModel

@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">
        <div class="d-flex flex-column align-items-center" style="min-height: 90vh;">
            <div class="w-100" style="max-width: 1100px;">
                <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
                    <h4 class="mb-0">User Management</h4>
                </div>

                <ul class="nav nav-tabs mb-3" id="userTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active text-uppercase" id="list-tab" data-toggle="tab" href="#list" role="tab" aria-controls="list" aria-selected="true">List</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase" id="newuser-tab" data-toggle="tab" href="#newuser" role="tab" aria-controls="newuser" aria-selected="false">New User</a>
                    </li>
                </ul>

                <div class="tab-content" id="userTabContent">
                    <!-- User List Tab -->
                    <div class="tab-pane fade show active" id="list" role="tabpanel" aria-labelledby="list-tab">
                        <div class="card shadow-sm">
                            <div class="card-header bg-white border-bottom-0">
                                <h5 class="mb-0">User List</h5>
                            </div>
                            <div class="card-body p-3">
                                <div class="table-responsive">
                                    <table id="userTable" class="table table-striped table-bordered mb-0 w-100">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>USERNAME</th>
                                                <th>EMAIL</th>
                                                <th>ROLE</th>
                                                <th style="min-width:120px;">ACTIONS</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model?.UserList?.Any() == true)
                                            {
                                                int index = 1;
                                                foreach (var user in Model.UserList)
                                                {
                                                    <tr>
                                                        <td>@index</td>
                                                        <td>@user.UserName</td>
                                                        <td>@user.Email</td>
                                                        <td>@user.Role.ToString()</td>
                                                        <td>
                                                            <a asp-controller="Admin" asp-action="UserCreation" asp-route-id="@user.Id" class="btn btn-sm btn-info" data-toggle="tooltip" title="Edit user">Edit</a>

                                                            <form asp-controller="Admin" asp-action="DeleteUser" asp-route-id="@user.Id" method="post" style="display:inline;">
                                                                <button type="submit" class="btn btn-sm btn-danger" data-toggle="tooltip" title="Delete user" onclick="return confirm('Are you sure you want to delete this user?');">Delete</button>
                                                            </form>
                                                        </td>

                                                    </tr>
                                                    index++;
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="5" class="text-center">No users found.</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- New User Tab -->
                    <div class="tab-pane fade" id="newuser" role="tabpanel" aria-labelledby="newuser-tab">
                        <div class="card shadow-sm">
                            <div class="card-header bg-white border-bottom-0">
                                <h5 class="mb-0">Create User</h5>
                            </div>
                            <div class="card-body">
                                <form asp-controller="Admin" asp-action="UserCreation" method="post" novalidate>
                                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <label asp-for="RegisteredUser.FirstName"></label>
                                            <input asp-for="RegisteredUser.FirstName" class="form-control" />
                                            <span asp-validation-for="RegisteredUser.FirstName" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="RegisteredUser.LastName"></label>
                                            <input asp-for="RegisteredUser.LastName" class="form-control" />
                                            <span asp-validation-for="RegisteredUser.LastName" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="RegisteredUser.UserName"></label>
                                            <input asp-for="RegisteredUser.UserName" class="form-control" />
                                            <span asp-validation-for="RegisteredUser.UserName" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <label asp-for="RegisteredUser.Email"></label>
                                            <input asp-for="RegisteredUser.Email" class="form-control" type="email" />
                                            <span asp-validation-for="RegisteredUser.Email" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="RegisteredUser.PhoneNumber"></label>
                                            <input asp-for="RegisteredUser.PhoneNumber" class="form-control" type="tel" />
                                            <span asp-validation-for="RegisteredUser.PhoneNumber" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="RegisteredUser.Role"></label>
                                            <select asp-for="RegisteredUser.Role" asp-items="Html.GetEnumSelectList<UserRole>()" class="form-control">
                                                <option value="">Select Role</option>
                                            </select>
                                            <span asp-validation-for="RegisteredUser.Role" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <label asp-for="RegisteredUser.Password"></label>
                                            <input asp-for="RegisteredUser.Password" class="form-control" type="password" />
                                            <span asp-validation-for="RegisteredUser.Password" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="RegisteredUser.NMConfirmPassword"></label>
                                            <input asp-for="RegisteredUser.NMConfirmPassword" class="form-control" type="password" />
                                            <span asp-validation-for="RegisteredUser.NMConfirmPassword" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="RegisteredUser.Address"></label>
                                            <textarea asp-for="RegisteredUser.Address" class="form-control" rows="2"></textarea>
                                            <span asp-validation-for="RegisteredUser.Address" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <button type="submit" class="btn btn-primary">
                                        @(Model.RegisteredUser != null && !string.IsNullOrEmpty(Model.RegisteredUser.Id) ? "Update User" : "Create User")
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


