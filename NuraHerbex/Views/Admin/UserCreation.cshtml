@using Domain.Models
@model Domain.ViewModel.RegisterUserViewModel

@{
    var isEdit = Model.RegisteredUser != null && !string.IsNullOrEmpty(Model.RegisteredUser.Id);
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">

        <div class="row heading-bg mb-3">
            <div class="col-12">
                <h4>User Management</h4>
            </div>
        </div>

        <!-- Tabs -->
        <ul class="nav nav-tabs mb-3" id="userTab" role="tablist">
            <li class="nav-item">
                <a class="nav-link text-uppercase @(isEdit ? "" : "active")"
                   id="user-list-tab"
                   data-toggle="tab"
                   href="#user-list"
                   role="tab"
                   aria-controls="user-list"
                   aria-selected="@(isEdit ? "false" : "true")">
                    List
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-uppercase @(isEdit ? "active" : "")"
                   id="add-user-tab"
                   data-toggle="tab"
                   href="#add-user"
                   role="tab"
                   aria-controls="add-user"
                   aria-selected="@(isEdit ? "true" : "false")">
                    @(isEdit ? "Edit User" : "Add User")
                </a>
            </li>
        </ul>

        <div class="tab-content" id="userTabContent">

            <!-- ===========================
                 USER LIST
            ============================ -->
            <div class="tab-pane fade @(isEdit ? "" : "show active")"
                 id="user-list"
                 role="tabpanel"
                 aria-labelledby="user-list-tab">

                <div class="card shadow-sm">
                    <div class="card-header bg-white border-bottom-0">
                        <h5 class="mb-0">User List</h5>
                    </div>

                    <div class="card-body p-3">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped mb-0 w-100">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>Username</th>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th style="min-width:160px;">Actions</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (Model?.UserList?.Any() == true)
                                    {
                                        int sno = 1;
                                        foreach (var user in Model.UserList)
                                        {
                                            <tr>
                                                <td>@sno</td>
                                                <td>@user.UserName</td>
                                                <td>@user.Email</td>
                                                <td>@user.Role.ToString()</td>

                                                <td>
                                                    <form asp-action="ToggleActive" asp-controller="Admin" asp-route-id="@user.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to change this user status?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm @(user.isActive ? "btn-secondary" : "btn-success")">
                                                            @(user.isActive ? "Inactive" : "Active")
                                                        </button>
                                                    </form>
                                                    <a asp-action="UserCreation" asp-controller="Admin" asp-route-id="@user.Id" class="btn btn-sm btn-warning">
                                                        Edit
                                                    </a>
                                                    <form asp-action="DeleteUser" asp-controller="Admin" asp-route-id="@user.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-danger">
                                                            Delete
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>

                                            sno++;
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center">No users found</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ===========================
                 ADD / EDIT USER
            ============================ -->
            <div class="tab-pane fade @(isEdit ? "show active" : "")"
                 id="add-user"
                 role="tabpanel"
                 aria-labelledby="add-user-tab">

                <div class="card shadow-sm">
                    <div class="card-header bg-white border-bottom-0">
                        <h5 class="mb-0">@(!isEdit ? "Add New User" : "Edit User")</h5>
                    </div>

                    <div class="card-body">
                        <form asp-action="UserCreation" asp-controller="Admin" method="post" novalidate autocomplete="off">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            <!-- 🔹 Always send Id; empty for Add, filled for Edit -->
                            <input asp-for="RegisteredUser.Id" type="hidden" />

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label asp-for="RegisteredUser.FirstName" class="form-label"></label>
                                    <input asp-for="RegisteredUser.FirstName" class="form-control" />
                                    <span asp-validation-for="RegisteredUser.FirstName" class="text-danger"></span>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label asp-for="RegisteredUser.LastName" class="form-label"></label>
                                    <input asp-for="RegisteredUser.LastName" class="form-control" />
                                    <span asp-validation-for="RegisteredUser.LastName" class="text-danger"></span>
                                </div>

                              @*   <div class="col-md-4 mb-3">
                                    <label asp-for="RegisteredUser.UserName" class="form-label"></label>
                                    <input asp-for="RegisteredUser.UserName" class="form-control" autocomplete="off" />
                                    <span asp-validation-for="RegisteredUser.UserName" class="text-danger"></span>
                                </div> *@

                                <div class="col-md-4 mb-3">
                                    <label asp-for="RegisteredUser.Email" class="form-label"></label>
                                    <input asp-for="RegisteredUser.Email" class="form-control" type="email" />
                                    <span asp-validation-for="RegisteredUser.Email" class="text-danger"></span>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label asp-for="RegisteredUser.PhoneNumber" class="form-label"></label>
                                    <input asp-for="RegisteredUser.PhoneNumber" class="form-control" />
                                    <span asp-validation-for="RegisteredUser.PhoneNumber" class="text-danger"></span>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label asp-for="RegisteredUser.Role" class="form-label"></label>
                                    <select asp-for="RegisteredUser.Role"
                                            asp-items="Html.GetEnumSelectList<UserRole>()"
                                            class="form-control">
                                        <option value="">Select Role</option>
                                    </select>
                                    <span asp-validation-for="RegisteredUser.Role" class="text-danger"></span>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label asp-for="RegisteredUser.Password" class="form-label"></label>
                                    <input asp-for="RegisteredUser.Password" class="form-control" type="password" autocomplete="new-password" />
                                    <span asp-validation-for="RegisteredUser.Password" class="text-danger"></span>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label asp-for="RegisteredUser.NMConfirmPassword" class="form-label"></label>
                                    <input asp-for="RegisteredUser.NMConfirmPassword" type="password" class="form-control" />
                                    <span asp-validation-for="RegisteredUser.NMConfirmPassword" class="text-danger"></span>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label asp-for="RegisteredUser.Address" class="form-label"></label>
                                    <textarea asp-for="RegisteredUser.Address" rows="2" class="form-control"></textarea>
                                    <span asp-validation-for="RegisteredUser.Address" class="text-danger"></span>
                                </div>

                            </div>

                            <button type="submit" class="btn btn-primary">
                                @(isEdit ? "Update User" : "Create User")
                            </button>

                            <a asp-action="UserCreation" asp-controller="Admin" class="btn btn-secondary ms-2">
                                Clear
                            </a>
                            @* asp-route-id="0" *@
                        </form>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>
