@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<div class="pcoded-main-container">
    <div class="pcoded-content">
        <div class="d-flex flex-column align-items-center" style="min-height: 90vh;">
            <div class="w-100" style="max-width: 1100px;">
                <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
                    <h4 class="mb-0">User Management</h4>
                </div>

                <ul class="nav nav-tabs mb-3" id="userTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active text-uppercase" id="list-tab" data-toggle="tab" href="#list" role="tab" aria-controls="list" aria-selected="true">List</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase" id="newuser-tab" data-toggle="tab" href="#newuser" role="tab" aria-controls="newuser" aria-selected="false">New User</a>
                    </li>
                </ul>

                <div class="tab-content" id="userTabContent">
                    <div class="tab-pane fade show active" id="list" role="tabpanel" aria-labelledby="list-tab">
                        <div class="card shadow-sm">
                            <div class="card-header bg-white border-bottom-0">
                                <h5 class="mb-0">User List</h5>
                            </div>
                            <div class="card-body p-3">
                                <div class="table-responsive">
                                    <table id="userTable" class="table table-striped table-bordered mb-0 w-100">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>USERNAME</th>
                                                <th>EMAIL</th>
                                                <th>ROLE</th>
                                                <th style="min-width:120px;">ACTIONS</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>1</td>
                                                <td>john</td>
                                                <td>john@example.com</td>
                                                <td>Admin</td>
                                                <td>
                                                    <button class="btn btn-sm btn-info" data-toggle="tooltip" title="Edit user">Edit</button>
                                                    <button class="btn btn-sm btn-danger" data-toggle="tooltip" title="Delete user">Delete</button>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>2</td>
                                                <td>jane</td>
                                                <td>jane@example.com</td>
                                                <td>User</td>
                                                <td>
                                                    <button class="btn btn-sm btn-info" data-toggle="tooltip" title="Edit user">Edit</button>
                                                    <button class="btn btn-sm btn-danger" data-toggle="tooltip" title="Delete user">Delete</button>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>3</td>
                                                <td>manager</td>
                                                <td>manager@example.com</td>
                                                <td>Manager</td>
                                                <td>
                                                    <button class="btn btn-sm btn-info" data-toggle="tooltip" title="Edit user">Edit</button>
                                                    <button class="btn btn-sm btn-danger" data-toggle="tooltip" title="Delete user">Delete</button>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="newuser" role="tabpanel" aria-labelledby="newuser-tab">
                        <div class="card shadow-sm">
                            <div class="card-header bg-white border-bottom-0">
                                <h5 class="mb-0">Create User</h5>
                            </div>
                            <div class="card-body">
                                <form method="post" action="/Admin/CreateUser">
                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <label for="UserName">User Name</label>
                                            <input type="text" id="UserName" name="UserName" class="form-control" required />
                                        </div>
                                        <div class="col-md-4">
                                            <label for="Email">Email Address</label>
                                            <input type="email" id="Email" name="Email" class="form-control" required />
                                        </div>
                                        <div class="col-md-4">
                                            <label for="PhoneNumber">Phone Number</label>
                                            <input type="tel" id="PhoneNumber" name="PhoneNumber" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <label for="Password">Password</label>
                                            <input type="password" id="Password" name="Password" class="form-control" required />
                                        </div>
                                        <div class="col-md-4">
                                            <label for="Role">Role</label>
                                            <select id="Role" name="Role" class="form-control" required>
                                                <option value="">Select Role</option>
                                                <option>Admin</option>
                                                <option>User</option>
                                                <option>Manager</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="Department">Department</label>
                                            <input type="text" id="Department" name="Department" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <label for="Address">Address</label>
                                            <textarea id="Address" name="Address" class="form-control" rows="2"></textarea>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="EmployeeId">Employee ID</label>
                                            <input type="text" id="EmployeeId" name="EmployeeId" class="form-control" />
                                        </div>
                                        <div class="col-md-4">
                                            <label for="JoiningDate">Joining Date</label>
                                            <input type="date" id="JoiningDate" name="JoiningDate" class="form-control" />
                                        </div>
                                    </div>

                                    <button type="submit" class="btn btn-primary">Create User</button>
                                </form>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


