@{
    ViewData["Title"] = "Ingredient Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">
        <div class="d-flex flex-column align-items-center" style="min-height: 90vh;">
            <div class="w-100" style="max-width: 1100px;">
                <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
                    <h4 class="mb-0">Ingredient Management</h4>
                </div>

                <ul class="nav nav-tabs mb-3" id="ingredientTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active text-uppercase" id="list-tab" data-toggle="tab" href="#list" role="tab">List</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase" id="newingredient-tab" data-toggle="tab" href="#newingredient" role="tab">Add Ingredient</a>
                    </li>
                </ul>

                <div class="tab-content" id="ingredientTabContent">
                    <!-- List Ingredients -->
                    <div class="tab-pane fade show active" id="list" role="tabpanel">
                        <div class="card shadow-sm">
                            <div class="card-header bg-white border-bottom-0">
                                <h5 class="mb-0">Ingredient List</h5>
                            </div>
                            <div class="card-body p-3">
                                <div class="table-responsive">
                                    <table class="table table-striped table-bordered w-100">
                                        <thead>
                                            <tr>
                                                <th>Image</th>
                                                <th>Name</th>
                                                <th>Scientific Name</th>
                                                <th>Benefits</th>
                                                <th>Evidence</th>
                                                <th>Created At</th>
                                                <th>Active</th>
                                                <th style="min-width:120px;">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td><img src="/uploads/ingredient1.jpg" alt="Image" style="width:40px;height:40px;border-radius:6px;"></td>
                                                <td>Curcumin</td>
                                                <td>Withania somnifera</td>
                                                <td>Anti-inflammatory benefits</td>
                                                <td>Multiple studies support use</td>
                                                <td>30 Oct 2025</td>
                                                <td><span class="badge badge-success">Active</span></td>
                                                <td>
                                                    <button class="btn btn-sm btn-warning">Edit</button>
                                                    <button class="btn btn-sm btn-danger">Delete</button>
                                                </td>
                                            </tr>
                                            <!-- End example -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Add/Edit Ingredient -->
                    <div class="tab-pane fade" id="newingredient" role="tabpanel">
                        <div class="card shadow-sm">
                            <div class="card-header bg-white border-bottom-0">
                                <h5 class="mb-0">Add Ingredient</h5>
                            </div>
                            <div class="card-body">
                                <form method="post" action="/Admin/CreateIngredient" enctype="multipart/form-data">
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label for="IngredientName">Ingredient Name</label>
                                            <input type="text" id="IngredientName" name="IngredientName" class="form-control" required />
                                        </div>
                                        <div class="col-md-6">
                                            <label for="IdealFor">Scientific Name</label>
                                            <input type="text" id="IdealFor" name="IdealFor" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label for="Benefits">Benefits</label>
                                        <input type="text" id="Benefits" name="Benefits" class="form-control" />
                                    </div>
                                    <div class="mb-3">
                                        <label for="Evidence">Scientific Evidence</label>
                                        <input type="text" id="Evidence" name="Evidence" class="form-control" />
                                    </div>
                                    <div class="mb-3">
                                        <label for="ImagePath">Image</label>
                                        <input type="file" id="ImagePath" name="ImagePath" class="form-control" />
                                    </div>
                                    <div class="form-group form-check mb-3">
                                        <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" checked>
                                        <label class="form-check-label" for="IsActive">Active</label>
                                    </div>
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
