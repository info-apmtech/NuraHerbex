@model Domain.ViewModel.AdminProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">

        <!-- Page Heading -->
        <div class="row heading-bg mb-3">
            <div class="col-12">
                <h4>My Profile</h4>
            </div>
        </div>

        <!-- Tabs -->
        <ul class="nav nav-tabs mb-3" id="adminProfileTab" role="tablist">
            <li class="nav-item">
                <a class="nav-link text-uppercase active"
                   id="profile-details-tab"
                   data-toggle="tab"
                   href="#profile-details"
                   role="tab"
                   aria-controls="profile-details"
                   aria-selected="true">
                    Profile Details
                </a>
            </li>
           @*  <li class="nav-item">
                <a class="nav-link text-uppercase"
                   id="profile-security-tab"
                   data-toggle="tab"
                   href="#profile-security"
                   role="tab"
                   aria-controls="profile-security"
                   aria-selected="false">
                    Security
                </a>
            </li> *@
        </ul>

        <div class="tab-content" id="adminProfileTabContent">

            <!-- Profile Details Tab -->
            <div class="tab-pane fade show active"
                 id="profile-details"
                 role="tabpanel"
                 aria-labelledby="profile-details-tab">

                <div class="card shadow-sm">
                    <div class="card-header bg-white border-bottom-0">
                        <h5 class="mb-0">Personal Information</h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="AdminMyProfile" asp-controller="Admin" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()

                            <input asp-for="Id" type="hidden" />

                            <!-- Profile Image preview -->
                            <div class="text-center mb-4">
                                <img src="@(string.IsNullOrWhiteSpace(Model.ProfileImagePath)
                        ? Url.Content("~/assets/images/user/avatar-1.jpg")
                        : Model.ProfileImagePath)"
                                     class="img-radius"
                                     style="width:100px; height:100px; object-fit:cover;"
                                     alt="Profile Image" />
                            </div>

                            <!-- Upload field -->
                            <div class="mb-3">
                                <label class="form-label">Profile Image</label>
                                <input asp-for="ProfileImageFile"
                                       type="file"
                                       class="form-control"
                                       accept="image/*" />
                                <span class="form-text text-muted">
                                </span>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="FirstName" class="form-label">First Name</label>
                                    <input asp-for="FirstName" class="form-control" />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="LastName" class="form-label">Last Name</label>
                                    <input asp-for="LastName" class="form-control" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Email" class="form-label">Email</label>
                                    <input asp-for="Email" class="form-control" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                                    <input asp-for="PhoneNumber" class="form-control" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                Save Changes
                            </button>
                        </form>
                    </div>
                </div>
            </div>

         @*    <!-- Security / Password Tab -->
            <div class="tab-pane fade"
                 id="profile-security"
                 role="tabpanel"
                 aria-labelledby="profile-security-tab">

                <div class="card shadow-sm">
                    <div class="card-header bg-white border-bottom-0">
                        <h5 class="mb-0">Account Security</h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-3">
                            Manage your admin account security settings, including changing your password.
                        </p>

                        <!-- You can wire this to your actual change-password page/action -->
                        <a asp-action="ChangePassword"
                           asp-controller="Admin"
                           class="btn btn-warning">
                            Change Password
                        </a>
                    </div>
                </div>

            </div> *@

        </div>

    </div>
</div>


