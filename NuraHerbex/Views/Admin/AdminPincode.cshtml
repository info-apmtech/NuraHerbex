@model Domain.ViewModel.PincodeViewModel

@{
    var isEdit = Model.NewPincode.Id > 0;
    ViewData["Title"] = "Pincode Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pcoded-main-container">
    <div class="pcoded-content">

        <div class="row heading-bg mb-3">
            <div class="col-12">
                <h4>Pincodes</h4>
            </div>
        </div>

        <ul class="nav nav-tabs mb-3" id="pincodeTab" role="tablist">
            <li class="nav-item">
                <a class="nav-link text-uppercase @(isEdit ? "" : "active")" id="pincode-list-tab" data-toggle="tab" href="#pincode-list" role="tab">List</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-uppercase @(isEdit ? "active" : "")" id="add-pincode-tab" data-toggle="tab" href="#add-pincode" role="tab">
                    @(!isEdit ? "Add Pincode" : "Edit Pincode")
                </a>
            </li>
        </ul>

        <div class="tab-content" id="pincodeTabContent">

            <!-- Pincode List -->
            <div class="tab-pane fade @(isEdit ? "" : "show active")" id="pincode-list" role="tabpanel">
                <div class="card shadow-sm">
                    <div class="card-header bg-white border-bottom-0">
                        <h5 class="mb-0">Pincode List</h5>
                    </div>
                    <div class="card-body p-3">
                        <table class="table table-bordered table-striped mb-0 w-100">
                            <thead class="table-dark">
                                <tr>
                                    <th>#</th>
                                    <th>Code</th>
                                    <th>Description</th>
                                    <th>Standard Delivery Amount</th>
                                    <th>Express Delivery Amount</th>
                                    <th>Created At</th>
                                    <th style="min-width: 160px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.PincodeList.Any())
                                {
                                    int sno = 1;
                                    foreach (var item in Model.PincodeList)
                                    {
                                        <tr>
                                            <td>@sno</td>
                                            <td>@item.Code</td>
                                            <td>@item.Description</td>
                                            <td>@item.StandardDeliveryAmount</td>
                                            <td>@item.ExpressDeliveryAmount</td>
                                            <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>
                                            <td>
                                                <form method="get" asp-action="AdminPincode" asp-route-id="@item.Id" style="display:inline;">
                                                    <button type="submit" class="btn btn-sm btn-warning">Edit</button>
                                                </form>

                                                <form method="post" asp-action="DeletePincode" asp-route-id="@item.Id" style="display:inline" onsubmit="return confirm('Are you sure you want to delete this pincode?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                        sno++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center">No pincodes found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Add / Edit Form -->
            <div class="tab-pane fade @(isEdit ? "show active" : "")" id="add-pincode" role="tabpanel">
                <div class="card shadow-sm">
                    <div class="card-header bg-white border-bottom-0">
                        <h5 class="mb-0">@(!isEdit ? "Add New Pincode" : "Edit Pincode")</h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="AdminPincode" asp-controller="Admin" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="NewPincode.Id" />

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label asp-for="NewPincode.Code" class="form-label"></label>
                                    <input asp-for="NewPincode.Code" class="form-control" required maxlength="6" minlength="6" />
                                    <span asp-validation-for="NewPincode.Code" class="text-danger"></span>
                                </div>

                                <div class="col-md-8 mb-3">
                                    <label asp-for="NewPincode.Description" class="form-label"></label>
                                    <input asp-for="NewPincode.Description" class="form-control" />
                                    <span asp-validation-for="NewPincode.Description" class="text-danger"></span>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label asp-for="NewPincode.StandardDeliveryAmount" class="form-label"></label>
                                    <input asp-for="NewPincode.StandardDeliveryAmount" type="number" step="0.01" class="form-control" />
                                    <span asp-validation-for="NewPincode.StandardDeliveryAmount" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="NewPincode.ExpressDeliveryAmount" class="form-label"></label>
                                    <input asp-for="NewPincode.ExpressDeliveryAmount" type="number" step="0.01" class="form-control" />
                                    <span asp-validation-for="NewPincode.ExpressDeliveryAmount" class="text-danger"></span>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary">@(!isEdit ? "Add Pincode" : "Update Pincode")</button>
                            <a asp-action="AdminPincode" asp-route-id="0" class="btn btn-secondary ms-2">Clear</a>
                        </form>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>
