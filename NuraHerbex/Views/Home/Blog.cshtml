@model Domain.ViewModel.BlogViewModel

@{
    ViewData["Title"] = "Blog";
}

<!-- Blog Hero Section -->
<section class="blog-hero-section">
    <div class="blog-hero-container">
        <div class="blog-hero-content">
            <h1 class="blog-hero-title">
                Insights for Men. <span class="highlight-orange">Strength for Life</span>
            </h1>
            <p class="blog-hero-description">
                Stay informed with expert articles on vitality, performance, and holistic wellness - crafted for the modern man
            </p>
        </div>
        <div class="blog-hero-image">
            <img src="~/image/blog/man-meditating-lotus-pose.png" alt="Man meditating outdoors" />
        </div>
    </div>
</section>

<!-- Featured Articles Section -->
<section class="featured-articles-section">
    <div class="featured-articles-container">
        <div class="featured-header">
            <h2 class="featured-title"><span class="highlight-orange">Featured</span> Articles</h2>
            <p class="featured-subtitle">Driving the future of men's wellness through innovation and nature</p>
        </div>

        <div class="articles-grid">
            @foreach (var blog in Model.BlogList.Where(b => b.IsFeatured))
            {
                <article onclick="location.href='@Url.Action("BlogDetail", "Home", new { id = blog.Id })'" class="article-card">
                    <div class="article-image">
                        <img src="@blog.ImagePath" alt="@blog.Title" />
                        <span class="article-category">
                            @string.Join(", ", Model.Categories.Where(c => blog.BlogCategoryIds
                                     .Split(',', System.StringSplitOptions.RemoveEmptyEntries)
                                     .Contains(c.Id.ToString()))
                                     .Select(c => c.Name))
                        </span>
                    </div>
                    <div class="article-content">
                        <h3 class="article-title">@blog.Title</h3>
                        <p class="article-excerpt">@blog.Description</p>
                        <div class="article-meta">
                            <span class="read-time">@blog.ReadTime</span>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<!-- Latest Articles Section -->
<section class="latest-articles-section">
    <div class="latest-articles-container">
        <div class="top-row">
            <div class="latest-header">
                <h2 class="latest-title">Latest <span class="highlight-orange">Articles</span></h2>
                <p class="latest-subtitle">Explore our comprehensive library of men's wellness insights</p>
            </div>

            <div class="sidebar-widget search-widget">
                <h3 class="widget-title">Search Articles</h3>
                <div class="search-box">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.35-4.35"></path>
                    </svg>
                    <input id="searchInput" type="text" placeholder="Search here" class="search-input" />
                </div>
            </div>
        </div>

        <div class="bottom-row">
            <div class="latest-grid">
                @foreach (var blog in Model.BlogList.OrderByDescending(b => b.CreatedAt).Take(4))
                {
                    <article onclick="location.href='@Url.Action("BlogDetail", "Home", new { id = blog.Id })'" class="latest-card">
                        <div class="latest-image">
                            <img src="@blog.ImagePath" alt="@blog.Title" />
                            <span class="latest-category">
                                @string.Join(", ", Model.Categories.Where(c => blog.BlogCategoryIds
                                         .Split(',', System.StringSplitOptions.RemoveEmptyEntries)
                                         .Contains(c.Id.ToString()))
                                         .Select(c => c.Name))
                            </span>
                        </div>
                        <div class="latest-content">
                            <h3 class="latest-card-title">@blog.Title</h3>
                            <p class="latest-excerpt">@blog.Description</p>
                            <div class="latest-meta">
                                <span class="author">@blog.WrittenBy</span>
                                <span class="date">@blog.CreatedAt.ToString("MMM dd, yyyy")</span>
                                <span class="read-time">@blog.ReadTime</span>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <aside class="articles-sidebar">
                <!-- Categories -->
                <div class="sidebar-widget categories-widget">
                    <h3 class="widget-title">
                        Categories
                        <div class="mobile-search-input">
                            <div class="search-box">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <path d="m21 21-4.35-4.35"></path>
                                </svg>
                                <input type="text" placeholder="Search articles here" class="search-input" />
                            </div>
                        </div>
                    </h3>
                    <ul class="categories-list">
                        @foreach (var cat in Model.Categories)
                        {
                            <li><a href="#">@cat.Name <span>(@Model.BlogList.Count(b => b.BlogCategoryIds.Split(',', System.StringSplitOptions.RemoveEmptyEntries).Contains(cat.Id.ToString())))</span></a></li>
                        }
                    </ul>
                </div>

                <!-- Popular Reads -->
                <div class="sidebar-widget popular-widget">
                    <h3 class="widget-title">Popular Reads</h3>
                    <ol class="popular-list">
                        @foreach (var blog in Model.BlogList.OrderByDescending(b => b.ReadCount).Take(4))
                        {
                            <li><a href="@Url.Action("BlogDetail", "Home", new { id = blog.Id })">@blog.Title</a></li>
                        }
                    </ol>
                </div>

                <!-- Newsletter -->
                <div class="sidebar-widget newsletter-widget">
                    <h3 class="widget-title">Stay Informed</h3>
                    <p class="newsletter-text">Get Wellness Insights Delivered to your inbox</p>
                    <input type="email" placeholder="Your Email Address" class="newsletter-input" />
                    <button class="newsletter-btn">Subscribe</button>
                </div>
            </aside>
        </div>
    </div>
</section>

<!-- Expert Panel Section -->
<section class="expert-panel-section">
    <div class="expert-panel-container">
        <h2 class="expert-panel-title">All articles are Curated and reviewed by Our Expert Panel</h2>

        <div class="experts-grid">
            @for (int i = 0; i < 3; i++)
            {
                <div class="expert-card">
                    <div class="expert-image">
                        <img src="~/image/blog/doctor-with-his-arms-crossed-white-background.png" alt="Dr.Marcus Chen" />
                    </div>
                    <div class="expert-info">
                        <h3 class="expert-name">Dr.Marcus Chen</h3>
                        <p class="expert-title">Sports Medicine Specialist</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Recommended Reading Section -->
<section class="recommended-reading-section">
    <div class="recommended-container">
        <div class="recommended-header">
            <h2 class="recommended-title"><span class="highlight-orange">Recommended</span> Reading</h2>
            <p class="recommended-subtitle">Explore more articles tailored to your wellness journey.</p>
        </div>

        <div class="recommended-grid">
            @foreach (var blog in Model.BlogList.OrderByDescending(b => b.ReadCount).Take(3))
            {
                <article class="recommended-card">
                    <div class="recommended-image">
                        <img src="@blog.ImagePath" alt="@blog.Title" />
                    </div>
                    <div class="recommended-content">
                        <span class="recommended-category">
                            @string.Join(", ", Model.Categories.Where(c => blog.BlogCategoryIds
                                     .Split(',', System.StringSplitOptions.RemoveEmptyEntries)
                                     .Contains(c.Id.ToString()))
                                     .Select(c => c.Name))
                        </span>
                        <h3 class="recommended-card-title">@blog.Title</h3>
                        <p class="recommended-excerpt">@blog.Description</p>
                        <div class="recommended-footer">
                            <div class="recommended-meta">
                                <span>@blog.ReadTime</span>
                            </div>
                            <svg onclick="location.href='@Url.Action("BlogDetail", "Home", new { id = blog.Id })'" class="recommended-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="blog-cta-section">
    <div class="blog-cta-container">
        <h2 class="blog-cta-title">
            Knowledge is power. <span class="highlight-orange">Vitality is Action.</span><br />
            Take the next Step
        </h2>
        <p class="blog-cta-description">
            Ready to transform knowledge into Results? Discover your Personalized wellness Journey.
        </p>
        <div class="blog-cta-buttons">
            <a href="@Url.Action("Plan", "Home")"
               class="blog-cta-btn blog-cta-btn-primary"
               style="text-decoration:none;">
                Explore Plans
            </a>
            <a href="@Url.Action("Quiz", "Home")"
               class="blog-cta-btn blog-cta-btn-secondary"
               style="text-decoration:none;">
                Take the Quiz
            </a>
        </div>
    </div>
</section>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('searchInput');
        if (!searchInput) return;

        searchInput.addEventListener('input', function () {
            const query = this.value.toLowerCase();

            // Latest articles cards
            const latestArticles = document.querySelectorAll('.latest-articles-section article.latest-card');
            latestArticles.forEach(article => {
                const text = article.textContent.toLowerCase();
                article.style.display = text.includes(query) ? '' : 'none';
            });

            // Categories list items
            const categoryItems = document.querySelectorAll('.categories-list li');
            categoryItems.forEach(li => {
                const text = li.textContent.toLowerCase();
                li.style.display = text.includes(query) ? '' : 'none';
            });

            // Popular reads list items
            const popularItems = document.querySelectorAll('.popular-list li');
            popularItems.forEach(li => {
                const text = li.textContent.toLowerCase();
                li.style.display = text.includes(query) ? '' : 'none';
            });
        });
    });
</script>
