<!-- Blog Hero Section -->
<section class="blog-hero-section">
    <div class="blog-hero-container">
        <div class="blog-hero-content">
            <h1 class="blog-hero-title">
                Insights for Men. <span class="highlight-orange">Strength for Life</span>
            </h1>
            <p class="blog-hero-description">
                Stay informed with expert articles on vitality, performance, and holistic wellness - crafted for the modern man
            </p>
