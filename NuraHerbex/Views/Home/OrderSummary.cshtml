@* @section Scripts { *@
@{
	var json = JsonSerializer.Serialize(
		Model.Addresses,
		new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }
	);
}
<script>
	(function () {
	  const addresses = @Html.Raw(json);        // [{ id, name, location, doorNo, phoneNumber, address, state, pincode, country, ... }]
	  const selectEl  = document.getElementById('addressSelect');

	  // Build a lookup by id for O(1) access
	  const byId = new Map(addresses.map(a => [a.id, a]));

	  const $ = id => document.getElementById(id);
	  const set = (id, v) => { const el = $(id); if (el) el.value = (v ?? "").toString(); };
	  const clearForm = () => ['firstName','lastName','streetAddress','city','state','zipCode','phone']
		.forEach(id => set(id, ""));

	  function fillForm(a) {
		if (!a) { clearForm(); return; }

		// Split name if you only have a single Name field
		const full = a.name || "";
		const space = full.indexOf(" ");
		const fn = space > 0 ? full.slice(0, space) : full;
		const ln = space > 0 ? full.slice(space + 1) : "";

		set('firstName', fn);
		set('lastName', ln);

		// Address lines (customize as needed)
		// Street Address from DoorNo + Address (+ Location if you prefer)
		const street = [a.doorNo, a.address].filter(Boolean).join(", ");
		set('streetAddress', street);

		// City/State/Zip/Country/Phone (numbers converted to string)
		set('city',     a.location);          // or a.city if that's your field
		set('state',    a.state);             // if you have stateName, use that
		set('zipCode',  a.pincode);           // pincode is often numeric
		set('phone',    a.phoneNumber);
	  }

	  function getSelected() {
		const id = parseInt(selectEl.value, 10);
		return Number.isFinite(id) ? byId.get(id) : null;
	  }

	  // Initial render (when page loads with a preselected option)
	  if (selectEl && selectEl.value) {
		fillForm(getSelected());
	  }

	  // On change
	  selectEl.addEventListener('change', function () {
		fillForm(getSelected());
	  });
	})();
</script>

