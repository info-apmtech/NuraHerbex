@* @section Scripts { *@
@{
	// IMPORTANT: camelCase so JS sees .pincode, .phoneNumber, etc.
	var jsonOpts = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
	var addressesJ = System.Text.Json.JsonSerializer.Serialize(Model.Addresses, jsonOpts);
	var pincodesJ = System.Text.Json.JsonSerializer.Serialize(Model.Pincodes, jsonOpts);
}
<script>
	(() => {
	  // ---------- Data from server ----------
	  const addresses = @Html.Raw(addressesJ); // [{ id, name, location, doorNo, address, state, pincode, country, phoneNumber }]
	  const pincodes  = @Html.Raw(pincodesJ);  // [{ code, standardDeliveryAmount, expressDeliveryAmount }]

	  // Maps
	  const addrById = new Map((addresses || []).map(a => [a.id, a]));
	  const pinRates = Object.fromEntries((pincodes || []).map(p => [
		p.code, { std: p.standardDeliveryAmount || 0, exp: p.expressDeliveryAmount || 0 }
	  ]));

	  // ---------- DOM refs ----------
	  const addressSelect   = document.getElementById('addressSelect');

	  // Address fields (IDs must exist in your form)
	  const fields = {
		firstName:     document.getElementById('firstName'),
		lastName:      document.getElementById('lastName'),
		streetAddress: document.getElementById('streetAddress'),
		city:          document.getElementById('city'),
		state:         document.getElementById('state'),
		zipCode:       document.getElementById('zipCode'),
		phone:         document.getElementById('phone')
	  };

	  // Delivery radios
	  const deliveryRadios  = document.querySelectorAll('input[name="delivery"]');

	  // Totals area
	  const subtotalEl = document.getElementById('subtotal');
	  const taxEl      = document.getElementById('tax');
	  const discountEl = document.getElementById('discount');
	  const shippingEl = document.getElementById('shipping');
	  const totalEl    = document.getElementById('total');

	  // (Optional) the price labels shown on the cards
	  const priceStdEl = document.getElementById('priceStandard');
	  const priceExpEl = document.getElementById('priceExpress');

	  // Hidden inputs used by the POST form
	  const form           = document.querySelector('.proceed-section form');
	  const hiddenAddress  = form?.querySelector('input[name="SelectedAddressId"]');
	  const hiddenDelivery = form?.querySelector('input[name="DeliveryOption"]');

	  // ---------- helpers ----------
	  const fmt = n => "₹" + Number(n || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
	  const parseMoney = s => Number((s || "").toString().replace(/[^\d.-]/g, "")) || 0;

	  const getSelectedAddress = () => {
		const id = parseInt(addressSelect?.value || "0", 10);
		return Number.isFinite(id) ? addrById.get(id) : null;
	  };
	  const getMode = () => {
		const r = Array.from(deliveryRadios).find(x => x.checked);
		return r ? r.value : "standard";
	  };

	  function fillAddressForm(addr) {
		// clear if not found
		if (!addr) {
		  Object.values(fields).forEach(el => { if (el) el.value = ""; });
		  return;
		}
		// Split the Name field into first/last
		const full = addr.name || "";
		const i    = full.indexOf(" ");
		const fn   = i > 0 ? full.slice(0, i) : full;
		const ln   = i > 0 ? full.slice(i + 1) : "";

		if (fields.firstName)     fields.firstName.value     = fn;
		if (fields.lastName)      fields.lastName.value      = ln;
		if (fields.streetAddress) fields.streetAddress.value = [addr.doorNo, addr.address].filter(Boolean).join(", ");
		if (fields.city)          fields.city.value          = addr.location || "";
		if (fields.state)         fields.state.value         = (addr.state ?? "").toString();
		if (fields.zipCode)       fields.zipCode.value       = addr.pincode || "";
		if (fields.phone)         fields.phone.value         = addr.phoneNumber || "";
	  }

	  function refreshPrices(addr) {
		const pin  = addr?.pincode || "";
		const rate = pinRates[pin] || { std: 0, exp: 0 };

		// update labels on the cards (if present)
		if (priceStdEl) priceStdEl.textContent = fmt(rate.std);
		if (priceExpEl) priceExpEl.textContent = fmt(rate.exp);

		const mode     = getMode();
		const shipping = (mode === "express") ? rate.exp : rate.std;

		const subtotal = parseMoney(subtotalEl?.textContent);
		const tax      = parseMoney(taxEl?.textContent);
		const discount = parseMoney(discountEl?.textContent);

		if (shippingEl) shippingEl.textContent = fmt(shipping);
		if (totalEl)    totalEl.textContent    = fmt(subtotal + tax + shipping - discount);

		// keep hidden fields in sync for POST
		if (hiddenDelivery) hiddenDelivery.value = mode;
		if (hiddenAddress && addressSelect) hiddenAddress.value = addressSelect.value || '';
	  }

	  function onAddressChange() {
		const addr = getSelectedAddress();
		fillAddressForm(addr);
		refreshPrices(addr);
	  }
	  function onDeliveryChange() {
		refreshPrices(getSelectedAddress());
	  }

	  // ---------- init + listeners ----------
	  // Initial sync (handles preselected address)
	  onAddressChange();

	  // Bind once
	  addressSelect?.addEventListener('change', onAddressChange);
	  deliveryRadios.forEach(r => r.addEventListener('change', onDeliveryChange));
	})();
</script>





