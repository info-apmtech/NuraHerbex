    </div>
</section>

<!-- Final CTA Section -->
<section class="final-cta-section">
    <div class="final-cta-container">
        <h2 class="final-cta-title">
            Your performance upgrade.<br />
            <span class="highlight-orange">Starts Today.</span>
        </h2>
        <p class="final-cta-description">
            Don't wait - choose your plan and join the thousands of men who<br class="desktop-break" />
            refuse to settle for average.
        </p>
        <button class="final-cta-button" onclick="window.location.href='@Url.Action("Plan", "Home")'">Subscribe Now</button>
    </div>
</section>
