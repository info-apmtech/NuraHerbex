@using Domain.Models
@model List<PricingPlan>
@{
    ViewData["Title"] = "Plans";
}

<!-- Plan Hero Section -->
<section class="plan-hero-section">
    <div class="plan-hero-container">
        <h1 class="plan-hero-title">
            Choose Your Plan.<br />
            <span class="plan-hero-title-highlight">Fuel Your Next Level</span>
        </h1>
        <p class="plan-hero-description">
            Flexible subscription options designed for your Lifestyle-whether<br class="desktop-break" />
            you're starting your journey or aiming for peak performance.
        </p>
    </div>
</section>

<!-- Pricing Plans Section -->
@Html.Partial("_PlanPartial",Model)

<!-- Why Subscribe Section -->
<section class="why-subscribe-section">
    <div class="why-subscribe-container">
        <h2 class="why-subscribe-title">
            Why <span class="highlight-orange">Subscribe</span> to STAMIX?
        </h2>
        <p class="why-subscribe-subtitle">
            Experience the benefits of consistent wellness support with Exclusive member addvantages.
        </p>

        <div class="benefits-grid">
            <!-- Benefit 1 -->
            <div class="benefit-card">
                <div class="benefit-icon benefit-icon-orange">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <circle cx="12" cy="12" r="6"></circle>
                        <circle cx="12" cy="12" r="2"></circle>
                    </svg>
                </div>
                <h3 class="benefit-title">Consistent Results<br />with Daily Use</h3>
                <p class="benefit-description">
                    Scientifically formulated supplements designed for optimal daily absorption an cumulative Benefits
                </p>
            </div>

            <!-- Benefit 2 -->
            <div class="benefit-card">
                <div class="benefit-icon benefit-icon-blue">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                    </svg>
                </div>
                <h3 class="benefit-title">Free Doctor<br />Consultation</h3>
                <p class="benefit-description">
                    Access to Licensed Healthcare professionals for personalized guidance and health optimization.
                </p>
            </div>

            <!-- Benefit 3 -->
            <div class="benefit-card">
                <div class="benefit-icon benefit-icon-purple">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="23 4 23 10 17 10"></polyline>
                        <polyline points="1 20 1 14 7 14"></polyline>
                        <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                    </svg>
                </div>
                <h3 class="benefit-title">Flexible plans<br />(Upgrade anytime)</h3>
                <p class="benefit-description">
                    Scale your wellness journey with easy plan modification and no long term Commitments.
                </p>
            </div>

            <!-- Benefit 4 -->
            <div class="benefit-card">
                <div class="benefit-icon benefit-icon-green">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                </div>
                <h3 class="benefit-title">Exclusive Member<br />Benefits</h3>
                <p class="benefit-description">
                    VIP access to new Products, member-only content, and special discounts on wellness service.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Real Results Testimonials Section -->
