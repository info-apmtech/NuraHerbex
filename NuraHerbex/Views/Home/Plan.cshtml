                        <h4 class="testimonial-name-plan">Marcus Rodriguez</h4>
                        <div class="testimonial-stars-plan">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="#ff8800">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                            </svg>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="#ff8800">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                            </svg>
