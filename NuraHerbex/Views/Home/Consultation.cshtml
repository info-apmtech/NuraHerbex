<!-- Consultation Form Section -->

    <section class="consultation-section">
        <div class="consultation-header">
            <h2>Book Your <span class="highlight">Consultation</span></h2>
            <p>Schedule your personalized wellness consultation in just a few steps.</p>
        </div>

        <div class="form-container">
            <form asp-action="Consultation" method="post" class="consultation-form">
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" placeholder="email@example.com" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Phone"></label>
                        <input asp-for="Phone" placeholder="+91 0000000000" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="FirstName"></label>
                        <input asp-for="FirstName" placeholder="Enter Your First Name" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="LastName"></label>
                        <input asp-for="LastName" placeholder="Enter Your Last Name" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="ConsultationType"></label>
                        <select asp-for="ConsultationType" asp-items="Html.GetEnumSelectList<ConsultationType>()" class="form-control">
                            <option value="">Select Consultation Type</option>
                        </select>
                        <span asp-validation-for="ConsultationType" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PreferredDoctorId">Preferred Doctor</label>
                        <select asp-for="PreferredDoctorId" class="form-control" asp-items="ViewBag.DoctorList">
                            <option value="">Choose a Doctor</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                <div class="form-group">
                    <label asp-for="PreferredDate"></label>
                    <input asp-for="PreferredDate" type="date" class="form-control" />
                    <span asp-validation-for="PreferredDate" class="text-danger"></span>
                </div>

                    <div class="form-group">
                        <label asp-for="PreferredTimeSlot"></label>
                        <select asp-for="PreferredTimeSlot" asp-items="Html.GetEnumSelectList<TimeSlot>()" class="form-control">
                            <option value="">Select Time Slot</option>
                        </select>
                        <span asp-validation-for="PreferredTimeSlot" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="Concerns"></label>
                    <textarea asp-for="Concerns" rows="4" placeholder="Describe Your Health Concerns" class="form-control"></textarea>
                </div>
                <div class="form-group">
                    <label asp-for="Medications"></label>
                    <textarea asp-for="Medications" rows="4" placeholder="List medications" class="form-control"></textarea>
                </div>

                <button type="submit" class="submit-button">Book My Free Consultation</button>
            </form>
        </div>
    </section>

<!-- Process Section -->
<section class="process-section">
    <div class="process-header">
        <h2>Simple 4-Step <span class="highlight">Process</span></h2>
        <p>Getting expert wellness guidance has never been easier.</p>
    </div>

    <div class="process-steps">
        <div class="step">
            <div class="step-number">1</div>
            <h3>Book Online</h3>
            <p>Choose your preferred doctor and time slot using our easy booking system.</p>
        </div>

        <div class="step">
            <div class="step-number">2</div>
            <h3>Health Assessment</h3>
            <p>Complete a brief health questionnaire to help us understand your needs.</p>
        </div>

        <div class="step">
            <div class="step-number">3</div>
            <h3>Expert Consultation</h3>
            <p>Meet with your doctor via video call, phone, or in-person appointment.</p>
        </div>

        <div class="step">
            <div class="step-number">4</div>
            <h3>Personalized Plan</h3>
            <p>Receive your custom wellness plan and ongoing support for success.</p>
        </div>
    </div>
</section>

<!-- Your Next Level Starts Now Section -->
<section class="cta-section">
