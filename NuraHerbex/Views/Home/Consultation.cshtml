                </p>
            </div>
        </div>
        <div class="feature-card">
            <div class="consult-feature-icon">
                <img src="~/image/consultation/user.png" alt="Certified Experts icon">
            </div>
            <div class="feature-content">
                <h3 class="feature-title">Personalized Plans</h3>
                <p class="feature-description">
                    Custom wellness strategies based on your health history, goals, and lifestyle requirements.
                </p>
            </div>
        </div>
        <div class="feature-card">
            <div class="consult-feature-icon">
                <img src="~/image/consultation/user.png" alt="Certified Experts icon">
            </div>
            <div class="feature-content">
                <h3 class="feature-title">Flexible Sessions</h3>
                <p class="feature-description">
                    Choose from video calls, phone consultations, or in-person appointments at your convenience.
                </p>
            </div>
        </div>
        <div class="feature-card">
            <div class="consult-feature-icon">
                <img src="~/image/consultation/user.png" alt="Certified Experts icon">
            </div>
            <div class="feature-content">
                <h3 class="feature-title">Quick Scheduling</h3>
                <p class="feature-description">
                    Book appointments within 24-48 hours and get the guidance you need without long wait times.
                </p>
            </div>
        </div>
        <div class="feature-card">
            <div class="consult-feature-icon">
                <img src="~/image/consultation/user.png" alt="Certified Experts icon">
            </div>
            <div class="feature-content">
                <h3 class="feature-title">Ongoing Support</h3>
                <p class="feature-description">
                    Follow-up sessions and continuous monitoring to ensure you achieve your wellness goals.
                </p>
            </div>
        </div>
        <div class="feature-card">
            <div class="consult-feature-icon">
                <img src="~/image/consultation/user.png" alt="Certified Experts icon">
            </div>
            <div class="feature-content">
                <h3 class="feature-title">Confidential Care</h3>
                <p class="feature-description">
                    All consultations are private and secure, ensuring your health information remains protected.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Doctor Cards Section -->
<section class="doctors-section">
    <div class="quality-safety-container">
        <div class="quality-header">
            <h2 class="quality-title">Meet Your <span class="highlight-orange"> Expert Team</span></h2>
            <p class="quality-subtitle">
                Certified medical professionals dedicated to your health and performance optimization.
            </p>
        </div>
    </div>

    <div class="doctors-grid">
        @foreach (var doctorDetail in Model.DoctorDetailsModel.DoctorDetailList)
        {
            var doctor = Model.DoctorDetailsModel.Doctors.FirstOrDefault(d => d.Id == doctorDetail.DoctorId);
            if (doctor != null)
            {
                <div class="doctor-card">
                    <span class="badge">@doctorDetail.YearsOfExperience Years</span>

                    <div class="doctor-image">
                        <img src="@(string.IsNullOrEmpty(doctorDetail.PhotoPath)
                                ? Url.Content("~/image/consultation/doctor.png")
                                : Url.Content(doctorDetail.PhotoPath))"
                             alt="@doctor.FullName" class="doctor-photo" />

                    </div>

                    <div class="doctor-info">
                        <h3 class="doctor-name">@doctor.FullName</h3>
                        <p class="doctor-specialty">@doctorDetail.PrimarySpecality</p>
                        <div class="rating">
                            <span class="star">★</span>
                            <span class="rating-value">4.9</span>
                            <span class="rating-count">(324)</span>
                        </div>
                    </div>

                    <div class="doctor-details">
                        <div class="specialties">
                            <h4>Specialties</h4>
                            <div class="specialty-tags">
                                @if (doctorDetail.SelectedSpecialityIds != null && doctorDetail.SelectedSpecialityIds.Any())
                                {
                                    foreach (var specialtyId in doctorDetail.SelectedSpecialityIds)
                                    {
                                        var specialty = Model.DoctorDetailsModel.Specialities
                                        .FirstOrDefault(s => s.Id == specialtyId);
                                        if (specialty != null)
                                        {
                                            <span class="tag">@specialty.Name</span>
                                        }
                                    }
                                }
                            </div>
                        </div>

                        <div class="availability">
                            <h4>Availability</h4>
                            @{
                                var weekDays = new Dictionary<string, (TimeOnly? Start, TimeOnly? End)>
                                  {
                                  { "Monday", (doctorDetail.MondayStartTime, doctorDetail.MondayEndTime) },
                                  { "Tuesday", (doctorDetail.TuesdayStartTime, doctorDetail.TuesdayEndTime) },
                                  { "Wednesday", (doctorDetail.WednesdayStartTime, doctorDetail.WednesdayEndTime) },
                                  { "Thursday", (doctorDetail.ThursdayStartTime, doctorDetail.ThursdayEndTime) },
                                  { "Friday", (doctorDetail.FridayStartTime, doctorDetail.FridayEndTime) },
                                  { "Saturday", (doctorDetail.SaturdayStartTime, doctorDetail.SaturdayEndTime) },
                                  { "Sunday", (doctorDetail.SundayStartTime, doctorDetail.SundayEndTime) }
                                  };

                                foreach (var day in weekDays)
                                {
                                    if (day.Value.Start.HasValue && day.Value.End.HasValue)
                                    {
                                        <p>
                                            @day.Key:
                                            @day.Value.Start.Value.ToString("hh:mm tt", System.Globalization.CultureInfo.InvariantCulture)
                                            -
                                            @day.Value.End.Value.ToString("hh:mm tt", System.Globalization.CultureInfo.InvariantCulture)
                                        </p>
                                    }
                                }
                            }
                        </div>
                    </div>

                    <button class="book-button" onclick="bookConsultation('@doctor.Id', '@doctor.FullName')">
                        Book With @doctor.FullName
                    </button>
                </div>
            }
        }
    </div>
</section>

<!-- Consultation Form Section -->

<section class="consultation-section">
    <div class="consultation-header">
        <h2>Book Your <span class="highlight">Consultation</span></h2>
        <p>Schedule your personalized wellness consultation in just a few steps.</p>
    </div>

    <div class="form-container">
        <form asp-action="Consultation" method="post" class="consultation-form">
            @Html.AntiForgeryToken()

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="BookingModel.Email"></label>
                    <input asp-for="BookingModel.Email" class="form-control" placeholder="email@example.com" />
                    <span asp-validation-for="BookingModel.Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BookingModel.Phone"></label>
                    <input asp-for="BookingModel.Phone" class="form-control" placeholder="+91 0000000000" />
                    <span asp-validation-for="BookingModel.Phone" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="BookingModel.FirstName"></label>
                    <input asp-for="BookingModel.FirstName" class="form-control" placeholder="Enter Your First Name" />
                    <span asp-validation-for="BookingModel.FirstName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BookingModel.LastName"></label>
                    <input asp-for="BookingModel.LastName" class="form-control" placeholder="Enter Your Last Name" />
                    <span asp-validation-for="BookingModel.LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="BookingModel.ConsultationType"></label>
                    <select asp-for="BookingModel.ConsultationType" asp-items="Html.GetEnumSelectList<ConsultationType>()" class="form-control">
                        <option value="">Select Consultation Type</option>
                    </select>
                    <span asp-validation-for="BookingModel.ConsultationType" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BookingModel.PreferredDate"></label>
                    <input asp-for="BookingModel.PreferredDate"
                           type="date"
                           class="form-control"
                           id="PreferredDate" />
                    <span asp-validation-for="BookingModel.PreferredDate" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="BookingModel.PreferredDoctorId">Preferred Doctor</label>
                    <select asp-for="BookingModel.PreferredDoctorId"
                            class="form-control"
                            id="PreferredDoctorId"
                            asp-items="ViewBag.DoctorList">
                        <option value="">Choose a Doctor</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="BookingModel.PreferredTimeSlot"></label>
                    <select asp-for="BookingModel.PreferredTimeSlot" asp-items="Html.GetEnumSelectList<TimeSlot>()" class="form-control">
                        <option value="">Select Time Slot</option>
                    </select>
                    <span asp-validation-for="BookingModel.PreferredTimeSlot" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="BookingModel.Concerns"></label>
                <textarea asp-for="BookingModel.Concerns" rows="4" class="form-control" placeholder="Describe Your Health Concerns"></textarea>
            </div>

            <div class="form-group">
                <label asp-for="BookingModel.Medications"></label>
                <textarea asp-for="BookingModel.Medications" rows="4" class="form-control" placeholder="List medications"></textarea>
            </div>

            <button type="submit" class="submit-button">Book My Free Consultation</button>
        </form>
    </div>
</section>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const dateInput = document.getElementById('PreferredDate');
        const today = new Date().toISOString().split('T')[0];
        dateInput.setAttribute('min', today);

        dateInput.addEventListener('change', function () {
            const dateValue = this.value;
            const doctorDropdown = document.getElementById('PreferredDoctorId');

            if (!dateValue) return;

            // Disable dropdown while loading
            doctorDropdown.disabled = true;
            doctorDropdown.innerHTML = '<option>Loading...</option>';

            fetch(`/Home/GetAvailableDoctors?date=${dateValue}`)
                .then(response => response.json())
                .then(doctors => {
                    doctorDropdown.innerHTML = '<option value="">Choose a Doctor</option>';
                    doctors.forEach(d => {
                        const option = document.createElement('option');
                        option.value = d.id;
                        option.textContent = d.name;
                        doctorDropdown.appendChild(option);
                    });
                    doctorDropdown.disabled = false;
                })
                .catch(err => {
                    console.error('Error fetching doctors:', err);
                    doctorDropdown.innerHTML = '<option>Error loading doctors</option>';
                });
        });
    });
</script>

<!-- Process Section -->
