<!-- Consultation Form Section -->
<section class="consultation-section">
    <div class="consultation-header">
        <h2>Book Your <span class="highlight">Consultation</span></h2>
        <p>Schedule your personalized wellness consultation in just a few steps.</p>
    </div>

    <div class="form-container">
        <form class="consultation-form">
            <div class="form-row">
                <div class="form-group">
                    <label for="firstName">First Name</label>
                    <input type="text" id="firstName" placeholder="Enter Your First Name">
                </div>
                <div class="form-group">
                    <label for="lastName">Last Name</label>
                    <input type="text" id="lastName" placeholder="Enter Your Last Name">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" placeholder="email@example.com">
                </div>
                <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input type="tel" id="phone" placeholder="+91 0000000000">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="consultationType">Consultation Type</label>
                    <select id="consultationType">
                        <option>Select Consultation Type</option>
                        <option>Video Call</option>
                        <option>Phone Call</option>
                        <option>In-Person</option>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="doctor">Preferred Doctor</label>
                    <select id="doctor">
                        <option>Choose a Doctor</option>
                        <option>Dr. Marcus Chen</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="time">Preferred Time</label>
                    <select id="time">
                        <option>Select Time Slot</option>
                        <option>Morning (8:00 - 12:00)</option>
                        <option>Afternoon (12:00 - 17:00)</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label for="concerns">Health Concerns & Goals</label>
                <textarea id="concerns" rows="4" placeholder="Describe Your Health Concerns"></textarea>
            </div>

            <div class="form-group">
                <label for="medications">Current Medication & Supplements</label>
                <textarea id="medications" rows="4" placeholder="List medications"></textarea>
            </div>

            <button type="submit" class="submit-button">Book My Free Consultation</button>
        </form>
    </div>
</section>

<!-- Process Section -->
<section class="process-section">
    <div class="process-header">
        <h2>Simple 4-Step <span class="highlight">Process</span></h2>
        <p>Getting expert wellness guidance has never been easier.</p>
    </div>

    <div class="process-steps">
        <div class="step">
            <div class="step-number">1</div>
            <h3>Book Online</h3>
            <p>Choose your preferred doctor and time slot using our easy booking system.</p>
        </div>

        <div class="step">
            <div class="step-number">2</div>
            <h3>Health Assessment</h3>
            <p>Complete a brief health questionnaire to help us understand your needs.</p>
        </div>

        <div class="step">
            <div class="step-number">3</div>
            <h3>Expert Consultation</h3>
            <p>Meet with your doctor via video call, phone, or in-person appointment.</p>
        </div>

        <div class="step">
            <div class="step-number">4</div>
            <h3>Personalized Plan</h3>
            <p>Receive your custom wellness plan and ongoing support for success.</p>
        </div>
    </div>
</section>

