@{
    ViewData["Title"] = "About - NuraHerbex";
}

<!-- About Hero Section -->
<section class="about-hero-section">
    <div class="about-hero-container">
        <div class="about-hero-content">
            <h1 class="about-hero-title">
                More than a Supplement. <span class="highlight-orange">A Movement</span> for men's wellness.
            </h1>
            <p class="about-hero-description">
                At STAMIX, we believe every man deserves vitality, strength, and confidence naturally.
            </p>
        </div>
        <div class="about-hero-image">
            <img src="~/image/about/Mask group.png" alt="Man exercising" />
        </div>
    </div>
</section>

<!-- Our Story Section -->
<section class="our-story-section">
    <div class="our-story-container">
        <div class="our-story-content">
            <h2 class="our-story-title">Our <span class="highlight-orange">Story</span></h2>
            <p class="story-paragraph">
                STAMIX was created to help men unlock their full potential through science-backed, natural formulations. Our journey began with a simple mission: to provide safe, effective, and holistic wellness solutions that boosts stamina energy and Long-Term Vitality.
            </p>
            <p class="story-paragraph">
                We understand that modern life demands peak performance from men in every aspect—from the boardroom to the gym, from family responsibilities to personal goals. That's why we've dedicated ourselves to crafting premium supplements that work with your body's natural systems.
            </p>
            <div class="story-badge">
                <div class="badge-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M12 6v6l4 2" stroke="white" stroke-width="2" fill="none"></path>
                    </svg>
                </div>
                <p class="badge-text">Precision-Crafted for peak performance</p>
            </div>
        </div>
        <div class="our-story-image">
            <img src="~/image/about/smiling-young-male.png" alt="Professional businessman" />
        </div>
    </div>
</section>

<!-- Our Purpose Section -->
<section class="our-purpose-section">
    <div class="our-purpose-container">
        <div class="purpose-header">
            <h2 class="purpose-title">Our <span class="highlight-orange">Purpose</span></h2>
            <p class="purpose-subtitle">Driving the future of men's wellness through innovation and nature</p>
        </div>

        <div class="purpose-grid">
            <!-- Mission Card -->
            <div class="purpose-card">
                <div class="card-header">
                    <h3 class="card-title">Our Mission</h3>
                    <div class="card-icon">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <circle cx="12" cy="12" r="6"></circle>
                            <circle cx="12" cy="12" r="2"></circle>
                        </svg>
                    </div>
                </div>
                <p class="card-description">
                    To empower men with natural, premium-quality supplements that support energy, performance, and confidence at every stage of life.
                </p>
                <div class="card-footer">
                    <svg width="20" height="2" viewBox="0 0 20 2" fill="none">
                        <line x1="0" y1="1" x2="20" y2="1" stroke="#f44900" stroke-width="2" />
                    </svg>
                    <span class="footer-text">Empowering Excellence</span>
                </div>
            </div>

            <!-- Vision Card -->
            <div class="purpose-card">
                <div class="card-header">
                    <h3 class="card-title">Our Vision</h3>
                    <div class="card-icon">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 3l-1.5 1.5L12 6l1.5-1.5L12 3z"></path>
                            <circle cx="12" cy="12" r="4"></circle>
                            <path d="M12 18l-1.5 1.5L12 21l1.5-1.5L12 18z"></path>
                            <path d="M3 12l1.5-1.5L6 12l-1.5 1.5L3 12z"></path>
                            <path d="M18 12l1.5-1.5L21 12l-1.5 1.5L18 12z"></path>
                        </svg>
                    </div>
                </div>
                <p class="card-description">
                    To be the most trusted men's wellness brand, helping millions achieve strength, resilience, and longevity through nature and science.
                </p>
                <div class="card-footer">
                    <svg width="20" height="2" viewBox="0 0 20 2" fill="none">
                        <line x1="0" y1="1" x2="20" y2="1" stroke="#f44900" stroke-width="2" />
                    </svg>
                    <span class="footer-text">Leading Innovation</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Quality & Safety Section -->
<section class="quality-safety-section">
    <div class="quality-safety-container">
        <div class="quality-header">
            <h2 class="quality-title"><span class="highlight-orange">Quality</span> & Safety First</h2>
            <p class="quality-subtitle">Your health and safety are our top priorities. Every product meets the Highest industry standards.</p>
        </div>

        <div class="quality-grid">
            <!-- Badge 1 -->
            <div class="quality-badge">
                <div class="badge-icon-circle green">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M9 12l2 2 4-4"></path>
                    </svg>
                </div>
                <h3 class="badge-title">26+ Powerful Natural Ingredients</h3>
                <p class="badge-description">Carefully sourced premium botanicals and nutrients for optimal wellness.</p>
            </div>

            <!-- Badge 2 -->
            <div class="quality-badge">
                <div class="badge-icon-circle blue">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </div>
                <h3 class="badge-title">Doctor Recommended</h3>
                <p class="badge-description">Endorsed by healthcare Professionals and wellness experts worldwide.</p>
            </div>

            <!-- Badge 3 -->
            <div class="quality-badge">
                <div class="badge-icon-circle purple">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                </div>
                <h3 class="badge-title">Tested for Purity & Safety</h3>
                <p class="badge-description">Rigorous third-party testing ensures maximum purity and potency.</p>
            </div>

            <!-- Badge 4 -->
            <div class="quality-badge">
                <div class="badge-icon-circle green">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M9 12l2 2 4-4"></path>
                    </svg>
                </div>
                <h3 class="badge-title">Premium Quality. Globally Sourced</h3>
                <p class="badge-description">The Finest ingredients from trusted suppliers around the world.</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="about-cta-section">
    <div class="about-cta-container">
        <h2 class="about-cta-title">
            Your next level starts here. <span class="highlight-orange">Join the STAMIX movement</span>
        </h2>
        <p class="about-cta-description">
            Ready to unlock your potential? Discover the power of premium, natural wellness solutions designed specifically for men.
        </p>
        <button class="about-cta-button">Shop Now</button>
    </div>
</section>



