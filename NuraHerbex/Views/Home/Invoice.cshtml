@{
    Layout = null;
    ViewData["Title"] = "Purchase Order";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Purchase Order - Invoice</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 0.9rem;
            color: #333;
            background-color: #fff;
        }

        .invoice-container {
            max-width: 900px;
            margin: auto;
            background: #fff;
            padding: 30px;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .invoice-header {
            text-align: center;
            margin-bottom: 1.5rem;
        }

            .invoice-header img {
                height: 80px;
                margin-bottom: 0.5rem;
            }

        h1 {
            font-size: 1.75rem;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        h5 {
            font-weight: 600;
            font-size: 1.05rem;
        }

        .table th {
            background-color: #f8f9fa;
        }

        table th, table td {
            vertical-align: middle !important;
        }

        .totals td {
            border-top: none !important;
        }

        /* ---- Print Styling ---- */
        @@media print {
            body {
                margin: 0;
                background: #fff;
                font-size: 12px;
            }

            .invoice-container {
                border: none;
                padding: 0;
                margin: 0;
                page-break-after: always;
            }

            .no-print {
                display: none !important;
            }

            h1 {
                font-size: 18px;
            }

            .footer-section {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                text-align: right;
                padding-right: 50px;
            }

            @@page {
                size: A4;
                margin: 1.5cm;
            }

            .page-break {
                page-break-before: always;
            }
        }
    </style>
</head>
<body>
    <div class="invoice-container">
        <!-- Header -->
        <div class="invoice-header">
            <img src="~/image/logo.png" alt="Company Logo" />
            <h1>Purchase Order</h1>
        </div>

        <!-- Parties -->
        <div class="row mb-4">
            <div class="col-md-6">
                <h5>Supplier</h5>
                <div>
                    <strong>ABC Components Pvt. Ltd.</strong><br />
                    No. 45, Industrial Estate, Peenya,<br />
                    Bengaluru - 560058<br />
                    GSTIN: 29AACCA1234D1ZB<br />
                    Email: contact@abccomponents.com
                </div>
            </div>
            <div class="col-md-6 text-md-end">
                <h5>Company</h5>
                <div>
                    <strong>NMSIM Technologies Pvt. Ltd.</strong><br />
                    No. 12, 2nd Floor, Tech Park Road,<br />
                    Chennai - 600042<br />
                    GSTIN: 33AAFCN5678G1ZT<br />
                    Email: accounts@nmsimtech.com
                </div>
            </div>
        </div>

        <!-- Meta Info -->
        <div class="row mb-3">
            <div class="col-md-6">
                <strong>PO No:</strong> PO/2025/0012
            </div>
            <div class="col-md-6 text-md-end">
                <strong>PO Date:</strong> 28-Oct-2025
            </div>
        </div>

        <!-- Items Table -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle">
                <thead class="table-light text-center">
                    <tr>
                        <th style="width:4rem;">#</th>
                        <th>Description</th>
                        <th>HSN</th>
                        <th>Qty</th>
                        <th>Unit Price (₹)</th>
                        <th>GST %</th>
                        <th>GST Amount (₹)</th>
                        <th>Total (₹)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center">1</td>
                        <td><strong>GPS Tracking Module - AIS140</strong><br />Model: NMSIM-GT06</td>
                        <td class="text-center">8526</td>
                        <td class="text-end">50</td>
                        <td class="text-end">2,000.00</td>
                        <td class="text-end">18%</td>
                        <td class="text-end">18,000.00</td>
                        <td class="text-end">1,18,000.00</td>
                    </tr>
                    <tr>
                        <td class="text-center">2</td>
                        <td><strong>SIM Card (IoT Data SIM)</strong><br />Data Plan: 1 Year Validity</td>
                        <td class="text-center">8517</td>
                        <td class="text-end">50</td>
                        <td class="text-end">150.00</td>
                        <td class="text-end">18%</td>
                        <td class="text-end">1,350.00</td>
                        <td class="text-end">8,850.00</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Totals -->
        <div class="row justify-content-end">
            <div class="col-md-6">
                <table class="table table-borderless">
                    <tr class="totals">
                        <td class="text-end fw-bold">Subtotal (Net):</td>
                        <td class="text-end">₹1,09,850.00</td>
                    </tr>
                    <tr class="totals">
                        <td class="text-end fw-bold">Total GST:</td>
                        <td class="text-end">₹19,350.00</td>
                    </tr>
                    <tr class="totals border-top">
                        <td class="text-end fw-bold">Grand Total:</td>
                        <td class="text-end fw-bold">₹1,29,200.00</td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Footer -->
        <div class="row mt-5">
            <div class="col-6">
                <p class="small text-muted">* This is a system-generated purchase order.</p>
            </div>
            <div class="col-6 text-end">
                <p><strong>Authorized Signatory</strong></p>
                <div style="height:50px;"></div>
                <p class="text-muted small">For NMSIM Technologies Pvt. Ltd.</p>
            </div>
        </div>

        <!-- Print Button -->
        <div class="text-center mt-4 no-print">
            <button class="btn btn-primary" onclick="window.print()">Print Purchase Order</button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
