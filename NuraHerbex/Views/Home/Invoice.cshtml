@using Domain.Models
@model Domain.ViewModel.OrderSummaryViewModel

@{
    Layout = null;
    ViewData["Title"] = "Purchase Order";

    // ===== Company Info (your company) =====
    var companyName = "NMSIM Technologies Pvt. Ltd.";
    var companyAddress = "No. 12, 2nd Floor, Tech Park Road, Chennai - 600042";
    var companyGSTIN = "33AAFCN5678G1ZT";
    var companyEmail = "accounts@nmsimtech.com";
    var companyPhone = "+91 91234 56789";

    // ===== Order & Customer Info FROM MODEL =====
    var order = Model.Order ?? new Order();

    var poNumber = $"PO/{order.Id:0000}";
    var poDate = order.OrderDate.ToString("dd-MMM-yyyy");

    // Customer-related props
    var customerName = Model.FullName ?? "";
    var customerDoorNo = order.DoorNo;
    var customerBaseAddress = order.Address;
    var customerStateText = Model.StateName  ?? "";
    var customerPinCode = order.PinCode;
    var customerCountryText = Model.CountryName ?? "";
    var customerPhone = order.PhoneNo;

    var customerAddressLine1 = string.Join(", ",
        new[] { customerDoorNo, customerBaseAddress }
            .Where(s => !string.IsNullOrWhiteSpace(s)));

    var customerAddressLine2 = string.Join(", ",
        new[] { customerStateText, customerPinCode }
            .Where(s => !string.IsNullOrWhiteSpace(s)));

    // ===== Items FROM MODEL =====
    var items = Model.Details ?? new List<OrderDetail>();

    // we'll recompute totals here using GST-inclusive logic
    decimal subtotalNet = 0m;
    decimal totalGST = 0m;
    decimal grandTotal = 0m;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 0.9rem;
            color: #333;
            background-color: #fff;
        }

        .invoice-container {
            max-width: 900px;
            margin: auto;
            background: #fff;
            padding: 30px;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .invoice-header {
            text-align: center;
            margin-bottom: 1.5rem;
        }

            .invoice-header img {
                height: 80px;
                margin-bottom: 0.5rem;
            }

        h1 {
            font-size: 1.75rem;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        h5 {
            font-weight: 600;
            font-size: 1.05rem;
        }

        .table th {
            background-color: #f8f9fa;
        }

        table th, table td {
            vertical-align: middle !important;
        }

        .totals td {
            border-top: none !important;
        }

        @@media print {
            body {
                margin: 0;
                background: #fff;
                font-size: 12px;
            }

            .invoice-container {
                border: none;
                padding: 0;
                margin: 0;
                page-break-after: always;
            }

            .no-print {
                display: none !important;
            }

            h1 {
                font-size: 18px;
            }

            .footer-section {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                text-align: right;
                padding-right: 50px;
            }

            @@page {
                size: A4;
                margin: 1.5cm;
            }
        }
    </style>
</head>
<body>
    <div class="invoice-container">
        <!-- Header -->
        <div class="invoice-header">
            <img src="~/image/logo.png" alt="Company Logo" />
            <h1>Purchase Order</h1>
        </div>

        <!-- Parties -->
        <div class="row mb-4">
            <!-- LEFT: CUSTOMER -->
            <div class="col-md-6">
                <h5>Customer</h5>
                <div>
                    @if (!string.IsNullOrWhiteSpace(customerName))
                    {
                        <strong>@customerName</strong>
                    
                        <br />
                    }

                    @if (!string.IsNullOrWhiteSpace(customerAddressLine1))
                    {
                        @customerAddressLine1
                    
                        <br />
                    }

                    @if (!string.IsNullOrWhiteSpace(customerAddressLine2))
                    {
                        @customerAddressLine2
                    
                        <br />
                    }

                    @if (!string.IsNullOrWhiteSpace(customerCountryText))
                    {
                        @customerCountryText
                    
                        <br />
                    }

                    @if (!string.IsNullOrWhiteSpace(customerPhone))
                    {
                        <span>Phone: @customerPhone</span>
                    
                        <br />
                    }
                </div>
            </div>

            <!-- RIGHT: YOUR COMPANY -->
            <div class="col-md-6 text-md-end">
                <h5>Company</h5>
                <div>
                    <strong>@companyName</strong><br />
                    @companyAddress<br />
                    GSTIN: @companyGSTIN<br />
                    Email: @companyEmail<br />
                    Phone: @companyPhone
                </div>
            </div>
        </div>

        <!-- Meta Info -->
        <div class="row mb-3">
            <div class="col-md-6">
                <strong>PO No:</strong> @poNumber
            </div>
            <div class="col-md-6 text-md-end">
                <strong>PO Date:</strong> @poDate
            </div>
        </div>

        <!-- Items Table -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle">
                <thead class="table-light text-center">
                    <tr>
                        <th style="width:4rem;">#</th>
                        <th>Description</th>
                        <th>Qty</th>
                        <th>Unit Price (₹)</th>
                        @* <th>GST %</th> *@
                        @* <th>GST Amount (₹)</th> *@
                        <th>Total (₹)</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var index = 1;
                        const decimal gstPercent = 18m;   // all products at 18%, GST INCLUDED
                    }
                    @foreach (var d in items)
                    {
                        var qty = d.Quantity;
                        var unitPrice = d.UnitPrice;

                        decimal gross = qty * unitPrice;     // includes GST
                        decimal baseAmount = 0m;
                        decimal gstAmount = 0m;
                        decimal lineTotal = 0m;

                        if (qty > 0 && unitPrice > 0)
                        {
                            // GST-INCLUSIVE LOGIC
                            baseAmount = (gross * 100m) / (100m + gstPercent);   // amount without GST
                            gstAmount = gross - baseAmount;                     // GST portion
                            lineTotal = gross;                                   // customer pays this
                        }

                        // accumulate totals for the bottom summary
                        subtotalNet += baseAmount;
                        totalGST += gstAmount;
                        grandTotal += lineTotal;
                        <tr>
                            <td class="text-center">@index</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(d.productName))
                                {
                                    @d.productName
                                }
                                else
                                {
                                    @($"Product #{d.ProductId}")
                                }
                            </td>

                            <td class="text-end">@qty</td>
                            <td class="text-end">@unitPrice.ToString("N2")</td>
                            @* <td class="text-end">@gstPercent</td> *@
                            @* <td class="text-end">@gstAmount.ToString("N2")</td> *@
                            <td class="text-end">@lineTotal.ToString("N2")</td>
                        </tr>

                        index++;
                    }
                </tbody>
            </table>
        </div>

        <!-- Totals -->
        <div class="row justify-content-end">
            <div class="col-md-6">
                <table class="table table-borderless">
                    <tr class="totals">
                        <td class="text-end fw-bold">Subtotal (Net):</td>
                        <td class="text-end">₹@subtotalNet.ToString("N2")</td>
                    </tr>
                    <tr class="totals">
                        <td class="text-end fw-bold">Total GST:</td>
                        <td class="text-end">₹@totalGST.ToString("N2")</td>
                    </tr>
                    <tr class="totals border-top">
                        <td class="text-end fw-bold">Grand Total:</td>
                        <td class="text-end fw-bold">₹@grandTotal.ToString("N2")</td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Footer -->
        <div class="row mt-5">
            <div class="col-6">
                <p class="small text-muted">* This is a system-generated purchase order.</p>
            </div>
            <div class="col-6 text-end">
                <p><strong>Authorized Signatory</strong></p>
                <div style="height:50px;"></div>
                <p class="text-muted small">For @companyName</p>
            </div>
        </div>

        <!-- Print Button -->
        <div class="text-center mt-4 no-print">
            <button class="btn btn-primary" onclick="window.print()">Print Purchase Order</button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
