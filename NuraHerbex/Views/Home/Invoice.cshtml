@{
    Layout = null;
    ViewData["Title"] = "Purchase Order";

    // ===== Supplier Info =====
    var supplierName = "ABC Components Pvt. Ltd.";
    var supplierAddress = "No. 45, Industrial Estate, Peenya, Bengaluru - 560058";
    var supplierGSTIN = "29AACCA1234D1ZB";
    var supplierEmail = "contact@abccomponents.com";
    var supplierPhone = "+91 98765 43210";

    // ===== Company Info =====
    var companyName = "NMSIM Technologies Pvt. Ltd.";
    var companyAddress = "No. 12, 2nd Floor, Tech Park Road, Chennai - 600042";
    var companyGSTIN = "33AAFCN5678G1ZT";
    var companyEmail = "accounts@nmsimtech.com";
    var companyPhone = "+91 91234 56789";

    // ===== Purchase Order Info =====
    var poNumber = "PO/2025/0012";
    var poDate = "28-Oct-2025";

    // ===== Item List (dummy) =====
    var items = new List<dynamic>
    {
        new { SNo = 1, Description = "GPS Tracking Module - AIS140<br/>Model: NMSIM-GT06", HSN = "8526", Qty = 50, UnitPrice = 2000.00, GST = 18, GSTAmount = 18000.00, Total = 118000.00 },
        new { SNo = 2, Description = "SIM Card (IoT Data SIM)<br/>Data Plan: 1 Year Validity", HSN = "8517", Qty = 50, UnitPrice = 150.00, GST = 18, GSTAmount = 1350.00, Total = 8850.00 }
    };

    // ===== Totals =====
    var subtotal = 109850.00;
    var totalGST = 19350.00;
    var grandTotal = 129200.00;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 0.9rem;
            color: #333;
            background-color: #fff;
        }

        .invoice-container {
            max-width: 900px;
            margin: auto;
            background: #fff;
            padding: 30px;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .invoice-header {
            text-align: center;
            margin-bottom: 1.5rem;
        }

            .invoice-header img {
                height: 80px;
                margin-bottom: 0.5rem;
            }

        h1 {
            font-size: 1.75rem;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        h5 {
            font-weight: 600;
            font-size: 1.05rem;
        }

        .table th {
            background-color: #f8f9fa;
        }

        table th, table td {
            vertical-align: middle !important;
        }

        .totals td {
            border-top: none !important;
        }

        @@media print {
            body {
                margin: 0;
                background: #fff;
                font-size: 12px;
            }

            .invoice-container {
                border: none;
                padding: 0;
                margin: 0;
                page-break-after: always;
            }

            .no-print {
                display: none !important;
            }

            h1 {
                font-size: 18px;
            }

            .footer-section {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                text-align: right;
                padding-right: 50px;
            }

            @@page {
                size: A4;
                margin: 1.5cm;
            }
        }
    </style>
</head>
<body>
    <div class="invoice-container">
        <!-- Header -->
        <div class="invoice-header">
            <img src="~/image/logo.png" alt="Company Logo" />
            <h1>Purchase Order</h1>
        </div>

        <!-- Parties -->
        <div class="row mb-4">
            <div class="col-md-6">
                <h5>Supplier</h5>
                <div>
                    <strong>@supplierName</strong><br />
                    @supplierAddress<br />
                    GSTIN: @supplierGSTIN<br />
                    Email: @supplierEmail<br />
                    Phone: @supplierPhone
                </div>
            </div>
            <div class="col-md-6 text-md-end">
                <h5>Company</h5>
                <div>
                    <strong>@companyName</strong><br />
                    @companyAddress<br />
                    GSTIN: @companyGSTIN<br />
                    Email: @companyEmail<br />
                    Phone: @companyPhone
                </div>
            </div>
        </div>

        <!-- Meta Info -->
        <div class="row mb-3">
            <div class="col-md-6">
                <strong>PO No:</strong> @poNumber
            </div>
            <div class="col-md-6 text-md-end">
                <strong>PO Date:</strong> @poDate
            </div>
        </div>

        <!-- Items Table -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle">
                <thead class="table-light text-center">
                    <tr>
                        <th style="width:4rem;">#</th>
                        <th>Description</th>
                        <th>HSN</th>
                        <th>Qty</th>
                        <th>Unit Price (₹)</th>
                        <th>GST %</th>
                        <th>GST Amount (₹)</th>
                        <th>Total (₹)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td class="text-center">@item.SNo</td>
                            <td>@Html.Raw(item.Description)</td>
                            <td class="text-center">@item.HSN</td>
                            <td class="text-end">@item.Qty</td>
                            <td class="text-end">@item.UnitPrice.ToString("N2")</td>
                            <td class="text-end">@item.GST%</td>
                            <td class="text-end">@item.GSTAmount.ToString("N2")</td>
                            <td class="text-end">@item.Total.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Totals -->
        <div class="row justify-content-end">
            <div class="col-md-6">
                <table class="table table-borderless">
                    <tr class="totals">
                        <td class="text-end fw-bold">Subtotal (Net):</td>
                        <td class="text-end">₹@subtotal.ToString("N2")</td>
                    </tr>
                    <tr class="totals">
                        <td class="text-end fw-bold">Total GST:</td>
                        <td class="text-end">₹@totalGST.ToString("N2")</td>
                    </tr>
                    <tr class="totals border-top">
                        <td class="text-end fw-bold">Grand Total:</td>
                        <td class="text-end fw-bold">₹@grandTotal.ToString("N2")</td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Footer -->
        <div class="row mt-5">
            <div class="col-6">
                <p class="small text-muted">* This is a system-generated purchase order.</p>
            </div>
            <div class="col-6 text-end">
                <p><strong>Authorized Signatory</strong></p>
                <div style="height:50px;"></div>
                <p class="text-muted small">For @companyName</p>
            </div>
        </div>

        <!-- Print Button -->
        <div class="text-center mt-4 no-print">
            <button class="btn btn-primary" onclick="window.print()">Print Purchase Order</button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<script type="text/javascript">
    window.onload = function () { window.print(); }
</script>