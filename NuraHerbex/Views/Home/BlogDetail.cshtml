@model Domain.ViewModel.BlogViewModel

@{
	ViewData["Title"] = "Blog Details";
	var blog = Model.NewBlog;
	var categories = Model.Categories;
	var blogCategoryIds = blog.BlogCategoryIds?.Split(',', System.StringSplitOptions.RemoveEmptyEntries) ?? new string[0];
	var categoryNames = categories.Where(c => blogCategoryIds.Contains(c.Id.ToString())).Select(c => c.Name);
}

<style>
	.article-header {
		background: #1a1d2e;
		padding: 40px 0 0 0;
	}

	.article-title {
		font-family: 'IBM Plex Sans', sans-serif;
		font-weight: 700;
		font-size: 2.2rem;
		text-align: center;
		color: White;
		margin-bottom: 18px;
	}

	.meta-date-readtime {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 18px;
		margin-bottom: 18px;
		font-size: 1rem;
	}

		.meta-date-readtime span {
			color: navajowhite;
			font-weight: 600;
		}

	.blog-main-image {
		display: block;
		margin: 0 auto 26px auto;
		width: 640px;
		max-width: 95vw;
		border-radius: 15px;
		box-shadow: 0 2px 32px rgba(0,0,0,.08);
	}

	.meta-section {
		margin-bottom: 30px;
		display: flex;
		gap: 24px;
		justify-content: center;
	}

	.meta-label {
		font-weight: 600;
		color: #555;
		margin-bottom: 2px;
		display: block;
	}

	.meta-value {
		background: #f44900;
		color: white;
		padding: 4px 12px;
		border-radius: 13px;
		font-size: 13px;
		font-weight: 500;
	}

	.article-content {
		background: #fff;
		border-radius: 16px;
		box-shadow: 0 2px 24px rgba(0, 0, 0, 0.05);
		padding: 38px 34px 36px 34px;
		max-width: 1275px;
		margin: 0 auto 32px auto;
	}

		.article-content p {
			font-size: 17px;
			line-height: 1.6;
			color: #374151;
			margin-bottom: 20px;
		}

	@@media (max-width: 900px) {
		.blog-main-image {
			width: 98vw;
		}

		.article-content {
			padding: 18px 10px;
		}
	}

	/* Center only horizontally */
	.meta-wrapper {
		display: flex;
		justify-content: center; /* horizontal center */
		width: 100%;
	}

	.meta-btn {
		background-color: #ff5722; /* button color */
		color: #fff;
		border: none;
		border-radius: 15px;
		padding: 6px 12px;
		font-size: 0.875rem;
		display: inline-flex;
		align-items: center;
		gap: 4px;
		cursor: pointer;
		margin-bottom: 1%;
	}

		/* add " /" after each span except the last one */
		.meta-btn span:not(:last-child)::after {
			content: " /";
			margin: 0 2px;
		}

</style>

<article>
	<header class="article-header">
		<h1 class="article-title">@blog.Title</h1>
		<div class="meta-wrapper">
			<button type="button" class="meta-btn">
				<span>@blog.WrittenBy</span>
				<span>@blog.CreatedAt.ToString("dd MMM, yyyy")</span>
				<span>@blog.ReadTime</span>
			</button>
		</div>
	</header>

	<img src="@blog.ImagePath" alt="Blog Cover" class="blog-main-image" />

	<div class="meta-section">
		<div>
			<span class="meta-label">Category</span>
			@foreach (var catName in categoryNames)
			{
				<span class="meta-value">@catName</span>
			}
		</div>
	</div>

	<section class="article-content">
		@Html.Raw(blog.Description)
	</section>
</article>