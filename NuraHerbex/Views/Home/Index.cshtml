                    <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
            </button>
        </div>
    </div>
</section>


<!-- Expert Insights & Tips Section -->
<section class="blog-section">
    <div class="blog-container">
        <div class="blog-header">
            <h2 class="blog-title">Expert Insights & <span class="highlight-text">Tips</span></h2>
            <p class="blog-subtitle">Stay informed with the latest research and practical advice for optimal male wellness</p>
        </div>

        <div class="blog-scroll-wrapper">
            <div class="blog-grid">
                @if (Model.BlogList != null && Model.BlogList.Any())
                {
                    foreach (var blog in Model.BlogList)
                    {
                        <div class="blog-card" style="cursor:pointer;"
                             onclick="location.href='@Url.Action("BlogDetail", "Home", new { id = blog.Id })'">
                            <div class="blog-image">
                                <img src="@(string.IsNullOrEmpty(blog.ImagePath) ? Url.Content("~/image/HomePage/default-blog.png") : Url.Content(blog.ImagePath))"
                                     alt="@blog.Title" />
                            </div>

                            <div class="blog-content">
                                <div class="blog-meta">
                                    <span class="blog-category">
                                        @(string.IsNullOrEmpty(blog.WrittenBy) ? "Wellness" : blog.WrittenBy)
                                    </span>
                                    <span class="blog-time">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                        @(string.IsNullOrEmpty(blog.ReadTime) ? "5 min read" : blog.ReadTime)
                                    </span>
                                </div>

                                <h3 class="blog-title-text">@blog.Title</h3>

                                <p class="blog-excerpt">
                                    @(blog.Description?.Length > 100
                                        ? blog.Description.Substring(0, 100) + "..."
                                        : blog.Description)
                                </p>

                                <a href="@Url.Action("BlogDetail", "Home", new { id = blog.Id })" class="blog-link">
                                    Read More
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <path d="M5 12h14M12 5l7 7-7 7" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-center">No blogs available at the moment.</p>
                }
            </div>
        </div>

        <div class="blog-cta">
            <button onclick="location.href='@Url.Action("Blog", "Home")'" class="btn-view-articles">View All Articles</button>
        </div>
    </div>
</section>


<!-- Your Next Level Starts Now Section -->
<section class="cta-section">
    <div class="cta-container">
        <div class="cta-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
                <path d="M13 2L3 14h8l-1 8 10-12h-8l1-8z" />
            </svg>
        </div>
        <h2 class="cta-title">Your next level <span class="highlight-text">starts now</span></h2>
        <p class="cta-subtitle">Don't wait another day to unlock your potential. Join thousands of men who've already made the transformation.</p>
        <div class="cta-buttons">
            <button class="btn-cta-primary" onclick="location.href='@Url.Action("Quiz", "Home")'">Take Quiz</button>
            <button class="btn-cta-secondary" onclick="location.href='@Url.Action("Shop", "Home")'">Shop Now</button>
        </div>
    </div>
</section>









