<!-- JavaScript to auto-scroll to Performance Plan on mobile -->
<script>
    // Auto-scroll to Performance Plan (2nd card) on mobile
    document.addEventListener('DOMContentLoaded', function() {
        function scrollToPerformancePlan() {
            // Check if we're on mobile (768px or less)
            if (window.innerWidth <= 768) {
                const pricingGrid = document.querySelector('.pricing-grid');
                const cards = document.querySelectorAll('.pricing-card');

                if (pricingGrid && cards.length >= 2) {
                    // Scroll to the 2nd card (Performance Plan - index 1)
                    setTimeout(function() {
                        const secondCard = cards[1];
                        const scrollPosition = secondCard.offsetLeft - pricingGrid.offsetLeft;
                        pricingGrid.scrollTo({
                            left: scrollPosition,
                            behavior: 'smooth'
                        });
                    }, 100); // Small delay to ensure layout is ready
                }
            }
        }

        // Initial scroll on page load
        scrollToPerformancePlan();

        // Re-scroll on window resize if still mobile
        let resizeTimer;
        window.addEventListener('resize', function() {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(scrollToPerformancePlan, 250);
        });
    });
</script>



