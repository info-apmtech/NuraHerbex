@* who this is for *@
<section class="who-section">
	<h2 class="who-title">Who This is For</h2>
	<div id="whoGrid">
		@if (forThisList.Any())
		{
			<div class="who-grid">
				@foreach (var item in forThisList)
				{
					var text = item ?? "";
					var bar = text.IndexOf('|');
					var heading = bar >= 0 ? text[..bar].Trim() : text.Trim();
					var desc = bar >= 0 ? text[(bar + 1)..].Trim() : "";
					var imgFile = GetWhoThisisImageFile(heading);
					var imgSrc = Url.Content("~/image/shop/" + imgFile);
					// Map heading -> icon file name
					<div class="who-card">
						<div class="who-icon">
							<img src="@imgSrc" alt="icon" loading="lazy" class="benefit-icon-img" />
						</div>
						<div class="who-head">@heading</div>
						<div class="who-desc">@Html.Raw(desc.Replace("\n", "<br>"))</div>
					</div>
				}
			</div>
		}
		else
		{
			<p class="text-muted">No audience information available for this product.</p>
		}
	</div>
</section>
<section class="shop-testimonials-section">
	<h2 class="shop-testimonials-title">What our customers Say</h2>

	<div class="shop-testimonials-rating-row">
		<span class="shop-stars">★★★★★</span>
		<span class="shop-score">
			@(Model.FeedbackList.Any()
						? Math.Round(Model.FeedbackList.Average(f => f.RatingCount), 1) + " Out of 5"
						: "0 Out of 5")
		</span>

	</div>

	<div class="shop-testimonials-meta">
		Based on @Model.FeedbackList.Count + " Verified Reviews"
	</div>

	<div class="shop-testimonials-wrapper">


		<div class="shop-testimonials-carousel">
			@foreach (var fb in Model.FeedbackList)
			{
				<div class="shop-testimonials-card">
					<div class="shop-testimonial-meta">
						<div class="shop-avatar">
							@(fb.CustomerName.Length >= 2 ? fb.CustomerName.Substring(0, 2).ToUpper() : fb.CustomerName.ToUpper())
						</div>
						<div>
							<div class="shop-name">@fb.CustomerName</div>
							<div class="shop-verified">
								Verified Purchase <span class="shop-date">@fb.SubmittedAt.ToString("MMM dd, yyyy")</span>
							</div>
						</div>
					</div>
					<div class="shop-stars">
						@for (int i = 0; i < fb.RatingCount; i++)
						{
							<span>★</span>
						}
					</div>
					<div class="shop-text">
						@fb.Message
					</div>
				</div>
			}
		</div>
	</div>
</section>



