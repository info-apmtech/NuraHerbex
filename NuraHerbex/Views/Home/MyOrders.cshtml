@using Domain.Models
@model Domain.ViewModel.OrderListViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Orders";

    var orderDetails = ViewBag.OrderDetails as List<Domain.Models.OrderDetail>;
    var products = ViewBag.Products as List<Domain.Models.Product>;
    var userId = ViewBag.UserId as string ?? "00000000-0000-0000-0000-000000000000";

    var feedbackByOrder = ViewBag.FeedbackByOrder as Dictionary<int, Domain.ViewModel.FeedbackViewModel> ?? new Dictionary<int, Domain.ViewModel.FeedbackViewModel>();

    string GetStatusClass(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Delivered => "delivered",
            OrderStatus.Cancelled => "cancelled",
            OrderStatus.OrderPlaced => "in-progress",
            OrderStatus.Packed => "in-progress",
            OrderStatus.Shipped => "in-progress",
            OrderStatus.OutForDelivery => "in-progress",
            _ => "unknown"
        };
    }

    string GetStatusText(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.OrderPlaced => "Order Placed",
            OrderStatus.Packed => "Packed",
            OrderStatus.Shipped => "Shipped",
            OrderStatus.OutForDelivery => "Out For Delivery",
            OrderStatus.Delivered => "Delivered",
            OrderStatus.Cancelled => "Cancelled",
            _ => status.ToString()
        };
    }
    var returnedOrderIds = ViewBag.ReturnedOrderIds as List<int> ?? new List<int>();
}

<div class="orders-layout">
    @Html.Partial("_UserSidebar")
    <div class="orders-main">
        <h2 class="orders-headline">My Orders</h2>
        <p class="orders-subhead">Track and Manage your orders</p>

        <div class="orders-tabs">
            <button class="orders-tab active">All</button>
            <button class="orders-tab">In Progress</button>
            <button class="orders-tab">Delivered</button>
            <button class="orders-tab">Cancelled</button>
        </div>

        <div class="orders-list">
            @if (Model?.Orders != null && Model.Orders.Any())
            {
                foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate))
                {
                    var details = orderDetails?.Where(d => d.OrderId == order.Id).ToList() ?? new List<Domain.Models.OrderDetail>();
                    var statusClass = GetStatusClass(order.Status);
                    var statusText = GetStatusText(order.Status);

                    var hasFeedback = feedbackByOrder.ContainsKey(order.Id) ;
                    var feedback = hasFeedback ? feedbackByOrder[order.Id] : null;

                    <div class="orders-card" data-status="@statusClass">
                        <div class="orders-card-header-container">
                            <div class="orders-card-headerrow">
                                <div class="orders-card-id-status">
                                    <span class="orders-card-id">Order ORD-@order.Id</span>
                                    <span class="orders-card-status @statusClass">@statusText</span>
                                </div>
                                <div class="orders-card-date">Placed on @order.OrderDate.ToString("MMMM dd, yyyy")</div>
                            </div>

                            <div class="orders-totalbar">
                                <span class="orders-card-label">Total Amount</span>
                                <span class="orders-card-amount">@order.Total.ToString("C")</span>
                            </div>
                        </div>

                        @foreach (var detail in details)
                        {
                            var product = products?.FirstOrDefault(p => p.Id == detail.ProductId);
                            <div class="orders-card-bodyrow">
                                <img class="orders-card-img" src="@(product?.ProductImages ?? "~/image/userSidebar/default.png")" alt="@product?.ProductName" />
                                <div class="orders-card-desc">
                                    <div class="orders-card-title">@product?.ProductName</div>
                                    <div class="orders-card-qty">Quantity: @detail.Quantity</div>
                                </div>
                                <div class="orders-card-single">@detail.UnitPrice.ToString("C")</div>
                            </div>
                        }

                        <div class="orders-card-actions">
                            <button class="orders-ghost-btn" onclick="window.location.href='@Url.Action("Invoice", "Home", new { orderId = order.Id })'">View Invoice</button>

                            <button class="orders-ghost-btn"
                                    onclick="window.location.href='/Home/TrackOrder?orderId=@order.Id'">
                                <img class="orders-btn-icon" src="~/image/userSidebar/Group.png" alt="Track" />Track Order
                            </button>

                            @switch (order.Status)
                            {
                                case OrderStatus.Delivered:
                                    var isReturned = returnedOrderIds.Contains(order.Id);
                                    if (!isReturned)
                                    {
                                        <button type="button"
                                                class="orders-ghost-btn open-return"
                                                data-order-id="@order.Id"
                                                data-order-number="ORD-@order.Id">
                                            <img class="orders-btn-icon" src="~/image/userSidebar/Vector.png" alt="Return" />
                                            Return Item
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="orders-ghost-btn"
                                                disabled>
                                            <img class="orders-btn-icon" src="~/image/userSidebar/Vector.png" alt="Return" />
                                            Return Requested
                                        </button>
                                    }
                                    <button class="orders-buyagain">Buy Again</button>
                                    <button class="orders-ghost-btn open-feedback"
                                            data-order-id="@order.Id"
                                            data-customer-id="@userId"
                                            data-rating="@(hasFeedback ? feedback.RatingCount.ToString() : "0")"
                                            data-message="@(hasFeedback ? feedback.Message : "")">
                                        <img class="orders-btn-icon" src="~/image/homepage/feedback1.svg" alt="Feedback" />
                                        @(hasFeedback ? "Edit Feedback" : "Feedback")
                                    </button>
                                    break;

                                case OrderStatus.Cancelled:
                                    <button class="orders-buyagain">Buy Again</button>
                                    break;

                                case OrderStatus.OrderPlaced:
                                    <form method="post" asp-action="CancelOrder" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@order.Id" />
                                        <button type="submit" class="orders-ghost-btn text-danger">
                                            Cancel Order
                                        </button>
                                    </form>
                                    break;

                                default:
                                    @* For in-progress statuses, no extra buttons *@
                                    break;
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <p>No orders found for your account.</p>
            }
        </div>
    </div>
</div>

<!-- FEEDBACK POPUP  -->
<div class="cart-popup" id="feedbackPopup" style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" id="fbOrderId" value="0" />
    <input type="hidden" id="fbCustomerId" value="@userId" />

    <div class="cart-header">
        <span>Rate Your Experience</span>
        <span class="close-btn" data-close="#feedbackPopup">&times;</span>
    </div>

    <div class="cart-content" style="display:block; gap:16px">
        <div class="rating-stars" role="radiogroup" aria-label="Rate from 1 to 5">
            @for (int i = 1; i <= 5; i++)
            {
                <button type="button" class="star" data-val="@i" aria-label="@i star">★</button>
            }
            <span class="rating-hint" style="margin-left:8px;color:#888"></span>
        </div>

        <label for="fbMessage" class="sr-only">Feedback</label>
        <textarea id="fbMessage" class="cart-textarea" rows="4" placeholder="Tell us more (optional)"></textarea>
    </div>

    <div class="cart-footer">
        <button type="button" class="checkout-btn" id="btnSubmitFeedback">Submit</button>
    </div>
</div>

<!--My Returns-->
<div class="cart-popup" id="returnPopup" style="display:none">
    <form asp-action="RequestReturn"
          asp-controller="Home"
          method="post"
          id="returnForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="OrderId" id="retOrderId" />

        <div class="cart-header">
            <span>Return Item</span>
            <span class="close-btn" data-close="#returnPopup">&times;</span>
        </div>

        <div class="cart-content" style="display:block; gap:16px">
            <div>
                <div style="font-weight:600;color:#444;">
                    Order: <span id="retOrderNumberLabel"></span>
                </div>
            </div>

            <textarea id="retReason"
                      name="Reason"
                      class="cart-textarea"
                      rows="4"
                      placeholder="Tell us why you are returning this product"
                      required></textarea>
        </div>

        <div class="cart-footer">
            <button type="submit" class="checkout-btn">Submit Return Request</button>
        </div>
    </form>
</div>

<script>
    // Handle Return Item button clicks
    document.addEventListener('click', function (e) {
        const returnBtn = e.target.closest('.open-return');
        if (returnBtn) {
            const orderId = returnBtn.dataset.orderId;
            const orderNumber = returnBtn.dataset.orderNumber;

            console.log('Opening return popup for:', orderId, orderNumber);

            document.getElementById('retOrderId').value = orderId;
            document.getElementById('retOrderNumberLabel').textContent = orderNumber;
            document.getElementById('retReason').value = '';

            const popup = document.getElementById('returnPopup');
            popup.style.display = 'block';
        }

        // Close buttons for any popup using data-close
        if (e.target.matches('.close-btn')) {
            const target = e.target.getAttribute('data-close');
            if (target) {
                const popup = document.querySelector(target);
                if (popup) popup.style.display = 'none';
            }
        }
    });

    // Optional: click outside to close *return* popup (if you want)
    window.addEventListener('click', function (e) {
        const popup = document.getElementById('returnPopup');
        if (!popup) return;

        // If you ever wrap returnPopup in a backdrop, adjust this condition
        if (e.target === popup) {
            popup.style.display = 'none';
        }
    });
</script>






<script>
    window.AF_TOKEN = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    // Tabs filtering (unchanged)
    document.querySelectorAll('.orders-tab').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.orders-tab').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const status = btn.textContent.toLowerCase().replace(" ", "-");
            document.querySelectorAll('.orders-card').forEach(card => {
                card.style.display = (status === 'all' || card.dataset.status === status) ? 'block' : 'none';
            });
        });
    });

    let selectedRating = 0;

    // Utility to update stars colors based on selectedRating
    function updateStarColors() {
        document.querySelectorAll('.rating-stars .star').forEach(s => {
            s.style.color = s.dataset.val <= selectedRating ? 'gold' : '#ccc';
        });
    }

    // Feedback popup open/close and prefill
    document.addEventListener('click', e => {
        const fbBtn = e.target.closest('.open-feedback');
        if (fbBtn) {
            document.getElementById('fbOrderId').value = fbBtn.dataset.orderId;
            document.getElementById('fbCustomerId').value = fbBtn.dataset.customerId;

            // Prefill rating and message if any
            selectedRating = parseInt(fbBtn.dataset.rating || "0");
            document.getElementById('fbMessage').value = fbBtn.dataset.message || "";

            updateStarColors();

            showFeedbackPopup();
        }

        const closeBtn = e.target.closest('[data-close="#feedbackPopup"]');
        if (closeBtn) hideFeedbackPopup();
    });

    function showFeedbackPopup() {
        const popup = document.getElementById('feedbackPopup');
        popup.style.display = 'block';
        document.body.classList.add('showing-feedback');
        popup.querySelector('.star')?.focus();
    }

    function hideFeedbackPopup() {
        const popup = document.getElementById('feedbackPopup');
        popup.style.display = 'none';
        document.body.classList.remove('showing-feedback');
        // Do not reset selectedRating or message here to allow edit continuity
    }

    // Keyboard escape to close popup
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') hideFeedbackPopup();
    });

    // Star rating click event
    document.querySelectorAll('.rating-stars .star').forEach(star => {
        star.addEventListener('click', () => {
            selectedRating = parseInt(star.dataset.val);
            updateStarColors();
        });
    });

    // Submit feedback
    document.getElementById('btnSubmitFeedback').addEventListener('click', async () => {
        const orderId = parseInt(document.getElementById('fbOrderId').value);
        const customerId = document.getElementById('fbCustomerId').value;
        const message = document.getElementById('fbMessage').value;

        if (selectedRating === 0) {
            alert('Please select a rating.');
            return;
        }

        const payload = { OrderId: orderId, CustomerId: customerId, Rating: selectedRating, Message: message };

        try {
            const res = await fetch('/Home/SubmitFeedback', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': window.AF_TOKEN
                },
                body: JSON.stringify(payload)
            });

            if (!res.ok) {
                const errText = await res.text();
                throw new Error(errText || 'Failed to submit feedback');
            }

            alert('Feedback submitted successfully!');
            hideFeedbackPopup();

            // Update button to "Edit Feedback" and store rating/message data attributes
            let btn = document.querySelector('.open-feedback[data-order-id="' + orderId + '"]');
            if (btn) {
                btn.innerHTML = '<img class="orders-btn-icon" src="/image/homepage/feedback1.svg" alt="Feedback" /> Edit Feedback';
                btn.dataset.rating = selectedRating;
                btn.dataset.message = message;
            }
        } catch (err) {
            console.error(err);
            alert('Error submitting feedback: ' + err.message);
        }
    });
</script>






