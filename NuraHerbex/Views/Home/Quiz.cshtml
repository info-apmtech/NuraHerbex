@{
    ViewData["Title"] = "Quiz";
}


<!-- Blog Hero Section -->
<section class="blog-hero-section">
    <div class="blog-hero-container">
        <div class="blog-hero-content">
            <h1 class="blog-hero-title" style="font-size: 2rem;">
                <span class="highlight-orange">Take the Quiz to Discover the Pure,</span> Powerful Ingredients That Fuel Your Strength and Wellness.
            </h1>
            <p class="blog-hero-description">
                Answer a few quick questions and unlock personalized wellness insights designed to match your <br />body's unique needs.
            </p>
        </div>

    </div>
</section>
<section class="quality-safety-section">
    <div class="quality-safety-container">
        <div class="quality-header">
            <h2 class="quality-title">Discover Your <span class="highlight-orange"> Personalized Wellness Level</span></h2>
            <p class="quality-subtitle" style="max-width:none;">
                Take a short quiz with 4–6 quick questions to uncover your ideal wellness plan. Based on your answers, we'll recommend the <br />right
                level of support — and guide you toward subscribing or booking a free doctor consultation.
            </p>
        </div>
    </div>
</section>
<section class="quiz-section">
    <div class="quiz-wrapper">
        <div class="quiz-header">
            <h2 class="quiz-title">Quiz</h2>
        </div>
        <div class="container">
            <div class="quiz-box">
                <div class="quiz-question">
                    <span class="quiz-badge">Q1</span>  <p>How often do you exercise per week?</p>
                </div>

                <div class="quiz-options">
                    <button class="quiz-option">0-1 Time</button>
                    <button class="quiz-option active">2-3 Times</button>
                    <button class="quiz-option">4-5 Times</button>
                </div>

                <div class="quiz-footer">
                    <span class="quiz-progress">Question 1 of 5</span>
                    <button class="next-btn">Next</button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Result Section -->
<section class="result-section">
    <h2>Your Personalized <span class="highlight">Path to Wellness</span></h2>
    <p>Based on your quiz results, here are your next steps:</p>

    <div class="consult-card">
        <h3>Book a Free Consultation</h3>
        <p>
            Speak directly with our certified wellness doctor to understand your results better, discuss any health concerns, and receive 
            <br />personalized guidance tailored to your lifestyle and goals all at no extra cost. Take this opportunity to clarify doubts, explore <br />the right wellness products for your needs, and get expert recommendations designed to support your energy, strength, and <br />overall well-being.
        </p>
        <button onclick="location.href='@Url.Action("Consultation", "Home")'" class="book-btn">Book Free Consult</button>
    </div>
</section>

<!-- Subscription Section -->
<section class="subscribe-section">
    <h2>Your performance upgrade.</h2>
    <h3><span class="highlight">Starts Today.</span></h3>
    <p>
        Don’t wait — choose your plan and join the thousands of men who refuse to settle for average.
    </p>
    <button class="subscribe-action-btn">Subscribe Now</button>
</section>
