@using Domain.Models
@model List<QuizCategory>
@{
    ViewData["Title"] = "Quiz";
}


<!-- Blog Hero Section -->
<section class="blog-hero-section">
    <div class="blog-hero-container">
        <div class="blog-hero-content">
            <h1 class="blog-hero-title" style="font-size: 2rem;">
                <span class="highlight-orange">Take the Quiz to Discover the Pure,</span> Powerful Ingredients That Fuel Your Strength and Wellness.
            </h1>
            <p class="blog-hero-description">
                Answer a few quick questions and unlock personalized wellness insights designed to match your <br />body's unique needs.
            </p>
        </div>

    </div>
</section>
<section class="quality-safety-section">
    <div class="quality-safety-container">
        <div class="quality-header">
            <h2 class="quality-title">Discover Your <span class="highlight-orange"> Personalized Wellness Level</span></h2>
            <p class="quality-subtitle" style="max-width:none;">
                Take a short quiz with 4–6 quick questions to uncover your ideal wellness plan. Based on your answers, we'll recommend the <br />right
                level of support — and guide you toward subscribing or booking a free doctor consultation.
            </p>
        </div>
    </div>
</section>
<section class="quiz-section">
    <div class="quiz-wrapper">
        <div class="quiz-header">
            <h2 class="quiz-title">Quiz</h2>
        </div>

        <div class="container">
            <div class="quiz-box" id="quiz-container">

                <div class="quiz-question">
                    @* <p>Select a Quiz Category</p> *@
                    <p>Your Quiz, Your Choice — Pick a Category</p>
                </div>

                <div class="quiz-options">
                    @foreach (var category in Model.OrderBy(c => c.Id))
                    {
                        <button class="quiz-option category-btn" data-category-id="@category.Id">
                            @category.Name
                        </button>
                    }
                </div>

            </div>
        </div>
    </div>
</section>

<script>
        let currentQuestionIndex = 0;
    let totalPoints = 0;
    let selectedCategoryId = null;

    let answers = {}; // Stores selected option by question index

    // Start quiz when clicking a category
    document.querySelectorAll('.category-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            selectedCategoryId = btn.dataset.categoryId;
            currentQuestionIndex = 0;
            totalPoints = 0;
            answers = {};
            await loadQuestion();
        });
    });

    async function loadQuestion() {
        try {
            const response = await fetch(`/Home/GetQuestion?categoryId=${selectedCategoryId}&questionIndex=${currentQuestionIndex}&totalPoints=${totalPoints}`);
            const data = await response.json();

            const container = document.getElementById('quiz-container');
            container.innerHTML = '';

            if (data.quizFinished) {
                window.location.href = data.redirectUrl;
                return;
            }

            const savedPoints = answers[currentQuestionIndex] ?? null;

            const html = `
                <div class="quiz-question">
                    <span class="quiz-badge">Q${data.currentQuestionIndex + 1}</span>
                    <p>${data.currentQuestion.QuestionText}</p>
                </div>

                <div class="quiz-options">
                    ${data.options.map(o => `
                        <button class="quiz-option ${savedPoints === o.Points ? 'active' : ''}"
                                data-points="${o.Points}">
                            ${o.OptionText}
                        </button>
                    `).join('')}
                </div>

                <div class="quiz-footer">
                    <span class="quiz-progress">
                        Question ${data.currentQuestionIndex + 1} of ${data.totalQuestions}
                    </span>

                    <div class="quiz-nav">
                        <button class="nav-btn prev-btn" id="prevBtn" ${currentQuestionIndex === 0 ? 'disabled' : ''}>
                            Previous
                        </button>
                        <button class="nav-btn next-btn" id="nextBtn">
                            Next
                        </button>
                    </div>
                </div>
            `;

            container.innerHTML = html;

            // Option selection
            document.querySelectorAll('.quiz-option').forEach(option => {
                option.addEventListener('click', () => {
                    document.querySelectorAll('.quiz-option').forEach(o => o.classList.remove('active'));
                    option.classList.add('active');

                    answers[currentQuestionIndex] = Number(option.dataset.points);
                });
            });

            // NEXT BUTTON — requires selection
            document.getElementById("nextBtn").onclick = () => {
                if (answers[currentQuestionIndex] == null) {
                    alert("Please select an option before continuing.");
                    return;
                }

                currentQuestionIndex++;
                updateTotalPoints();
                loadQuestion();
            };

            // PREVIOUS BUTTON
            document.getElementById("prevBtn").onclick = () => {
                currentQuestionIndex--;
                loadQuestion();
            };

        } catch (error) {
            console.error("Error loading question", error);
            alert("Failed to load question.");
        }
    }

    function updateTotalPoints() {
        totalPoints = Object.values(answers).reduce((a, b) => a + b, 0);
    }

</script>

