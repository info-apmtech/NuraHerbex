@using Domain.ViewModel
@model OrderConfirmationViewModel

<div class="confirmation-wrapper">

    <div class="success-icon">
        <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="16 8 11 13 8 10"></polyline>
        </svg>
    </div>

    <h1 class="confirmation-title">Thank You!</h1>
    <p class="confirmation-subtitle">Your Order Has Been Placed Successfully</p>

    <div class="order-card">
        <div class="order-grid">
            <div>
                <span>Order</span><br />
                @Model.Order.Id
            </div>
            <div>
                <span>Order Date</span><br />
                @Model.Order.OrderDate.ToString("dd/MM/yyyy")
            </div>
            <div>
                <span>Estimated Delivery</span><br />
                <span class="delivery-date">
                    @Model.Order.OrderDate.AddDays(7).ToString("dd/MM/yyyy")
                </span>
            </div>
            <div>
                <span>Payment Method</span><br />
                UPI
            </div>
        </div>

        <div class="order-items-label">Order Items</div>

        @foreach (var item in Model.Details)
        {
            <div class="order-item-box">
                <img src="/image/shop/Stamix1.png" alt="Product Image" />

                <div>
                    <p><strong>Quantity :</strong> @item.Quantity</p>
                    <p><strong>@item.productName</strong></p>
                    <p style="color:#ff4500;font-weight:700;">
                        ₹ @item.UnitPrice
                    </p>
                </div>

                <div>
                    <div class="order-amount-label">Total Amount</div>
                    <div class="order-amount-total">
                        ₹ @(item.Quantity * item.UnitPrice)
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="order-actions">
        <a href="/Home/TrackOrder?orderId=@Model.Order.Id" class="order-btn track-btn">
            Track Order
        </a>
        <a href="@Url.Action("Invoice", "Home", new { orderId = Model.Order.Id })"
           class="order-btn invoice-btn">
            Download Invoice
        </a>

        <button class="order-btn shopping-btn" onclick="window.location.href='/'">
            Continue Shopping
        </button>
    </div>

    <div class="email-box">
        <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <polyline points="3 7 12 13 21 7"></polyline>
        </svg>

        <div>
            <p>Confirmation Email Sent</p>
            <p>
                We've sent a confirmation email to
                <strong>@Model.Email</strong>
                with your order details.
            </p>
        </div>
    </div>

</div>


