	/* .synergy-section */
	.synergy-section {
		background-color: #f2f6ef;
		padding: 60px 99px;
		font-family: Helvetica, Arial, sans-serif;
		margin-bottom: 2px;
	}

	.synergy-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px; /* spacing between text and image */
		flex-wrap: nowrap; /* keep all in one line */
	}

	.synergy-title {
		display: flex;
		align-items: center;
		gap: 15px; /* space between h2 and p */
	}

		.synergy-title h2 {
			color: #215c03;
			font-size: 24px;
			font-weight: bold;
			margin: 0; /* remove default spacing */
			white-space: nowrap; /* prevent wrapping */
		}

		.synergy-title p {
			font-size: 16px;
			line-height: 1.4;
			color: #333;
			margin: 0; /* keep tight alignment */
		}

	.synergy-image {
		width: 100px;
		height: auto;
		flex-shrink: 0;
	}


	.synergy-card {
		background-color: #e4ece0;
		border-radius: 20px;
		display: flex;
		justify-content: space-between;
		padding: 40px;
		box-sizing: border-box;
	}

	.synergy-column {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		flex: 1;
		gap: 20px;
	}

	.synergy-item {
		display: flex;
		align-items: center;
		gap: 16px;
	}

		.synergy-item img {
			width: 48px;
			height: 48px;
			object-fit: contain;
		}

		.synergy-item p {
			font-size: 16px;
			color: #4d4d4d;
			margin: 0;
		}

		.synergy-item strong {
			color: #000;
		}

	.synergy-separator {
		width: 100%;
		height: 1px;
		background-color: #fff;
	}

	.vertical-separator {
		width: 1px;
		background-color: #fff;
		margin: 0 30px;
	}

	@@media (max-width: 1024px) {
		.synergy-section {
