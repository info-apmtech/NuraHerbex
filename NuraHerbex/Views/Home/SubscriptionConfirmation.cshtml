@using Domain.ViewModel
@model SubscriptionConfirmationViewModel

<div class="confirmation-wrapper">

    <div class="success-icon">
        <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"></circle>
            @if (Model.IsSuccess)
            {
                <polyline points="16 8 11 13 8 10"></polyline>
            }
            else
            {
                <line x1="9" y1="9" x2="15" y2="15"></line>
                <line x1="15" y1="9" x2="9" y2="15"></line>
            }
        </svg>
    </div>

    <h1 class="confirmation-title">
        @(Model.IsSuccess ? "Thank You!" : "Payment Failed")
    </h1>
    <p class="confirmation-subtitle">
        @Model.Message
    </p>

    <div class="order-card">
        <div class="order-grid">
            <div>
                <span>Subscription Amount</span><br />
                ₹ @Model.Amount.ToString("N2")
            </div>
            <div>
                <span>Status</span><br />
                @(Model.IsSuccess ? "Success" : "Failed")
            </div>
            <div>
                <span>Payment Method</span><br />
                @Model.PaymentMethod
            </div>
            <div>
                <span>Email</span><br />
                @Model.Email
            </div>
        </div>

        <div class="order-items-label">Subscription Details</div>

        <div class="order-item-box">
            @* <img src="/image/shop/Stamix1.png" alt="Plan Image" /> *@

            <div>
                <p><strong>Subscription</strong></p>
                <p>Selected Plan</p>
                <p style="color:#ff4500;font-weight:700;">
                    ₹ @Model.Amount.ToString("N2")
                </p>
            </div>

            <div>
                <div class="order-amount-label">Total</div>
                <div class="order-amount-total">
                    ₹ @Model.Amount.ToString("N2")
                </div>
            </div>
        </div>
    </div>

    <div class="order-actions">
        <button class="order-btn shopping-btn" onclick="window.location.href='/'">
            Continue Shopping
        </button>
    </div>

    <div class="email-box">
        <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <polyline points="3 7 12 13 21 7"></polyline>
        </svg>

        <div>
            <p>@(Model.IsSuccess ? "Confirmation Email Sent" : "Check Your Email")</p>
            <p>
                We've sent an email to
                <strong>@Model.Email</strong>
                with the details of your subscription payment.
            </p>
        </div>
    </div>

</div>

<style>
    .confirmation-wrapper {
        max-width: 900px;
        margin: 40px auto;
        padding: 20px;
        font-family: 'Inter', sans-serif;
        color: #333;
    }

    .success-icon {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
    }

        .success-icon svg {
            width: 85px;
            height: 85px;
            stroke: #22c55e;
        }

    .confirmation-title {
        text-align: center;
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .confirmation-subtitle {
        text-align: center;
        font-size: 16px;
        color: #777;
        margin-bottom: 35px;
    }

    .order-card {
        border: 1px solid #ddd;
        border-radius: 12px;
        padding: 30px;
        background: #fff;
        margin-bottom: 25px;
    }

    .order-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        row-gap: 20px;
        margin-bottom: 25px;
        color: #555;
    }

        .order-grid div span {
            font-weight: 600;
            color: #333;
        }

    .delivery-date {
        color: #ff4500;
        font-weight: 700;
    }

    .order-items-label {
        font-weight: 700;
        font-size: 16px;
        margin-bottom: 10px;
        color: #333;
    }

    .order-item-box {
        background: #fff7f2;
        padding: 20px;
        border-radius: 10px;
        display: grid;
        grid-template-columns: 120px 1fr 120px;
        align-items: center;
        gap: 15px;
    }

        .order-item-box img {
            width: 110px;
            height: auto;
            border-radius: 6px;
        }

    .order-amount-label {
        grid-column: 3;
        text-align: right;
        font-weight: 600;
        color: #555;
        margin-bottom: 5px;
    }

    .order-amount-total {
        font-size: 20px;
        font-weight: 700;
        color: #ff4500;
        text-align: right;
    }

    .order-actions {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-top: 25px;
    }

    .order-btn {
        padding: 12px 25px;
        border-radius: 6px;
        border: none;
        font-size: 15px;
        cursor: pointer;
        font-weight: 600;
        min-width: 140px;
        display: flex;
        align-items: center;
        gap: 8px;
        justify-content: center;
    }

    .track-btn {
        background: #ff5722;
        color: #fff;
    }

    .invoice-btn {
        background: #fff;
        border: 2px solid #ff5722;
        color: #ff5722;
    }

    .shopping-btn {
        background: #fff;
        border: 2px solid #333;
        color: #333;
    }

    .email-box {
        margin-top: 25px;
        background: #e9f3ff;
        padding: 20px;
        border-radius: 10px;
        display: flex;
        gap: 15px;
        border-left: 4px solid #1e90ff;
        align-items: center;
        font-size: 14px;
        color: #555;
    }

        .email-box svg {
            width: 28px;
            height: 28px;
            stroke: #1e90ff;
            flex-shrink: 0;
        }

        .email-box div p:first-child {
            font-weight: 700;
            color: #333;
            margin: 0;
        }

        .email-box div p:last-child {
            margin: 3px 0 0 0;
        }

</style>
