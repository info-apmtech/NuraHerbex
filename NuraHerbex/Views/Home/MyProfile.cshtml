
@model Domain.ViewModel.UserProfileViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var countrySelectList = new SelectList(Model.Countries, "Id", "CountryName", Model.AddressDetail?.Country);
    var stateSelectList = new SelectList(Model.States, "Id", "StateName", Model.AddressDetail?.State);
}

<div class="profile-layout">
    @Html.Partial("_UserSidebar")
    <div class="profile-main-content">
        <h2 class="profile-title">My Profile</h2>
        <p class="profile-subtitle">Manage your personal information and addresses</p>

        <!-- Personal Information Card -->
        <div class="profile-card">
            <div class="profile-card-title">Personal Information</div>

            <form asp-action="UpdateProfile" method="post" class="profile-form">
                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                <div class="form-row">
                    <label>
                        First Name
                        <input asp-for="FirstName" />
                    </label>
                    <label>
                        Last Name
                        <input asp-for="LastName" />
                    </label>
                </div>
                <div class="form-row row-inline">
                    <label>
                        Phone
                        <input asp-for="PhoneNumber" />
                    </label>
                    <label>
                        Email
                        <input asp-for="Email" />
                    </label>
                </div>

                <div class="form-actions">
                    <button type="submit" class="orange-btn">Save Changes</button>
                </div>
            </form>
        </div>
        <!-- Saved Addresses Card -->
        <div class="profile-card address-card">
            <div class="profile-card-title-row">
                <span class="profile-card-title">Saved Addresses</span>
                <button type="button" class="orange-btn add-new" onclick="document.getElementById('addAddressPopup').style.display='block'"><span>+</span> Add New</button>
            </div>
            <div class="saved-addresses-list">
                @foreach (var addr in Model.Addresses)
                {
                    <div class="address-block">
                        @if (addr.IsDefault)
                        {
                            <span class="address-badge">Default</span>
                        }
                        <span class="address-name">@addr.Name</span>
                        <div class="address-detail">
                            @addr.Location <br />
                            @addr.DoorNo <br />
                            @addr.Address <br />
                            Pincode: @addr.Pincode <br />
                            Phone: @addr.PhoneNumber
                        </div>
                        <div class="address-actions">
                            <form asp-action="MyProfile" method="get" style="display:inline">
                                <input type="hidden" name="id" value="@addr.Id" />
                                <button type="submit" class="icon-btn" title="Edit"><img src="~/image/userSidebar/EditIcon.png" alt="Edit" /></button>
                            </form>
                            <form asp-action="DeleteAddress" method="post" style="display:inline" onsubmit="return confirm('Are you sure to delete this address?');">
                                <input type="hidden" name="id" value="@addr.Id" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="icon-btn" title="Delete"><img src="~/image/userSidebar/Deleteicon.png" alt="Delete" /></button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Add/Edit Address Popup -->
        <div id="addAddressPopup"
             class="modal-popup"
             style="display:@(Model.AddressDetail.Id > 0 ? "block" : "none");">
            <div class="popup-content">
                <span class="close-btn" onclick="document.getElementById('addAddressPopup').style.display='none'">&times;</span>
                <h3>@(Model.AddressDetail.Id > 0 ? "Edit Address" : "Add New Address")</h3>

                <form asp-action="MyProfile" method="post" class="profile-form">
                    @Html.AntiForgeryToken()
                    <input asp-for="AddressDetail.Id" type="hidden" />
                    <input asp-for="AddressDetail.UserId" type="hidden" />

                    <!-- Name + Location -->
                    <div class="form-row row-inline">
                        <label>
                            Name
                            <input asp-for="AddressDetail.Name" required />
                        </label>
                        <label>
                            Location
                            <input asp-for="AddressDetail.Location" required />
                        </label>
                    </div>

                    <!-- Door No + Phone -->
                    <div class="form-row row-inline">
                        <label>
                            Door No
                            <input asp-for="AddressDetail.DoorNo" required />
                        </label>
                        <label>
                            Phone Number
                            <input asp-for="AddressDetail.PhoneNumber" required />
                        </label>
                    </div>

                    <!-- Address -->
                    <div class="form-row">
                        <label style="width:100%;">
                            Address
                            <textarea asp-for="AddressDetail.Address" required></textarea>
                        </label>
                    </div>

                    <!-- Country + State -->
                    <div class="form-row row-inline">
                        <label>
                            Country
                            <select asp-for="AddressDetail.Country"
                                    asp-items="@(new SelectList(Model.Countries, "Id", "CountryName", Model.AddressDetail?.Country))"
                                    class="form-control"
                                    required>
                                <option value="">-- Select Country --</option>
                            </select>
                        </label>
                        <label>
                            State
                            <select asp-for="AddressDetail.State"
                                    asp-items="@(new SelectList(Model.States, "Id", "StateName", Model.AddressDetail?.State))"
                                    class="form-control"
                                    required>
                                <option value="">-- Select State --</option>
                            </select>
                        </label>
                    </div>

                    <!-- Pincode + Is Default -->
                    <div class="form-row row-inline">
                        <label>
                            Pincode
                            <input asp-for="AddressDetail.Pincode" required />
                        </label>
                        <label class="checkbox-inline">
                            Is Default
                            <input asp-for="AddressDetail.IsDefault" type="checkbox" />
                        </label>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="orange-btn">Save</button>
                        <button type="button" class="orange-btn" onclick="document.getElementById('addAddressPopup').style.display='none'">Cancel</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Account Security Card -->
        <div class="profile-card account-card">
            <div class="profile-card-title">Account Security</div>
            <div class="security-valuebox-row">
                <div class="security-row-texts">
                    <span class="security-label">Password</span>
                    <span class="security-hint">Last changed 3 months ago</span>
                </div>
                <button class="orange-btn security-btn">Change Password</button>
            </div>
        </div>

    </div>
</div>

<style>
    .modal-popup {
        position: fixed;
        z-index: 999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.5);
    }

    .popup-content {
        background-color: #fff;
        margin: 10% auto;
        padding: 20px;
        width: 50%;
        border-radius: 5px;
        position: relative;
    }

    .close-btn {
        position: absolute;
        top: 10px;
        right: 15px;
        font-size: 28px;
        font-weight: bold;
        color: #888;
        cursor: pointer;
    }

    .form-row {
        margin-bottom: 15px;
    }

    .row-inline {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

        .row-inline label {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

    textarea {
        width: 100%;
        resize: vertical;
    }

    .checkbox-inline {
        display: flex;
        align-items: center;
        gap: 10px;
    }

</style>



<style>
    .profile-layout {
        display: flex;
        gap: 2.5rem;
        align-items: flex-start;
        background: #fff;
        min-height: 100vh;
    }

    .profile-main-content {
        flex: 1;
        padding: 32px 0 24px 0;
    }

    .profile-title {
        font-size: 1.17rem;
        font-weight: 600;
        margin-bottom: 2px;
        color: #222;
    }

    .profile-subtitle {
        font-size: 0.98rem;
        color: #b2b2b2;
        margin-bottom: 19px;
    }

    .profile-card {
        padding: 22px 18px 22px 18px;
        border: 3px solid #ffedde;
        border-radius: 14px;
        background: #fff;
        margin-bottom: 36px;
        box-shadow: none;
        margin-right: 28px;
    }

    .profile-card-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #181818;
        margin-bottom: 18px;
    }

    .profile-card-title-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .address-card {
        background: #fff8ef;
        border-color: #ffecd8;
        margin-bottom: 35px;
    }

    .profile-form .form-row {
        margin-bottom: 13px;
    }

    .profile-form label {
        display: block;
        font-size: 0.98rem;
        font-weight: 500;
        color: #242424;
        margin-bottom: 5px;
    }

    .profile-form input[type="text"] {
        width: 100%;
        border: 1.2px solid #f3eadf;
        border-radius: 7px;
        background: #faf9f7;
        padding: 13px 9px;
        font-size: 1rem;
        margin-top: 3px;
        color: #565454;
        outline: none;
        transition: border 0.15s;
    }

        .profile-form input[type="text"]:focus {
            border: 1.5px solid #fb6608;
        }

    .profile-form .row-inline {
        display: flex;
        gap: 18px;
    }

        .profile-form .row-inline label {
            flex: 1;
            margin-bottom: 0;
        }

    .form-actions {
        text-align: right;
        margin-top: 17px;
    }

    .orange-btn {
        background: #fb6608;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 1.01rem;
        font-weight: 600;
        padding: 10px 24px;
        cursor: pointer;
        outline: none;
        transition: background 0.16s;
        box-shadow: 0 2px 7px #fda85a14;
    }

        .orange-btn:hover {
            background: #e65601;
        }

    .add-new {
        padding: 10px 18px;
        font-size: 0.99rem;
        display: flex;
        align-items: center;
        gap: 5px;
        font-weight: 500;
        margin-right: -6px;
    }

    .saved-addresses-list {
        margin-top: 7px;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .address-block {
        background: #fff;
        border-radius: 13px;
        border: 1px solid #f9e6db;
        padding: 19px 22px 19px 22px;
        margin-bottom: 6px;
        position: relative;
        box-shadow: none;
        /* min-height: 82px; */
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .address-badge {
        display: block;
        background: #ff6600;
        color: #fff;
        font-size: 0.85rem;
        border-radius: 5px;
        padding: 2px 10px 2px 10px;
        font-weight: 600;
        margin-bottom: 4px;
        margin-right: 0;
        width: fit-content;
    }

    .address-name {
        display: block;
        font-weight: 600;
        color: #222;
        font-size: 1rem;
        margin-bottom: 7px;
        margin-top: 0;
    }

    .address-detail {
        font-size: 0.95rem;
        color: #aaa;
        margin-top: 4px;
        line-height: 1.47;
    }

    .address-actions {
        display: flex;
        gap: 9px;
        position: absolute;
        top: 20px;
        right: 18px;
    }

    .icon-btn {
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    /* Account Security section styles */
    .account-card {
        background: #fff8ef;
        border-color: #ffecd8;
        margin-bottom: 12px;
    }

    .security-valuebox-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        background: #fff;
        border-radius: 9px;
        padding: 13px 18px 12px 18px;
        width: 100%;
        margin-top: 13px;
        margin-bottom: 8px;
        box-shadow: none;
        gap: 26px;
    }

    .security-row-texts {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .security-label {
        font-weight: 600;
        color: #494949;
        font-size: 1.03rem;
        margin-bottom: 0px;
    }

    .security-hint {
        font-size: 0.93rem;
        color: #aaa;
        font-weight: 400;
        margin: 0;
        margin-top: 2px;
    }

    .security-btn {
        background: #fb6608;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 1.01rem;
        font-weight: 600;
        padding: 8px 24px;
        margin: 0 0 0 14px;
        white-space: nowrap;
        cursor: pointer;
        transition: background 0.17s;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .security-btn:hover {
            background: #e65601;
        }


    @@media (max-width: 900px) {
        .profile-layout

    {
        flex-direction: column;
    }

    .profile-main-content {
        padding: 17px 0 18px 0;
    }

    }
    @@media (max-width: 540px) {
        .profile-layout

    {
        flex-direction: column;
        gap: 0;
        padding: 0;
        min-width: 0;
    }

    .profile-main-content {
        padding: 0;
        width: 100%;
        min-width: 0;
    }

        .profile-title {
            margin-top: 24px;
        }
    .profile-title, .profile-subtitle {
        padding-left: 16px;
        padding-right: 16px;
    }

    .profile-card,
    .profile-card.address-card,
    .profile-card.account-card {
        margin-bottom: 24px;
        margin-left: 12px;
        margin-right: 12px;
        border-radius: 20px;
        box-shadow: none;
        padding: 18px 11px 21px 11px;
        width: auto;
        border-width: 2.5px;
    }

    .profile-card-title,
    .profile-card-title-row {
        font-size: 1.08rem;
        font-weight: 700;
        padding-left: 2px;
    }

    .profile-card-title-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }

    .address-card,
    .account-card {
        background: #fff8ef;
        border-color: #d99b62;
    }

    .profile-form .form-row,
    .profile-form .row-inline {
        display: flex;
        flex-direction: column;
        gap: 13px;
    }

    .profile-form label {
        font-size: 1.01rem;
    }

    .profile-form input[type="text"] {
        padding: 11px 7px;
        font-size: 0.99rem;
    }

    .form-actions {
        display: flex;
        justify-content: center;
        margin: 19px 0 0 0;
    }

    .orange-btn, .add-new, .security-btn {
        width: 100%;
        display: block;
        font-size: 1.01rem;
        border-radius: 8px;
        margin: 10px 0 0 0;
        padding: 12px 0;
        box-sizing: border-box;
        min-width: 0;
    }

    .add-new {
        margin: 0 0 10px 0;
        padding: 12px 0;
    }

    .saved-addresses-list {
        gap: 13px;
    }

    .address-block {
        padding: 17px 12px 17px 12px;
        border-radius: 13px;
        min-width: 0;
        min-height: 68px;
    }

    .address-actions {
        top: 16px;
        right: 12px;
    }

    .security-valuebox-row {
        flex-direction: column;
        align-items: stretch;
        gap: 12px;
        border-radius: 13px;
        padding: 13px 11px 14px 11px;
        margin: 13px 0 9px 0;
    }

    .security-btn {
        margin: 9px 0 0 0;
        width: 100%;
        height: 44px;
    }

    .security-row-texts {
        gap: 1px;
    }

        .user-sidebar {
            display: none !important;
        }
 }
    /* ==========================================
       FIX: Make the Saved Addresses card scrollable
       Inside scroll only (no second scrollbar visible)
    ========================================== */

    .profile-card.address-card {
        max-height: 450px; /* You can adjust height */
        overflow: hidden; /* prevent the card itself from scrolling */
        position: relative;
    }

    .saved-addresses-list {
        max-height: 380px; /* height inside the card */
        overflow-y: auto; /* enable internal scroll */
        padding-right: 6px; /* avoid text cutting */
        /* Hide scrollbar (but allow scroll) */
        scrollbar-width: none; /* Firefox */
    }

        .saved-addresses-list::-webkit-scrollbar {
            display: none; /* Chrome/Safari */
        }

</style>



